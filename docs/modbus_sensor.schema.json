{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Serial Monitor sensor simulator v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "name", "unitId", "points"],
  "properties": {
    "schemaVersion": {"const": 1}, "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "source": {"type": "string", "maxLength": 1024}, "unitId": {"type": "integer", "minimum": 1, "maximum": 247},
    "responseDelayMs": {"type": "integer", "minimum": 0, "maximum": 1000},
    "points": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "area", "address", "initialValue"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128}, "area": {"enum": [1,2,3,4]},
        "address": {"type": "integer", "minimum": 0, "maximum": 65535},
        "valueType": {"enum": ["UInt16","Int16","UInt32","Int32","Float32"]},
        "scale": {"type": "number", "not": {"const": 0}}, "unit": {"type": "string", "maxLength": 32},
        "swapBytes": {"type": "boolean"}, "swapWords": {"type": "boolean"}, "writable": {"type": "boolean"},
        "initialValue": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }}
  }
}
