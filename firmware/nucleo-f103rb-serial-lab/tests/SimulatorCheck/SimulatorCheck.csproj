<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win10-x64</RuntimeIdentifier><UseRidGraph>true</UseRidGraph><PlatformTarget>x64</PlatformTarget>
    <WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled><AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
    <SerialMonitorAppDirectory Condition="'$(SerialMonitorAppDirectory)' == ''">$(MSBuildThisFileDirectory)../../../../SerialMonitor.WinUI/bin/x64/Release/net8.0-windows10.0.19041.0/win10-x64</SerialMonitorAppDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260508005" />
    <PackageReference Include="RJCP.SerialPortStream" Version="3.0.5" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <Reference Include="SerialMonitor.WinUI"><HintPath>$(SerialMonitorAppDirectory)/SerialMonitor.WinUI.dll</HintPath></Reference>
    <Reference Include="SerialMonitor.Core"><HintPath>$(SerialMonitorAppDirectory)/SerialMonitor.Core.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireBuiltApplication" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SerialMonitorAppDirectory)/SerialMonitor.WinUI.dll') Or !Exists('$(SerialMonitorAppDirectory)/SerialMonitor.Core.dll')" Text="Build the app first or supply SerialMonitorAppDirectory. This checker never rebuilds application sources." />
  </Target>
</Project>
