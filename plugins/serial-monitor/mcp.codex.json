{
  "mcpServers": {
    "serial-monitor": {
      "type": "stdio",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${PLUGIN_ROOT}/scripts/Start-SerialMonitorMcp.ps1"
      ],
      "tool_timeout_sec": 90
    }
  }
}
