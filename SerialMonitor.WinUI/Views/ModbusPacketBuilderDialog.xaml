<ContentDialog
    x:Class="SerialMonitor.WinUI.Views.ModbusPacketBuilderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:SerialMonitor.WinUI.Infrastructure"
    Style="{StaticResource DefaultContentDialogStyle}" FontSize="12"
    Title="{Binding Title}" PrimaryButtonText="{Binding CopyLabel}" CloseButtonText="{Binding CloseLabel}"
    DefaultButton="Primary" IsPrimaryButtonEnabled="{Binding CanUsePacket}"
    PrimaryButtonClick="Copy_Click">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">440</x:Double>
        <x:Double x:Key="ContentDialogButtonSpacing">8</x:Double>
        <x:Double x:Key="ContentDialogButtonHeight">24</x:Double>
        <x:Double x:Key="ContentDialogButtonMinHeight">24</x:Double>
        <Thickness x:Key="ContentDialogPadding">12</Thickness>
        <Thickness x:Key="ContentDialogTitleMargin">0,0,0,6</Thickness>
        <x:Double x:Key="ComboBoxMinHeight">24</x:Double>
        <Thickness x:Key="ComboBoxTopHeaderMargin">0,0,0,4</Thickness>
        <Thickness x:Key="TextBoxTopHeaderMargin">0,0,0,4</Thickness>
        <DataTemplate x:Key="CompactFieldHeader">
            <TextBlock Text="{Binding}" Style="{StaticResource ModbusFieldLabelStyle}" FontFamily="{ThemeResource ContentControlThemeFontFamily}" />
        </DataTemplate>
        <Style x:Key="CompactInput" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="infra:TextBoxContentAlignment.IsEnabled" Value="True" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PacketListInput" TargetType="TextBox" BasedOn="{StaticResource CompactInput}">
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MaxHeight" Value="80" />
            <!-- Reserve room for the TextBox's own overlay scrollbar as well. -->
            <Setter Property="Padding" Value="6,2,24,2" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="PacketNumberInput" TargetType="TextBox" BasedOn="{StaticResource CompactInput}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource PacketNumberInput}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModbusComboBoxStyle}" />
        <Style x:Key="FieldHelp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </ContentDialog.Resources>
    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
        </DataTemplate>
    </ContentDialog.TitleTemplate>
    <ContentDialog.PrimaryButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </ContentDialog.PrimaryButtonStyle>
    <ContentDialog.CloseButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </ContentDialog.CloseButtonStyle>

    <Grid RowDefinitions="*,Auto" RowSpacing="6" MinWidth="340" MaxHeight="480">
        <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" MinHeight="0" MaxHeight="360">
            <!-- WinUI scrollbars overlay content. Keep a gutter inside the viewport, independent of scrollbar state. -->
            <StackPanel x:Name="EditorPanel" Margin="0,0,20,0" Spacing="4" MinWidth="0">
                <Grid x:Name="IdentityRow" ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding UnitLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBlock Text="{Binding FunctionLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBox Text="{Binding UnitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding UnitLabel}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding FunctionOptions}"
                              Style="{StaticResource ModbusFunctionComboBoxStyle}"
                              SelectedIndex="{Binding FunctionIndex, Mode=TwoWay}" MaxDropDownHeight="360"
                              ToolTipService.ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding FunctionLabel}" />
                </Grid>
                <TextBlock Text="{Binding FunctionHelp}" Visibility="{Binding FunctionHelp, Converter={StaticResource NonEmptyTextVisibility}}" Style="{StaticResource FieldHelp}" />

                <Grid x:Name="ReadRow" Visibility="{Binding ReadRangeVisibility}" ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding AddressLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBlock Text="{Binding QuantityLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBox Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTipService.ToolTip="0–65535 / 0x0000–0xFFFF" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding AddressLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTipService.ToolTip="{Binding QuantityHelp}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding QuantityLabel}" />
                </Grid>
                <TextBlock Text="{Binding QuantityHelp}" Visibility="{Binding ReadRangeVisibility}" Style="{StaticResource FieldHelp}" />

                <Grid x:Name="SingleCoilRow" Visibility="{Binding CoilVisibility}" ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding AddressLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBlock Text="{Binding CoilLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBox Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTipService.ToolTip="0–65535 / 0x0000–0xFFFF" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding AddressLabel}" />
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding CoilOn, Mode=TwoWay}" FontSize="12"
                                  OffContent="OFF · 0x0000" OnContent="ON · 0xFF00" VerticalContentAlignment="Center" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding CoilLabel}">
                        <ToggleSwitch.Resources>
                            <Thickness x:Key="ToggleSwitchTopHeaderMargin">0,0,0,2</Thickness>
                            <x:Double x:Key="ToggleSwitchPreContentMargin">2</x:Double>
                            <x:Double x:Key="ToggleSwitchPostContentMargin">2</x:Double>
                        </ToggleSwitch.Resources>
                    </ToggleSwitch>
                </Grid>
                <Grid x:Name="SingleRegisterRow" Visibility="{Binding SingleRegisterVisibility}" ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding AddressLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBlock Text="{Binding ScalarValueLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBox Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTipService.ToolTip="0–65535 / 0x0000–0xFFFF" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding AddressLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding ValuesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTipService.ToolTip="{Binding ValuesHelp}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding ScalarValueLabel}" />
                </Grid>

                <Grid x:Name="WriteRow" Visibility="{Binding WriteRangeVisibility}" ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding WriteAddressLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBlock Text="{Binding WriteQuantityLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBox Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTipService.ToolTip="0–65535 / 0x0000–0xFFFF" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding WriteAddressLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding WriteQuantityText}" IsReadOnly="True" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding WriteQuantityLabel}" />
                </Grid>
                <Grid x:Name="ReadWriteRow" Visibility="{Binding ReadWriteVisibility}" ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding WriteAddressLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBlock Text="{Binding WriteQuantityLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBox Text="{Binding WriteAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTipService.ToolTip="0–65535 / 0x0000–0xFFFF" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding WriteAddressLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding WriteQuantityText}" IsReadOnly="True" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding WriteQuantityLabel}" />
                </Grid>
                <StackPanel Visibility="{Binding ValuesVisibility}" Spacing="4">
                    <TextBox HeaderTemplate="{StaticResource CompactFieldHeader}" Header="{Binding ValuesLabel}" Text="{Binding ValuesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PacketListInput}" />
                    <TextBlock Text="{Binding ValuesHelp}" Style="{StaticResource FieldHelp}" />
                </StackPanel>

                <StackPanel Visibility="{Binding DiagnosticsVisibility}" Spacing="4">
                    <Grid x:Name="DiagnosticRow" ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                        <TextBlock Text="{Binding ScalarValueLabel}" Visibility="{Binding DiagnosticSingleDataVisibility}" Style="{StaticResource ModbusFieldLabelStyle}" />
                        <TextBlock Grid.Column="{Binding DiagnosticSelectorColumn}" Text="{Binding DiagnosticLabel}" Grid.ColumnSpan="{Binding DiagnosticSelectorColumnSpan}" Style="{StaticResource ModbusFieldLabelStyle}" />
                        <TextBox Text="{Binding DiagnosticDataText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding DiagnosticSingleDataVisibility}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding ScalarValueLabel}" />
                        <ComboBox Grid.Column="{Binding DiagnosticSelectorColumn}" ItemsSource="{Binding DiagnosticOptions}" MaxDropDownHeight="280"
                                  SelectedIndex="{Binding DiagnosticIndex, Mode=TwoWay}" Grid.ColumnSpan="{Binding DiagnosticSelectorColumnSpan}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding DiagnosticLabel}" ToolTipService.ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" />
                    </Grid>
                    <TextBox HeaderTemplate="{StaticResource CompactFieldHeader}" Header="{Binding DiagnosticDataLabel}" Text="{Binding DiagnosticDataText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding DiagnosticMultipleDataVisibility}" Style="{StaticResource PacketListInput}" />
                    <TextBlock Text="{Binding DiagnosticDataHelp}" Style="{StaticResource FieldHelp}" />
                </StackPanel>
                <Grid x:Name="MaskRow" Visibility="{Binding MaskVisibility}" ColumnDefinitions="128,*,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding AddressLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBlock Text="AND mask" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBlock Text="OR mask" Grid.Column="2" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBox Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTipService.ToolTip="0–65535 / 0x0000–0xFFFF" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding AddressLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding AndMaskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTipService.ToolTip="0–65535 / 0x0000–0xFFFF" Style="{StaticResource CompactInput}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="AND mask" />
                    <TextBox Grid.Column="2" Text="{Binding OrMaskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTipService.ToolTip="0–65535 / 0x0000–0xFFFF" Style="{StaticResource CompactInput}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="OR mask" />
                </Grid>
                <StackPanel Visibility="{Binding FileReadVisibility}" Spacing="4">
                    <TextBox HeaderTemplate="{StaticResource CompactFieldHeader}" Header="{Binding FileRecordsLabel}" Text="{Binding FileReadText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PacketListInput}" />
                    <TextBlock Text="{Binding FileReadHelp}" Style="{StaticResource FieldHelp}" />
                </StackPanel>
                <StackPanel Visibility="{Binding FileWriteVisibility}" Spacing="4">
                    <TextBox HeaderTemplate="{StaticResource CompactFieldHeader}" Header="{Binding FileRecordsLabel}" Text="{Binding FileWriteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PacketListInput}" />
                    <TextBlock Text="{Binding FileWriteHelp}" Style="{StaticResource FieldHelp}" />
                </StackPanel>
                <TextBox HeaderTemplate="{StaticResource CompactFieldHeader}" Header="{Binding AddressLabel}" Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding FifoVisibility}" Width="128" HorizontalAlignment="Left"
                         ToolTipService.ToolTip="0–65535 / 0x0000–0xFFFF" />
                <Grid x:Name="DeviceIdRow" Visibility="{Binding DeviceIdVisibility}" ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding ObjectIdLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding DeviceAccessLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBox Text="{Binding ObjectIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding ObjectIdLabel}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DeviceAccessOptions}"
                              SelectedIndex="{Binding DeviceAccessIndex, Mode=TwoWay}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding DeviceAccessLabel}" ToolTipService.ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" />
                </Grid>
                <Grid x:Name="CustomRow" Visibility="{Binding CustomVisibility}" ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding CompactFunctionLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBlock Text="{Binding CustomDataLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBox Text="{Binding CustomFunctionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTipService.ToolTip="{Binding CustomFunctionLabel}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding CompactFunctionLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding CustomDataText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PacketListInput}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding CustomDataLabel}" />
                </Grid>
                <TextBlock Text="{Binding CompactNumberHelp}" Style="{StaticResource FieldHelp}" ToolTipService.ToolTip="{Binding NumberHelp}" />
                <TextBlock Text="{Binding UnitHelp}" Style="{StaticResource FieldHelp}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="PacketFooter" Grid.Row="1" Spacing="4" Margin="0,0,20,0">
            <TextBlock Text="{Binding ValidationError}" Visibility="{Binding ErrorVisibility}" FontSize="11" TextWrapping="Wrap"
                       MaxLines="3" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ValidationError}"
                       Foreground="{ThemeResource ErrorTextBrush}" />
            <TextBox HeaderTemplate="{StaticResource CompactFieldHeader}" Header="{Binding PreviewLabel}" Text="{Binding Preview}" IsReadOnly="True"
                     Style="{StaticResource PacketListInput}" VerticalContentAlignment="Center" MinHeight="24" MaxHeight="72" />
            <TextBlock Text="{Binding Summary}" Visibility="{Binding Summary, Converter={StaticResource NonEmptyTextVisibility}}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
            <TextBlock x:Name="CopyStatus" Visibility="{Binding Text, ElementName=CopyStatus, Converter={StaticResource NonEmptyTextVisibility}}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</ContentDialog>
