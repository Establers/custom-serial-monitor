<ContentDialog
    x:Class="SerialMonitor.WinUI.Views.ModbusPacketBuilderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="{Binding Title}" PrimaryButtonText="{Binding CopyLabel}" CloseButtonText="{Binding CloseLabel}"
    DefaultButton="Primary" IsPrimaryButtonEnabled="{Binding CanUsePacket}"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}" CloseButtonStyle="{StaticResource DefaultButtonStyle}"
    PrimaryButtonClick="Copy_Click">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    </ContentDialog.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="480">
        <StackPanel Spacing="12" MinWidth="360">
            <ComboBox Header="{Binding FunctionLabel}" ItemsSource="{Binding FunctionOptions}"
                      SelectedIndex="{Binding FunctionIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <!-- Validate the full input. MaxLength can turn an out-of-range paste into a different valid number. -->
                <TextBox Header="{Binding UnitLabel}" Text="{Binding UnitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="1" Header="{Binding AddressLabel}" Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <TextBlock Text="{Binding NumberHelp}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
            <StackPanel Visibility="{Binding QuantityVisibility}" Spacing="4">
                <TextBox Header="{Binding QuantityLabel}" Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding QuantityHelp}" FontSize="12" Opacity="0.75" />
            </StackPanel>
            <ToggleSwitch Header="{Binding CoilLabel}" IsOn="{Binding CoilOn, Mode=TwoWay}"
                          OffContent="OFF · 0x0000" OnContent="ON · 0xFF00" Visibility="{Binding CoilVisibility}" />
            <StackPanel Visibility="{Binding ValuesVisibility}" Spacing="4">
                <TextBox Header="{Binding ValuesLabel}" Text="{Binding ValuesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="{Binding ValuesHelp}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
            </StackPanel>
            <TextBlock Text="{Binding UnitHelp}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
            <TextBlock Text="{Binding ValidationError}" Visibility="{Binding ErrorVisibility}" TextWrapping="Wrap"
                       Foreground="{ThemeResource ErrorTextBrush}" FontSize="12" />
            <TextBox Header="{Binding PreviewLabel}" Text="{Binding Preview}" IsReadOnly="True" FontFamily="Consolas"
                     TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="120" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <TextBlock Text="{Binding Summary}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
            <TextBlock x:Name="CopyStatus" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
