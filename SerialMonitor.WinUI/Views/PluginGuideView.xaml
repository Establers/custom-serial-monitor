<UserControl
    x:Class="SerialMonitor.WinUI.Views.PluginGuideView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="Guide_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="GuideBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="GuideCard" TargetType="Border">
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <DataTemplate x:Key="SnippetTemplate">
            <Border Margin="0,6,0,0" Padding="6" CornerRadius="4"
                    Background="{ThemeResource LayerFillColorAltBrush}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="1" Content="복사" Tag="{Binding Text}" Click="CopySnippet_Click"
                                FontSize="11" Padding="8,2" MinHeight="24"
                                AutomationProperties.Name="{Binding Title}"
                                ToolTipService.ToolTip="이 내용 복사" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Text}" FontFamily="Consolas"
                               FontSize="11" LineHeight="16" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="GuideRowTemplate">
            <Border Padding="0,5" BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource GuideBody}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SectionTemplate">
            <Border Style="{StaticResource GuideCard}" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,3"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{Binding Body}" Style="{StaticResource GuideBody}" />
                    <ItemsControl ItemsSource="{Binding Snippets}" ItemTemplate="{StaticResource SnippetTemplate}" />
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource GuideRowTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="GuideRoot" Padding="6">
        <Grid RowDefinitions="Auto,*" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="WideNavigation" Grid.RowSpan="2" Spacing="6">
                <TextBlock Text="Plugin 연결 가이드" FontSize="11" FontWeight="SemiBold" Margin="8,3,0,2"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ListView ItemsSource="{Binding Pages}" SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}"
                          SelectionChanged="Page_SelectionChanged" SelectionMode="Single" IsItemClickEnabled="False"
                          FontSize="11" HorizontalContentAlignment="Stretch"
                          AutomationProperties.Name="Plugin 가이드 목차">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="28" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <TextBlock Text="GUI를 켜 둔 상태에서&#xA;AI 도구를 연결하세요."
                           FontSize="11" LineHeight="16" TextWrapping="Wrap" Margin="8,2,4,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ComboBox x:Name="CompactNavigation" Grid.Column="1" Visibility="Collapsed" Margin="0,0,0,6"
                      ItemsSource="{Binding Pages}" SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}"
                      SelectionChanged="Page_SelectionChanged" HorizontalAlignment="Stretch" FontSize="11" MinHeight="26"
                      AutomationProperties.Name="Plugin 가이드 목차" />

            <ScrollViewer x:Name="ArticleScroll" Grid.Row="1" Grid.Column="1"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding PageTitle}" FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,2"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{Binding PageDescription}" Style="{StaticResource GuideBody}" Margin="0,0,0,6"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Border Style="{StaticResource GuideCard}" Margin="0,0,0,6" Visibility="{Binding PluginIntroVisibility}">
                        <HyperlinkButton x:Uid="AgentPluginRepositoryLink" Content="GitHub · Establers/custom-serial-monitor ↗"
                                         NavigateUri="https://github.com/Establers/custom-serial-monitor"
                                         FontSize="11" Padding="0,2" HorizontalAlignment="Left" />
                    </Border>

                    <Border Style="{StaticResource GuideCard}" Margin="0,0,0,6" Visibility="{Binding SetupVisibility}">
                        <StackPanel Spacing="4">
                            <Grid RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ClientColumn" Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="ClientField" Spacing="3">
                                    <TextBlock Text="사용할 AI 도구" FontSize="11" FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding Clients}" SelectedIndex="{Binding SelectedClientIndex, Mode=TwoWay}"
                                              SelectionChanged="Client_SelectionChanged" HorizontalAlignment="Stretch"
                                              FontSize="11" MinHeight="26" Height="26" Padding="8,2"
                                              AutomationProperties.Name="플러그인 클라이언트 선택" />
                                </StackPanel>
                                <StackPanel x:Name="ToolPathField" Grid.Column="1" Spacing="3" Visibility="{Binding ToolPathVisibility}">
                                    <TextBlock Text="serialctl.exe 경로" FontSize="11" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <TextBox Text="{Binding ToolPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" FontFamily="Consolas" MinHeight="26" Height="26" Padding="6,3"
                                                 PlaceholderText="C:\SerialMonitor\tools\serialctl.exe"
                                                 AutomationProperties.Name="serialctl.exe 절대 경로" />
                                        <Button Grid.Column="1" Content="다시 찾기" Click="FindTool_Click"
                                                FontSize="11" MinHeight="26" Padding="8,2" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding PathStatus}" Style="{StaticResource GuideBody}" Visibility="{Binding ToolPathVisibility}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}" />

                    <StackPanel Visibility="{Binding SetupVisibility}" Spacing="2" Margin="0,0,0,6">
                        <HyperlinkButton Content="선택한 클라이언트의 공식 연결 문서 ↗" NavigateUri="{Binding SourceUri}"
                                         FontSize="11" Padding="0,2" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border x:Name="CopyFeedback" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Visibility="Collapsed" CornerRadius="4" Padding="8,6" Margin="6"
                Background="{ThemeResource LayerFillColorDefaultBrush}" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" IsHitTestVisible="False">
            <TextBlock Text="{Binding ActionStatus}" FontSize="11" TextWrapping="Wrap" MaxWidth="340"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</UserControl>
