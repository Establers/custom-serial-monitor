<UserControl x:Class="SerialMonitor.WinUI.Views.ModbusSensorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="View_Loaded" SizeChanged="View_SizeChanged">
 <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6" Padding="6" MinWidth="0" MinHeight="0">
  <Grid x:Name="ProductToolbar" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="5" RowSpacing="6">
   <Grid x:Name="ProductFields" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
   <TextBlock Text="제품" FontSize="12" VerticalAlignment="Center" />
   <ComboBox x:Name="ProductSelector" Grid.Column="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" DisplayMemberPath="Label"
    HorizontalAlignment="Stretch" PlaceholderText="제품 선택" IsEnabled="{Binding CanManage}" Style="{StaticResource ModbusProductComboBoxStyle}" ToolTipService.ToolTip="{Binding SelectedProduct.Label}" AutomationProperties.Name="시뮬레이션할 제품" />
   <Button x:Name="ManagementButton" Grid.Column="2" Content="제품 관리" Style="{StaticResource ModbusActionButtonStyle}">
    <Button.Flyout><MenuFlyout x:Name="ManagementFlyout" Opening="Management_Opening">
     <MenuFlyoutItem Text="새 제품…" Click="New_Click" IsEnabled="{Binding CanManage}" />
     <MenuFlyoutItem Text="JSON 불러오기…" Click="Import_Click" IsEnabled="{Binding CanManage}" />
     <MenuFlyoutItem Text="JSON 내보내기…" Click="Export_Click" IsEnabled="{Binding CanManageSelected}" />
     <MenuFlyoutSeparator />
     <MenuFlyoutItem Text="제품 편집…" Click="Edit_Click" IsEnabled="{Binding CanManageSelected}" />
     <MenuFlyoutItem Text="제품 복제" Click="Duplicate_Click" IsEnabled="{Binding CanManageSelected}" />
     <MenuFlyoutItem Text="제품 삭제…" Click="Delete_Click" IsEnabled="{Binding CanDeleteSelected}" />
     <MenuFlyoutSeparator />
     <MenuFlyoutItem Text="목록 새로 고침" Click="Reload_Click" IsEnabled="{Binding CanManage}" />
     <MenuFlyoutItem Text="AI로 제품 정의 만들기…" Click="ShowAiGuide_Click" />
    </MenuFlyout></Button.Flyout>
   </Button>
   </Grid>
   <StackPanel x:Name="RunActions" Grid.Column="1" Orientation="Horizontal" Spacing="5">
   <Border ToolTipService.ToolTip="{Binding AvailabilityHint}"><Button Content="응답 시작" Command="{Binding StartCommand}" Style="{StaticResource ModbusAccentButtonStyle}" /></Border>
   <Button Content="중지" Command="{Binding StopCommand}" Style="{StaticResource ModbusActionButtonStyle}" />
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="6">
   <TextBlock x:Name="ProductSummaryText" Text="{Binding ProductSummary}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ProductSummary}" FontSize="12" />
   <Grid x:Name="ValueToolbar" Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="5">
   <StackPanel x:Name="ValueActions" Orientation="Horizontal" Spacing="5">
   <Button x:Name="ChangeValueButton" Content="값 변경…" Click="ChangeValue_Click" IsEnabled="{Binding CanChangeSelectedValue}" Style="{StaticResource ModbusActionButtonStyle}" ToolTipService.ToolTip="응답 시작 후 표에서 항목을 선택하세요. 읽기 전용 항목도 가상 값을 바꿀 수 있어요." />
   <Button x:Name="RestoreValuesButton" Content="초기값 복원" IsEnabled="{Binding CanChangeValues}" Style="{StaticResource ModbusActionButtonStyle}">
    <Button.Flyout><MenuFlyout Opening="Management_Opening">
     <MenuFlyoutItem Text="선택 항목 복원" Click="RestoreSelected_Click" IsEnabled="{Binding CanChangeSelectedValue}" />
     <MenuFlyoutItem Text="모든 항목 복원…" Click="RestoreAll_Click" IsEnabled="{Binding CanChangeValues}" />
    </MenuFlyout></Button.Flyout>
   </Button>
   </StackPanel>
   <StackPanel x:Name="HelpActions" Grid.Column="1" Orientation="Horizontal" Spacing="5">
   <Button x:Name="SourceButton" Content="설명·출처" Style="{StaticResource ModbusActionButtonStyle}" IsEnabled="{Binding HasSelectedProduct}">
    <Button.Flyout><Flyout x:Name="SourceFlyout"><ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding ProductSource}" MaxWidth="420" Margin="0,0,16,0" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" /></ScrollViewer></Flyout></Button.Flyout>
   </Button>
   <Button Content="지원 기능" Click="Support_Click" Style="{StaticResource ModbusActionButtonStyle}" />
   </StackPanel>
   </Grid>
  </Grid>
  <ScrollViewer x:Name="PointScroll" Grid.Row="2" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <Grid x:Name="PointTable" MinWidth="520" RowDefinitions="Auto,*" MinHeight="0">
  <Grid x:Name="PointHeader" ColumnDefinitions="*,110,125,95" Padding="8,3,24,3" Background="{ThemeResource ControlFillColorSecondaryBrush}">
   <TextBlock Text="항목" FontSize="12" /><TextBlock Grid.Column="2" Text="주소 (0부터)" FontSize="12" />
   <TextBlock Grid.Column="1" Text="{Binding ValueColumnHeader}" FontSize="12" /><TextBlock Grid.Column="3" Text="마지막 변경" FontSize="12" />
  </Grid>
  <ListView x:Name="PointList" Grid.Row="1" ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint, Mode=TwoWay}" SelectionMode="Single" IsItemClickEnabled="False" DoubleTapped="Point_DoubleTapped" MinHeight="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="시뮬레이터 항목과 현재 값">
   <ListView.ItemContainerStyle><StaticResource ResourceKey="ModbusPreviewListItemStyle" /></ListView.ItemContainerStyle>
   <ListView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,110,125,95">
    <TextBlock Text="{Binding Name}" ToolTipService.ToolTip="{Binding Details}" TextTrimming="CharacterEllipsis" FontSize="12" />
    <TextBlock Grid.Column="2" Text="{Binding Address}" FontSize="12" />
    <Grid Grid.Column="1" ToolTipService.ToolTip="{Binding ValueDetails}">
     <Border Background="{ThemeResource SystemControlHighlightAccentBrush}" Opacity="{Binding HighlightOpacity}" />
     <TextBlock Text="{Binding CurrentValue}" TextTrimming="CharacterEllipsis" FontSize="12" />
    </Grid>
    <TextBlock Grid.Column="3" Text="{Binding ChangeSource}" ToolTipService.ToolTip="{Binding ValueDetails}" TextTrimming="CharacterEllipsis" FontSize="12" />
   </Grid></DataTemplate></ListView.ItemTemplate>
  </ListView>
  </Grid>
  </ScrollViewer>
 </Grid>
</UserControl>
