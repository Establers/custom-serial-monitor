<UserControl
    x:Class="SerialMonitor.WinUI.Views.ModbusRtuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:SerialMonitor.WinUI.Infrastructure"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
    Loaded="View_Loaded">
    <UserControl.Resources>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource CompactActionButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style x:Key="Input" TargetType="TextBox" BasedOn="{StaticResource CompactTextBoxStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="infra:TextBoxContentAlignment.IsEnabled" Value="True" />
        </Style>
        <!-- The shared compact template is single-line. Keep native scrolling
             for consecutive raw values instead of clipping a multiline editor. -->
        <Style x:Key="ValuesInput" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="MaxHeight" Value="104" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource CompactComboBoxStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource CompactCheckBoxStyle}" />
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="GuideBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
        <Style x:Key="GuideHeading" TargetType="TextBlock" BasedOn="{StaticResource GuideBody}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="5" MinHeight="0" MinWidth="0">
        <Border Background="{ThemeResource InspectorHeaderBrush}" CornerRadius="4" Padding="6,4">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="5">
                    <TextBlock Text="{Binding Statistics}" Style="{StaticResource Cell}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{Binding Statistics}" />
                    <Button Grid.Column="1" Content="{Binding SettingsLabel}" Style="{StaticResource Action}" IsEnabled="{Binding IsSettingsEnabled}">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight" Opening="SettingsFlyout_Opening"
                                    FlyoutPresenterStyle="{StaticResource CompactFlyoutPresenterStyle}">
                                <ScrollViewer x:Name="SettingsScroll" MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ContentControl x:Name="SettingsEditorRoot" IsEnabled="{Binding IsSettingsEnabled}" HorizontalContentAlignment="Stretch">
                                    <StackPanel x:Name="SettingsPanel" Width="360" Spacing="8" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding SettingsLabel}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RequestSummary}" FontSize="11" FontFamily="Consolas"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5">
                                            <TextBlock Text="{Binding UnitLabel}" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Grid.Column="1" Text="{Binding FunctionLabel}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="1" Text="{Binding UnitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" AutomationProperties.Name="{Binding UnitLabel}" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Functions}" SelectedIndex="{Binding FunctionIndex, Mode=TwoWay}" Style="{StaticResource CompactComboBoxStyle}" FontSize="12" MinWidth="0" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding FunctionLabel}">
                                                <ComboBox.Resources>
                                                    <x:Double x:Key="ComboBoxMinHeight">24</x:Double>
                                                </ComboBox.Resources>
                                            </ComboBox>
                                            <TextBlock Grid.Row="2" Text="{Binding AddressLabel}" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding QuantityLabel}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="3" Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" AutomationProperties.Name="{Binding AddressLabel}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" AutomationProperties.Name="{Binding QuantityLabel}" />
                                            <TextBlock Grid.Row="4" Text="{Binding IntervalLabel}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" MaxLines="2" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TimeoutLabel}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" MaxLines="2" />
                                            <TextBox Grid.Row="5" Text="{Binding IntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" AutomationProperties.Name="{Binding IntervalLabel}" />
                                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding TimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" AutomationProperties.Name="{Binding TimeoutLabel}" />
                                            <TextBlock Grid.Row="6" Text="{Binding FormatLabel}" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ScaleLabel}" Style="{StaticResource FieldLabel}" />
                                            <ComboBox Grid.Row="7" ItemsSource="{Binding Formats}" SelectedIndex="{Binding FormatIndex, Mode=TwoWay}" Style="{StaticResource CompactComboBoxStyle}" FontSize="12" MinWidth="0" HorizontalAlignment="Stretch" IsEnabled="{Binding IsRegisterFunction}" AutomationProperties.Name="{Binding FormatLabel}">
                                                <ComboBox.Resources>
                                                    <!-- The native arrow otherwise keeps the closed field 32 pixels tall. -->
                                                    <x:Double x:Key="ComboBoxMinHeight">24</x:Double>
                                                </ComboBox.Resources>
                                            </ComboBox>
                                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ScaleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" IsEnabled="{Binding IsRegisterFunction}" AutomationProperties.Name="{Binding ScaleLabel}" />
                                        </Grid>
                                        <Border Height="1" Background="{ThemeResource AppSurfaceBorderBrush}" Margin="0,2" />
                                        <CheckBox Content="{Binding SwapBytesLabel}" IsChecked="{Binding SwapBytes, Mode=TwoWay}" IsEnabled="{Binding IsRegisterFunction}" />
                                        <CheckBox Content="{Binding SwapWordsLabel}" IsChecked="{Binding SwapWords, Mode=TwoWay}" IsEnabled="{Binding IsWordSwapEnabled}" />
                                        <TextBlock Text="{Binding SetupHelp}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding OwnershipHelp}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    </ContentControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="ItemsButton" Grid.Column="2" Content="{Binding ItemsEditorLabel}" Click="Items_Click" IsEnabled="{Binding IsSettingsEnabled}" Style="{StaticResource Action}" />
                    <Button Grid.Column="3" Content="{Binding SaveLabel}" Command="{Binding SaveSettingsCommand}" Style="{StaticResource Action}" />
                    <Button Grid.Column="4" Content="{Binding WriteEditorLabel}" IsEnabled="{Binding IsWritableFunction}" Style="{StaticResource Action}" ToolTipService.ToolTip="{Binding WriteAvailabilityHelp}">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight" Opening="WriteFlyout_Opening"
                                    FlyoutPresenterStyle="{StaticResource CompactFlyoutPresenterStyle}">
                                <ScrollViewer x:Name="WriteScroll" MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ContentControl x:Name="WriteEditorRoot" IsEnabled="{Binding IsWriteEditorEnabled}" HorizontalContentAlignment="Stretch">
                                        <StackPanel x:Name="WritePanel" Width="400" Spacing="8" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding WriteEditorLabel}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding WriteHelp}" FontSize="11" TextWrapping="Wrap" />
                                            <ComboBox Header="{Binding WriteModeLabel}" ItemsSource="{Binding WriteModes}" SelectedIndex="{Binding WriteModeIndex, Mode=TwoWay}" FontSize="12" />
                                            <TextBlock Text="{Binding WriteItemSummary}" FontSize="11" TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="125,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                                <TextBlock Text="{Binding WriteAddressLabel}" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Column="1" Text="{Binding WriteValuesLabel}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" MaxLines="2" />
                                                <TextBox Grid.Row="1" Text="{Binding WriteAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}" VerticalAlignment="Top" AutomationProperties.Name="{Binding WriteAddressLabel}" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WriteValuesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValuesInput}" AutomationProperties.Name="{Binding WriteValuesLabel}" />
                                            </Grid>
                                            <TextBlock Text="{Binding WritePreview}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVisibility}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource ErrorTextBrush}" />
                                            <Button Content="{Binding WriteLabel}" Command="{Binding WriteCommand}" Style="{StaticResource Action}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </ContentControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="GuideButton" Grid.Column="5" Content="?" Width="24" Padding="0"
                            Style="{StaticResource Action}" ToolTipService.ToolTip="{Binding GuideLabel}"
                            AutomationProperties.Name="{Binding GuideLabel}">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight" Opening="GuideFlyout_Opening"
                                    FlyoutPresenterStyle="{StaticResource CompactFlyoutPresenterStyle}">
                                <ScrollViewer x:Name="GuideScroll" MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="GuidePanel" Width="420" Spacing="6" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding GuideTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding GuidePurpose}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideModesTitle}" Style="{StaticResource GuideHeading}" />
                                        <TextBlock Text="{Binding GuideModesHelp}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideStartTitle}" Style="{StaticResource GuideHeading}" />
                                        <TextBlock Text="{Binding GuideConnectStep}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideSetupStep}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideReadStep}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideGroupsTitle}" Style="{StaticResource GuideHeading}" />
                                        <TextBlock Text="{Binding GuideGroupsHelp}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideDisplayTitle}" Style="{StaticResource GuideHeading}" />
                                        <TextBlock Text="{Binding GuideDisplayHelp}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideWriteTitle}" Style="{StaticResource GuideHeading}" />
                                        <TextBlock Text="{Binding GuideWriteHelp}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideConnectionTitle}" Style="{StaticResource GuideHeading}" />
                                        <TextBlock Text="{Binding OwnershipHelp}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideSaveHelp}" Style="{StaticResource GuideBody}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <TextBlock Text="{Binding GroupSelectorLabel}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Visibility="{Binding PollingGroupsVisibility}" />
                    <ComboBox x:Name="PollingGroupSelector" Grid.Column="1" ItemsSource="{Binding PollingGroups}"
                              SelectedItem="{Binding SelectedPollingGroup, Mode=TwoWay}" DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding IsGroupSelectionEnabled}" FontSize="12" MinWidth="0" MaxDropDownHeight="280"
                              Visibility="{Binding PollingGroupsVisibility}"
                              AutomationProperties.Name="{Binding GroupSelectorLabel}" />
                    <Button x:Name="GroupsButton" Grid.Column="2" Content="{Binding GroupEditorLabel}" Click="Groups_Click"
                            IsEnabled="{Binding IsSettingsEnabled}" Style="{StaticResource Action}" />
                </Grid>
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Spacing="3">
            <TextBlock Text="{Binding PollingSummary}" FontSize="11" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding PollingGroupsVisibility}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{Binding PollingSummary}" />
            <TextBlock Text="{Binding AvailabilityText}" Visibility="{Binding AvailabilityVisibility}" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding AvailabilityText}" />
            <ScrollViewer MaxHeight="55" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding ErrorVisibility}">
                <TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource ErrorTextBrush}" />
            </ScrollViewer>
        </StackPanel>
        <Border Grid.Row="2" Background="{ThemeResource InspectorBodyBrush}" BorderBrush="{ThemeResource AppSurfaceBorderBrush}" BorderThickness="1" CornerRadius="4" MinHeight="0">
            <Grid MinHeight="0">
                <ScrollViewer x:Name="TableScroll" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <Grid MinWidth="780" RowDefinitions="Auto,*" MinHeight="0">
                        <Border Background="{ThemeResource InspectorHeaderBrush}" Padding="8,5,24,5">
                            <Grid ColumnDefinitions="110,110,125,*,105,100" ColumnSpacing="8">
                                <TextBlock Text="{Binding TableAddressLabel}" Style="{StaticResource Cell}" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding RawLabel}" Style="{StaticResource Cell}" FontSize="11" />
                                <TextBlock Grid.Column="2" Text="{Binding TableNameLabel}" Style="{StaticResource Cell}" FontSize="11" />
                                <TextBlock Grid.Column="3" Text="{Binding ValueLabel}" Style="{StaticResource Cell}" FontSize="11" />
                                <TextBlock Grid.Column="4" Text="{Binding StateLabel}" Style="{StaticResource Cell}" FontSize="11" />
                                <TextBlock Grid.Column="5" Text="{Binding UpdatedLabel}" Style="{StaticResource Cell}" FontSize="11" />
                            </Grid>
                        </Border>
                        <ListView x:Name="RegisterList" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                  HorizontalContentAlignment="Stretch" SelectionMode="Single" MinHeight="0" Padding="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="{Binding TabTitle}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="28" />
                                    <Setter Property="Padding" Value="8,3" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="ContentTransitions"><Setter.Value><TransitionCollection /></Setter.Value></Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="110,110,125,*,105,100" ColumnSpacing="8">
                                        <TextBlock Text="{Binding AddressText}" Style="{StaticResource Cell}" FontFamily="Consolas" />
                                        <TextBlock Grid.Column="1" Text="{Binding RawText}" Style="{StaticResource Cell}" FontFamily="Consolas" ToolTipService.ToolTip="{Binding RawText}" />
                                        <TextBlock Grid.Column="2" Text="{Binding NameText}" Style="{StaticResource Cell}" ToolTipService.ToolTip="{Binding NameText}" />
                                        <Grid Grid.Column="3" ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                            <TextBlock Text="{Binding ChangeText}" Style="{StaticResource Cell}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource Cell}" FontFamily="Consolas" ToolTipService.ToolTip="{Binding ValueText}" />
                                        </Grid>
                                        <TextBlock Grid.Column="4" Text="{Binding StatusText}" Style="{StaticResource Cell}" FontWeight="SemiBold" ToolTipService.ToolTip="{Binding StatusText}" />
                                        <TextBlock Grid.Column="5" Text="{Binding UpdatedText}" Style="{StaticResource Cell}" FontFamily="Consolas" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
                <TextBlock Text="{Binding EmptyHelp}" Visibility="{Binding EmptyVisibility}" MaxWidth="440" Margin="15" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
