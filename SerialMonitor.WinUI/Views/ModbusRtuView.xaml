<UserControl
    x:Class="SerialMonitor.WinUI.Views.ModbusRtuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:SerialMonitor.WinUI.Infrastructure"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
    Loaded="View_Loaded" SizeChanged="View_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource ModbusActionButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style x:Key="Input" TargetType="TextBox" BasedOn="{StaticResource CompactTextBoxStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="infra:TextBoxContentAlignment.IsEnabled" Value="True" />
        </Style>
        <!-- The shared compact template is single-line. Keep native scrolling
             for consecutive raw values instead of clipping a multiline editor. -->
        <Style x:Key="ValuesInput" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="MaxHeight" Value="104" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModbusComboBoxStyle}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource CompactCheckBoxStyle}" />
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource ModbusFieldLabelStyle}" />
        <Style x:Key="NumberInput" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="GuideBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
        <Style x:Key="GuideHeading" TargetType="TextBlock" BasedOn="{StaticResource GuideBody}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*" RowSpacing="5" MinHeight="0" MinWidth="0">
        <Border Background="{ThemeResource InspectorHeaderBrush}" CornerRadius="4" Padding="6,4">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="5" MinWidth="0">
                    <ComboBox x:Name="PollingGroupSelector" Width="220" ItemsSource="{Binding PollingGroups}"
                              SelectedItem="{Binding SelectedPollingGroup, Mode=TwoWay}" DisplayMemberPath="SelectionLabel"
                              IsEnabled="{Binding IsGroupSelectionEnabled}" FontSize="12" MinWidth="0" MaxDropDownHeight="280"
                              Style="{StaticResource ModbusToolbarComboBoxStyle}" Visibility="{Binding PollingGroupsVisibility}"
                              ToolTipService.ToolTip="{Binding SelectedPollingGroup.Summary}"
                              AutomationProperties.Name="{Binding GroupSelectorLabel}">
                        <ComboBox.Resources><x:Double x:Key="ComboBoxMinHeight">24</x:Double></ComboBox.Resources>
                    </ComboBox>
                    <Button Grid.Column="1" Style="{StaticResource Action}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="5,0" MinWidth="0"
                            ToolTipService.ToolTip="{Binding MonitorSummary}" AutomationProperties.Name="{Binding MonitorDetailsLabel}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                            <FontIcon Glyph="&#xE783;" FontSize="12" Foreground="{ThemeResource ErrorTextBrush}" Visibility="{Binding ErrorVisibility}" />
                            <TextBlock Grid.Column="1" Text="{Binding MonitorSummary}" Style="{StaticResource Cell}" FontSize="11" />
                            <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="9" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft" Opening="SummaryFlyout_Opening" FlyoutPresenterStyle="{StaticResource CompactFlyoutPresenterStyle}">
                                <ScrollViewer x:Name="SummaryScroll" MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="SummaryPanel" Width="420" Spacing="6" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding MonitorDetailsLabel}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ErrorHelp}" Visibility="{Binding ErrorVisibility}" Style="{StaticResource GuideBody}" Foreground="{ThemeResource ErrorTextBrush}" />
                                        <TextBlock Text="{Binding AvailabilityText}" Visibility="{Binding AvailabilityVisibility}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding PollingSummary}" Visibility="{Binding PollingSummary, Converter={StaticResource NonEmptyTextVisibility}}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding Statistics}" Visibility="{Binding Statistics, Converter={StaticResource NonEmptyTextVisibility}}" Style="{StaticResource GuideBody}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="SettingsButton" Grid.Column="2" Content="{Binding SettingsLabel}" Style="{StaticResource Action}" IsEnabled="{Binding IsSettingsEnabled}">
                        <Button.Flyout>
                            <Flyout x:Name="SettingsFlyout" Placement="BottomEdgeAlignedRight" Opening="SettingsFlyout_Opening"
                                    FlyoutPresenterStyle="{StaticResource CompactFlyoutPresenterStyle}">
                                <ScrollViewer x:Name="SettingsScroll" MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ContentControl x:Name="SettingsEditorRoot" IsEnabled="{Binding IsSettingsEnabled}" HorizontalContentAlignment="Stretch">
                                    <StackPanel x:Name="SettingsPanel" Width="360" Spacing="6" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding SettingsLabel}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ReadSetupHelp}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding TargetSettingsSummary}" FontSize="11" FontFamily="Consolas"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <CheckBox Content="{Binding IncludeGroupLabel}" IsChecked="{Binding SelectedGroupIncluded, Mode=TwoWay}"
                                                  Visibility="{Binding PollingGroupsVisibility}" IsEnabled="{Binding IsTargetSettingsEnabled}" />
                                        <ContentControl IsEnabled="{Binding IsTargetSettingsEnabled}" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="4">
                                        <Grid x:Name="TargetSettingsForm" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Style="{StaticResource ModbusFormGridStyle}">
                                            <TextBlock Text="{Binding UnitLabel}" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Grid.Column="1" Text="{Binding FunctionLabel}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="1" Text="{Binding UnitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberInput}" AutomationProperties.Name="{Binding UnitLabel}" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Functions}" SelectedIndex="{Binding FunctionIndex, Mode=TwoWay}" Style="{StaticResource ModbusComboBoxStyle}" FontSize="12" AutomationProperties.Name="{Binding FunctionLabel}" ToolTipService.ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}">
                                                <ComboBox.Resources>
                                                    <x:Double x:Key="ComboBoxMinHeight">24</x:Double>
                                                </ComboBox.Resources>
                                            </ComboBox>
                                            <TextBlock Grid.Row="2" Text="{Binding AddressLabel}" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding QuantityLabel}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="3" Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberInput}" AutomationProperties.Name="{Binding AddressLabel}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberInput}" AutomationProperties.Name="{Binding QuantityLabel}" />
                                            <TextBlock Grid.Row="4" Text="{Binding IntervalLabel}" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TimeoutLabel}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="5" Text="{Binding IntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberInput}" AutomationProperties.Name="{Binding IntervalLabel}" />
                                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding TimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberInput}" AutomationProperties.Name="{Binding TimeoutLabel}" />
                                        </Grid>
                                        <TextBlock Text="{Binding AddressHelp}" Style="{StaticResource GuideBody}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding IntervalHelp}" Style="{StaticResource GuideBody}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Expander Header="{Binding DisplaySettingsLabel}" Style="{StaticResource ModbusExpanderStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="128,*" RowDefinitions="Auto,Auto" Style="{StaticResource ModbusFormGridStyle}">
                                            <TextBlock Grid.Row="0" Text="{Binding FormatLabel}" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ScaleLabel}" Style="{StaticResource FieldLabel}" />
                                            <ComboBox Grid.Row="1" ItemsSource="{Binding Formats}" SelectedIndex="{Binding FormatIndex, Mode=TwoWay}" Style="{StaticResource ModbusComboBoxStyle}" FontSize="12" MinWidth="0" HorizontalAlignment="Stretch" IsEnabled="{Binding IsRegisterFunction}" AutomationProperties.Name="{Binding FormatLabel}" ToolTipService.ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}">
                                                <ComboBox.Resources>
                                                    <!-- The native arrow otherwise keeps the closed field 32 pixels tall. -->
                                                    <x:Double x:Key="ComboBoxMinHeight">24</x:Double>
                                                </ComboBox.Resources>
                                            </ComboBox>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ScaleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberInput}" IsEnabled="{Binding IsRegisterFunction}" AutomationProperties.Name="{Binding ScaleLabel}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <CheckBox Content="{Binding SwapBytesLabel}" IsChecked="{Binding SwapBytes, Mode=TwoWay}" IsEnabled="{Binding IsRegisterFunction}" Style="{StaticResource CompactCheckBoxStyle}" />
                                            <CheckBox Grid.Column="1" Content="{Binding SwapWordsLabel}" IsChecked="{Binding SwapWords, Mode=TwoWay}" IsEnabled="{Binding IsWordSwapEnabled}" Style="{StaticResource CompactCheckBoxStyle}" />
                                        </Grid>
                                            </StackPanel>
                                        </Expander>
                                        </StackPanel>
                                        </ContentControl>
                                        <Button Content="{Binding ReadOnceLabel}" Command="{Binding ReadOnceCommand}" Click="ReadFromSettings_Click"
                                                ToolTipService.ToolTip="{Binding ReadOnceHelp}" Style="{StaticResource ModbusAccentButtonStyle}" HorizontalAlignment="Right" />
                                        <Expander Header="{Binding UsageDetailsLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource ModbusExpanderStyle}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding SetupHelp}" Style="{StaticResource GuideBody}" />
                                                <TextBlock Text="{Binding OwnershipHelp}" Style="{StaticResource GuideBody}" />
                                            </StackPanel>
                                        </Expander>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Button x:Name="ItemsButton" Content="{Binding ItemsEditorLabel}" Click="Items_Click" IsEnabled="{Binding IsTargetSettingsEnabled}" Style="{StaticResource Action}" HorizontalAlignment="Stretch" />
                                            <Button x:Name="GroupsButton" Grid.Column="1" Content="{Binding GroupEditorLabel}" Click="Groups_Click" IsEnabled="{Binding IsSettingsEnabled}" Style="{StaticResource Action}" HorizontalAlignment="Stretch" />
                                        </Grid>
                                        <Button Content="{Binding SaveLabel}" Command="{Binding SaveSettingsCommand}" Style="{StaticResource Action}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    </ContentControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="WriteButton" Grid.Column="3" Content="{Binding WriteEditorLabel}" IsEnabled="{Binding IsWritableFunction}" Style="{StaticResource Action}" ToolTipService.ToolTip="{Binding WriteAvailabilityHelp}">
                        <Button.Flyout>
                            <Flyout x:Name="WriteFlyout" Placement="BottomEdgeAlignedRight" Opening="WriteFlyout_Opening"
                                    FlyoutPresenterStyle="{StaticResource CompactFlyoutPresenterStyle}">
                                <ScrollViewer x:Name="WriteScroll" MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ContentControl x:Name="WriteEditorRoot" IsEnabled="{Binding IsWriteEditorEnabled}" HorizontalContentAlignment="Stretch">
                                        <StackPanel x:Name="WritePanel" Width="340" Spacing="6" Margin="0,0,8,0">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Text="{Binding WriteEditorLabel}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="?" Width="24" Padding="0" Style="{StaticResource Action}"
                                                        ToolTipService.ToolTip="{Binding UsageDetailsLabel}" AutomationProperties.Name="{Binding UsageDetailsLabel}">
                                                    <Button.Flyout>
                                                        <Flyout Opening="WriteHelpFlyout_Opening" FlyoutPresenterStyle="{StaticResource CompactFlyoutPresenterStyle}">
                                                            <TextBlock x:Name="WriteHelpText" Text="{Binding WriteHelp}" Style="{StaticResource GuideBody}" />
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                            <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding WriteModeLabel}" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding WriteModes}" SelectedIndex="{Binding WriteModeIndex, Mode=TwoWay}"
                                                      Style="{StaticResource ModbusComboBoxStyle}" HorizontalAlignment="Stretch" MinWidth="0"
                                                      AutomationProperties.Name="{Binding WriteModeLabel}" ToolTipService.ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}">
                                                <ComboBox.Resources><x:Double x:Key="ComboBoxMinHeight">24</x:Double></ComboBox.Resources>
                                            </ComboBox>
                                            </StackPanel>
                                            <TextBlock Text="{Binding WriteItemSummary}" Visibility="{Binding WriteItemSummary, Converter={StaticResource NonEmptyTextVisibility}}" FontSize="11" TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="128,*" RowDefinitions="Auto,Auto" Style="{StaticResource ModbusFormGridStyle}">
                                                <TextBlock Text="{Binding WriteAddressLabel}" Style="{StaticResource FieldLabel}" />
                                                <TextBlock Grid.Column="1" Text="{Binding WriteValuesLabel}" Style="{StaticResource FieldLabel}" />
                                                <TextBox Grid.Row="1" Text="{Binding WriteAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberInput}" VerticalAlignment="Top" AutomationProperties.Name="{Binding WriteAddressLabel}" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WriteValuesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ValuesInput}" AutomationProperties.Name="{Binding WriteValuesLabel}" />
                                            </Grid>
                                            <TextBlock Text="{Binding WritePreview}" Visibility="{Binding WritePreview, Converter={StaticResource NonEmptyTextVisibility}}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{Binding WriteStatus}" Visibility="{Binding WriteStatusVisibility}" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding WriteError}" Visibility="{Binding WriteErrorVisibility}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource ErrorTextBrush}" />
                                            <Button Content="{Binding WriteLabel}" Command="{Binding WriteCommand}" Style="{StaticResource Action}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </ContentControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="CommandsButton" Grid.Column="4" Content="{Binding CommandsMenuLabel}" Style="{StaticResource Action}" ToolTipService.ToolTip="{Binding RecentCommandSummary}">
                        <Button.Flyout>
                            <Flyout x:Name="CommandsFlyout" Placement="BottomEdgeAlignedRight" Opening="CommandsFlyout_Opening"
                                    FlyoutPresenterStyle="{StaticResource CompactFlyoutPresenterStyle}">
                                <ScrollViewer x:Name="CommandsScroll" MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="CommandsPanel" Width="400" MinWidth="0" Spacing="5" Margin="0,0,8,0">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding CommandsLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="?" Width="24" Padding="0" Style="{StaticResource Action}"
                                                    ToolTipService.ToolTip="{Binding UsageDetailsLabel}" AutomationProperties.Name="{Binding UsageDetailsLabel}">
                                                <Button.Flyout>
                                                    <Flyout Opening="CommandHelpFlyout_Opening" FlyoutPresenterStyle="{StaticResource CompactFlyoutPresenterStyle}">
                                                        <TextBlock x:Name="CommandHelpText" Text="{Binding CommandHelp}" Style="{StaticResource GuideBody}" />
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding CommandSelectorLabel}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding CommandChoices}" SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" ToolTipService.ToolTip="{Binding SelectedCommand.DisplayName}" IsEnabled="{Binding IsCommandSelectionEnabled}"
                                                  Style="{StaticResource ModbusComboBoxStyle}" HorizontalAlignment="Stretch" MinWidth="0"
                                                  AutomationProperties.Name="{Binding CommandSelectorLabel}" MaxDropDownHeight="240">
                                            <ComboBox.Resources><x:Double x:Key="ComboBoxMinHeight">24</x:Double></ComboBox.Resources>
                                        </ComboBox>
                                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock Text="{Binding CommandTargetPreview}" Style="{StaticResource GuideBody}" FontFamily="Consolas" Margin="5,0,5,0" />
                                        </ScrollViewer>
                                        <Expander Header="{Binding WirePreviewLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource ModbusExpanderStyle}">
                                            <TextBlock Text="{Binding CommandWirePreview}" Style="{StaticResource GuideBody}" FontFamily="Consolas" />
                                        </Expander>
                                        <Button Content="{Binding ExecuteCommandLabel}" Command="{Binding ExecuteCommand}" Style="{StaticResource Action}" HorizontalAlignment="Stretch" />
                                        <Button Content="{Binding StopAllLabel}" Command="{Binding StopCommand}" Visibility="{Binding BusyVisibility}" Style="{StaticResource Action}" HorizontalAlignment="Stretch" />
                                        <TextBlock Text="{Binding Status}" Visibility="{Binding BusyVisibility}" Style="{StaticResource GuideBody}" />
                                        <Button Content="{Binding CommandEditorLabel}" Click="Commands_Click" IsEnabled="{Binding IsSettingsEnabled}" Style="{StaticResource Action}" HorizontalAlignment="Stretch" />
                                        <StackPanel Visibility="{Binding RecentCommandVisibility}" Spacing="5" MinWidth="0">
                                            <TextBlock Text="{Binding RecentCommandCaption}" Style="{StaticResource GuideBody}" FontWeight="SemiBold" ToolTipService.ToolTip="{Binding RecentCommandSummary}" />
                                            <TextBlock Text="{Binding RecentCommandAlert}" Visibility="{Binding RecentCommandAlertVisibility}" Style="{StaticResource GuideBody}" Foreground="{ThemeResource ErrorTextBrush}" />
                                            <Expander Header="{Binding CommandResultDetailsLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource ModbusExpanderStyle}">
                                                <TextBlock Text="{Binding RecentCommandResults}" Style="{StaticResource GuideBody}" />
                                            </Expander>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="GuideButton" Grid.Column="5" Content="?" Width="24" Padding="0"
                            Style="{StaticResource Action}" ToolTipService.ToolTip="{Binding GuideLabel}"
                            AutomationProperties.Name="{Binding GuideLabel}">
                        <Button.Flyout>
                            <Flyout x:Name="GuideFlyout" Placement="BottomEdgeAlignedRight" Opening="GuideFlyout_Opening"
                                    FlyoutPresenterStyle="{StaticResource CompactFlyoutPresenterStyle}">
                                <ScrollViewer x:Name="GuideScroll" MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="GuidePanel" Width="420" Spacing="4" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding GuideTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding GuidePurpose}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideModesTitle}" Style="{StaticResource GuideHeading}" />
                                        <TextBlock Text="{Binding GuideModesHelp}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideStartTitle}" Style="{StaticResource GuideHeading}" />
                                        <TextBlock Text="{Binding GuideConnectStep}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideSetupStep}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideReadStep}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideGroupsTitle}" Style="{StaticResource GuideHeading}" />
                                        <TextBlock Text="{Binding GuideGroupsHelp}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideDisplayTitle}" Style="{StaticResource GuideHeading}" />
                                        <TextBlock Text="{Binding GuideDisplayHelp}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideWriteTitle}" Style="{StaticResource GuideHeading}" />
                                        <TextBlock Text="{Binding GuideWriteHelp}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideCommandsTitle}" Style="{StaticResource GuideHeading}" />
                                        <TextBlock Text="{Binding GuideCommandsHelp}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideConnectionTitle}" Style="{StaticResource GuideHeading}" />
                                        <TextBlock Text="{Binding OwnershipHelp}" Style="{StaticResource GuideBody}" />
                                        <TextBlock Text="{Binding GuideSaveHelp}" Style="{StaticResource GuideBody}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="MonitorMoreButton" Grid.Column="6" Content="⋯" Visibility="Collapsed" Style="{StaticResource Action}"
                            AutomationProperties.Name="{Binding MoreActionsLabel}" ToolTipService.ToolTip="{Binding MoreActionsLabel}">
                        <Button.Flyout>
                            <Flyout x:Name="MonitorMoreFlyout" Placement="BottomEdgeAlignedRight" Opening="MoreFlyout_Opening"
                                    FlyoutPresenterStyle="{StaticResource CompactFlyoutPresenterStyle}">
                                <StackPanel x:Name="MorePanel" Spacing="4">
                                    <Button Content="{Binding WriteEditorLabel}" Click="ShowWriteFromOverflow_Click" IsEnabled="{Binding IsWritableFunction}"
                                            Style="{StaticResource Action}" HorizontalAlignment="Stretch" ToolTipService.ToolTip="{Binding WriteAvailabilityHelp}" />
                                    <Button Content="{Binding GuideLabel}" Click="ShowGuideFromOverflow_Click" Style="{StaticResource Action}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
        </Border>
        <Border Grid.Row="1" Background="{ThemeResource InspectorBodyBrush}" BorderBrush="{ThemeResource AppSurfaceBorderBrush}" BorderThickness="1" CornerRadius="4" MinHeight="0">
            <Grid MinHeight="0" RowDefinitions="Auto,*">
                <TextBlock Text="{Binding FirstReadHelp}" Visibility="{Binding FirstReadVisibility}" Margin="8,5"
                           Style="{StaticResource GuideBody}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ScrollViewer Grid.Row="1" x:Name="TableScroll" Visibility="{Binding RowsVisibility}" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <Grid MinWidth="660" RowDefinitions="Auto,*" MinHeight="0">
                        <Border Background="{ThemeResource InspectorHeaderBrush}" Padding="8,5,24,5">
                            <Grid ColumnDefinitions="90,*,1.4*,100,90,88" ColumnSpacing="8">
                                <TextBlock Text="{Binding TableAddressLabel}" Style="{StaticResource Cell}" FontSize="11" />
                                <TextBlock Grid.Column="3" Text="{Binding RawLabel}" Style="{StaticResource Cell}" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding TableNameLabel}" Style="{StaticResource Cell}" FontSize="11" />
                                <TextBlock Grid.Column="2" Text="{Binding ValueLabel}" Style="{StaticResource Cell}" FontSize="11" />
                                <TextBlock Grid.Column="4" Text="{Binding StateLabel}" Style="{StaticResource Cell}" FontSize="11" />
                                <TextBlock Grid.Column="5" Text="{Binding UpdatedLabel}" Style="{StaticResource Cell}" FontSize="11" />
                            </Grid>
                        </Border>
                        <ListView x:Name="RegisterList" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                  HorizontalContentAlignment="Stretch" SelectionMode="Single" MinHeight="0" Padding="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="{Binding TabTitle}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="28" />
                                    <Setter Property="Padding" Value="8,3" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="ContentTransitions"><Setter.Value><TransitionCollection /></Setter.Value></Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="90,*,1.4*,100,90,88" ColumnSpacing="8">
                                        <TextBlock Text="{Binding AddressText}" Style="{StaticResource Cell}" FontFamily="Consolas" />
                                        <TextBlock Grid.Column="3" Text="{Binding RawText}" Style="{StaticResource Cell}" FontFamily="Consolas" ToolTipService.ToolTip="{Binding RawText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding NameText}" Style="{StaticResource Cell}" ToolTipService.ToolTip="{Binding NameText}" />
                                        <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                            <TextBlock Text="{Binding ChangeText}" Style="{StaticResource Cell}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource Cell}" FontFamily="Consolas" ToolTipService.ToolTip="{Binding ValueText}" />
                                        </Grid>
                                        <TextBlock Grid.Column="4" Text="{Binding StatusText}" Style="{StaticResource Cell}" FontWeight="SemiBold" ToolTipService.ToolTip="{Binding StatusText}" />
                                        <TextBlock Grid.Column="5" Text="{Binding UpdatedText}" Style="{StaticResource Cell}" FontFamily="Consolas" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Visibility="{Binding EmptyVisibility}" MaxWidth="440" Margin="8" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EmptyHelp}" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button Content="{Binding EmptySetupLabel}" Click="ShowSettings_Click" IsEnabled="{Binding IsSettingsEnabled}" Style="{StaticResource Action}" />
                        <Button Content="{Binding ReadOnceLabel}" Command="{Binding ReadOnceCommand}" Style="{StaticResource Action}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
