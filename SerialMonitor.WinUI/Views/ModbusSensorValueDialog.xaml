<ContentDialog x:Class="SerialMonitor.WinUI.Views.ModbusSensorValueDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource DefaultContentDialogStyle}" Title="시뮬레이터 값 변경" TitleTemplate="{StaticResource ModbusDialogTitleTemplate}"
 PrimaryButtonText="값 적용" CloseButtonText="취소" DefaultButton="Primary" PrimaryButtonClick="Apply_Click" Closing="Dialog_Closing"
 PrimaryButtonStyle="{StaticResource ModbusAccentButtonStyle}" CloseButtonStyle="{StaticResource ModbusActionButtonStyle}">
 <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Spacing="8" MinWidth="300" MaxWidth="420" Margin="0,0,16,0">
   <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
   <TextBlock Text="{Binding Address}" FontSize="12" />
   <Grid ColumnDefinitions="128,*" RowDefinitions="Auto,Auto" Style="{StaticResource ModbusFormGridStyle}">
    <TextBlock Text="현재 값" Style="{StaticResource ModbusFieldLabelStyle}" />
    <TextBlock Grid.Column="1" Text="초기값" Style="{StaticResource ModbusFieldLabelStyle}" />
    <TextBlock Grid.Row="1" Text="{Binding CurrentValue}" TextWrapping="Wrap" FontSize="12" />
    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InitialValue}" TextWrapping="Wrap" FontSize="12" />
   </Grid>
   <StackPanel Spacing="4">
    <TextBlock x:Name="ValueLabel" Text="바꿀 값 (표시된 단위 기준)" Style="{StaticResource ModbusFieldLabelStyle}" />
    <TextBox x:Name="ValueEditor" Style="{StaticResource CompactTextBoxStyle}" MaxLength="256" AutomationProperties.LabeledBy="{Binding ElementName=ValueLabel}" />
   </StackPanel>
   <TextBlock Text="{Binding Details}" FontSize="12" TextWrapping="Wrap" />
   <TextBlock Text="다음에 처리하는 읽기 요청부터 이 값으로 응답해요. 제품 JSON의 초기값은 유지돼요." FontSize="12" TextWrapping="Wrap" />
   <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
  </StackPanel>
 </ScrollViewer>
</ContentDialog>
