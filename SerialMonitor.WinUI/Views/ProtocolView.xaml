<UserControl
    x:Class="SerialMonitor.WinUI.Views.ProtocolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:SerialMonitor.WinUI.Infrastructure"
    xmlns:views="using:SerialMonitor.WinUI.Views"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Loaded="View_Loaded"
    Unloaded="View_Unloaded"
    SizeChanged="View_SizeChanged">
    <UserControl.Resources>
        <x:Double x:Key="ComboBoxMinHeight">24</x:Double>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource InspectorBodyBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppSurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource ModbusActionButtonStyle}">
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style x:Key="ToolbarToggle" TargetType="ToggleButton" BasedOn="{StaticResource SearchOptionToggleStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource CompactComboBoxStyle}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource CompactTextBoxStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="infra:TextBoxContentAlignment.IsEnabled" Value="True" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="6,4,6,6" RowSpacing="5" RowDefinitions="Auto,*" MinHeight="0" MinWidth="0">
        <Border Background="{ThemeResource InspectorHeaderBrush}" CornerRadius="4" Padding="6,4">
            <Grid RowDefinitions="Auto,Auto">
                <Grid ColumnDefinitions="270,*,Auto" ColumnSpacing="10">
                    <views:ProtocolViewSelector x:Name="PresentationSelector" ItemsSource="{Binding PresentationOptions}" DisplayMemberPath="Label"
                              SelectedIndex="{Binding SelectedViewIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" MinWidth="0" MinHeight="24" Height="24"
                              Padding="8,0,28,0" FontSize="12" AutomationProperties.Name="{Binding ViewSelectionLabel}"
                              Style="{StaticResource CompactComboBoxStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding WorkspaceHeader}" Style="{StaticResource CellText}"
                               ToolTipService.ToolTip="{Binding WorkspaceHeaderHelp}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{Binding PacketAnalysisVisibility}">
                        <Grid x:Name="PacketBuilderSlot">
                        <Button Content="{Binding BuildPacketLabel}" Visibility="{Binding PacketBuilderVisibility}"
                                Click="BuildPacket_Click" Style="{StaticResource ToolbarButton}"
                                ToolTipService.ToolTip="{Binding BuildPacketToolTip}" />
                        </Grid>
                        <ToggleButton Content="{Binding FollowLabel}" IsChecked="{Binding IsFollowingLatest, Mode=TwoWay}"
                                      Style="{StaticResource ToolbarToggle}" ToolTipService.ToolTip="{Binding FollowToolTip}" />
                        <ToggleButton Content="{Binding PauseLabel}" IsChecked="{Binding IsDisplayPaused, Mode=TwoWay}"
                                      Style="{StaticResource ToolbarToggle}" ToolTipService.ToolTip="{Binding PauseToolTip}" />
                        <Button Content="{Binding FilterLabel}" Style="{StaticResource ToolbarButton}" ToolTipService.ToolTip="{Binding FilterSummary}">
                            <Button.Flyout>
                                <Flyout x:Name="FilterFlyout" Opening="FilterFlyout_Opening" Placement="BottomEdgeAlignedRight"
                                        FlyoutPresenterStyle="{StaticResource CompactFlyoutPresenterStyle}">
                                    <StackPanel x:Name="FilterEditorPanel" Width="320" Spacing="6">
                                        <TextBlock Text="{Binding FilterTitle}" FontSize="14" FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="84,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                            <TextBlock Text="{Binding FilterUnitLabel}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding FilterUnitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource CompactTextBoxStyle}" PlaceholderText="{Binding FilterUnitPlaceholder}" MaxLength="3" FontSize="12" KeyDown="FilterInput_KeyDown" />
                                            <TextBlock Grid.Row="1" Text="{Binding FilterFunctionLabel}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FilterFunctionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource CompactTextBoxStyle}" PlaceholderText="{Binding FilterFunctionPlaceholder}" MaxLength="4" FontSize="12" KeyDown="FilterInput_KeyDown" />
                                            <TextBlock Grid.Row="2" Text="{Binding FilterDirectionLabel}" FontSize="12" VerticalAlignment="Center" />
                                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding FilterDirectionOptions}"
                                                      SelectedIndex="{Binding FilterDirectionIndex, Mode=TwoWay}" Style="{StaticResource ModbusComboBoxStyle}" FontSize="12" HorizontalAlignment="Stretch">
                                                <!-- Flyout content does not inherit the view's size resource. -->
                                                <ComboBox.Resources><x:Double x:Key="ComboBoxMinHeight">24</x:Double></ComboBox.Resources>
                                            </ComboBox>
                                            <TextBlock Grid.Row="3" Text="{Binding FilterStateLabel}" FontSize="12" VerticalAlignment="Center" />
                                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding FilterStatusOptions}"
                                                      SelectedIndex="{Binding FilterStatusIndex, Mode=TwoWay}" Style="{StaticResource ModbusComboBoxStyle}" FontSize="12" HorizontalAlignment="Stretch">
                                                <ComboBox.Resources><x:Double x:Key="ComboBoxMinHeight">24</x:Double></ComboBox.Resources>
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock Text="{Binding FilterFunctionHelp}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding FilterScopeHelp}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding FilterValidationError}" Visibility="{Binding FilterValidationVisibility}"
                                                   FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource ErrorTextBrush}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Button Content="{Binding ResetFiltersLabel}" Click="ResetFilters_Click" Style="{StaticResource ModbusActionButtonStyle}" />
                                            <Button Grid.Column="1" Content="{Binding ApplyFiltersLabel}" Click="ApplyFilters_Click" Style="{StaticResource ModbusAccentButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <StackPanel x:Name="PacketUtilityActions" Orientation="Horizontal" Spacing="5">
                            <Button Content="{Binding ClearLabel}" Click="Clear_Click" Style="{StaticResource ToolbarButton}" />
                            <Button Content="{Binding ResetStatisticsLabel}" Click="ResetStatistics_Click" Style="{StaticResource ToolbarButton}" />
                        </StackPanel>
                        <Button x:Name="PacketOverflowButton" Content="⋯" Visibility="Collapsed" Style="{StaticResource ToolbarButton}"
                                ToolTipService.ToolTip="{Binding MoreActionsLabel}" AutomationProperties.Name="{Binding MoreActionsLabel}">
                            <Button.Flyout>
                                <Flyout x:Name="PacketActionsFlyout" Opening="PacketActionsFlyout_Opening"
                                        FlyoutPresenterStyle="{StaticResource CompactFlyoutPresenterStyle}">
                                    <StackPanel x:Name="PacketActionsPanel" Spacing="4">
                                        <Button Content="{Binding BuildPacketLabel}" Visibility="{Binding PacketBuilderVisibility}"
                                                Click="BuildPacketFromOverflow_Click" Style="{StaticResource ToolbarButton}" />
                                        <Button Content="{Binding ClearLabel}" Click="Clear_Click" Style="{StaticResource ToolbarButton}" />
                                        <Button Content="{Binding ResetStatisticsLabel}" Click="ResetStatistics_Click" Style="{StaticResource ToolbarButton}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        </StackPanel>
                        <Grid Visibility="{Binding RegisterMonitorVisibility}">
                            <StackPanel Orientation="Horizontal" Spacing="5" DataContext="{Binding Modbus}">
                                <Button Content="{Binding ReadOnceLabel}" Command="{Binding ReadOnceCommand}" Style="{StaticResource ToolbarButton}" />
                                <Button Content="{Binding StartLabel}" Command="{Binding StartCommand}" Style="{StaticResource ToolbarButton}" />
                            </StackPanel>
                        </Grid>
                        <Button x:Name="MonitorStopButton" DataContext="{Binding Modbus}" Content="{Binding StopLabel}"
                                Command="{Binding StopCommand}" Visibility="{Binding BusyVisibility}" Style="{StaticResource ToolbarButton}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*,2.6*" ColumnSpacing="10" Margin="0,5,0,0"
                      Visibility="{Binding PacketAnalysisVisibility}"
                      ToolTipService.ToolTip="{Binding StatisticsToolTip}">
                    <TextBlock Text="{Binding TrafficSummary}" Style="{StaticResource CellText}" />
                    <Border Grid.Column="1" Width="1" Margin="0,1" Background="{ThemeResource AppSurfaceBorderBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding CrcSummary}" Style="{StaticResource CellText}" />
                    <TextBlock Grid.Column="3" Text="{Binding ErrorSummary}" Style="{StaticResource CellText}" />
                    <TextBlock Grid.Column="4" Text="{Binding OtherSummary}" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="5" Text="{Binding HeaderMetadata}" Style="{StaticResource ColumnHeader}" TextAlignment="Right"
                               ToolTipService.ToolTip="{Binding HeaderMetadata}" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding RegisterMonitorVisibility}" MinHeight="0">
            <views:ModbusRtuView DataContext="{Binding Modbus}" />
        </Grid>

        <Grid x:Name="PacketWorkspace" Grid.Row="1" ColumnSpacing="6" MinHeight="0" MinWidth="0" Visibility="{Binding PacketAnalysisVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Border x:Name="PacketsPanel" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*" MinHeight="0">
                    <Border Background="{ThemeResource InspectorHeaderBrush}" BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource AppSurfaceBorderBrush}" Padding="8,4,22,4">
                        <Grid ColumnDefinitions="82,32,30,30,82,*" ColumnSpacing="8">
                            <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="1" Text="RX/TX" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="2" Text="{Binding AddressLabel}" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="3" Text="{Binding CodeLabel}" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="4" Text="{Binding StateLabel}" Style="{StaticResource ColumnHeader}" ToolTipService.ToolTip="{Binding StateToolTip}" />
                            <TextBlock Grid.Column="5" Text="{Binding FunctionLabel}" Style="{StaticResource ColumnHeader}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" MinHeight="0">
                        <ListView x:Name="PacketList" ItemsSource="{Binding Frames}"
                                  SelectedItem="{Binding SelectedFrame, Mode=TwoWay}" SelectionMode="Single"
                                  MinHeight="0" MinWidth="0" Padding="0" HorizontalContentAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding PacketsLabel}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="27" />
                                    <Setter Property="Padding" Value="8,2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="ContentTransitions"><Setter.Value><TransitionCollection /></Setter.Value></Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="82,32,30,30,82,*" ColumnSpacing="8"
                                          ToolTipService.ToolTip="{Binding Summary}" AutomationProperties.Name="{Binding Heading}">
                                        <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" Style="{StaticResource CellText}" />
                                        <Border Grid.Column="1" Background="{ThemeResource AppAccentTintBrush}" CornerRadius="3" Padding="2,0">
                                            <TextBlock Text="{Binding DirectionText}" FontFamily="Consolas" Style="{StaticResource CellText}" HorizontalAlignment="Center" FontSize="11" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding UnitText}" FontFamily="Consolas" Style="{StaticResource CellText}" />
                                        <TextBlock Grid.Column="3" Text="{Binding FunctionCodeText}" FontFamily="Consolas" Style="{StaticResource CellText}" />
                                        <Grid Grid.Column="4">
                                            <TextBlock Text="{Binding StatusText}" Visibility="{Binding NeutralVisibility}" Style="{StaticResource CellText}" />
                                            <TextBlock Text="{Binding StatusText}" Visibility="{Binding ErrorVisibility}" Style="{StaticResource CellText}"
                                                       Foreground="{ThemeResource ErrorTextBrush}" FontWeight="SemiBold" />
                                        </Grid>
                                        <TextBlock Grid.Column="5" Text="{Binding FunctionText}" Style="{StaticResource CellText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ScrollViewer Visibility="{Binding EmptyStateVisibility}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch">
                            <StackPanel Padding="12,8" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                                <TextBlock Text="{Binding EmptyTitle}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding EmptyLabel}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="DetailsPanel" Grid.Column="1" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*" MinHeight="0">
                    <Border Background="{ThemeResource InspectorHeaderBrush}" BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource AppSurfaceBorderBrush}" Padding="8,4">
                        <TextBlock Text="{Binding DetailsLabel}" Style="{StaticResource CellText}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top">
                        <StackPanel Padding="9,7" Spacing="8">
                            <TextBlock Text="{Binding PacketSummary}" Visibility="{Binding DetailsVisibility}" IsTextSelectionEnabled="True"
                                       FontSize="12" LineHeight="17" TextWrapping="Wrap" />
                            <views:ModbusValueInterpreterView DataContext="{Binding ValueInterpreter}" />
                            <Expander x:Name="RawDetailsExpander" Header="{Binding RawDetailsLabel}" IsExpanded="False"
                                      Visibility="{Binding DetailsVisibility}" Style="{StaticResource PacketDetailsExpanderStyle}">
                                <Expander.Resources>
                                    <StaticResource x:Key="ExpanderChevronMargin" ResourceKey="PacketDetailsChevronMargin" />
                                    <StaticResource x:Key="ExpanderChevronButtonSize" ResourceKey="PacketDetailsChevronButtonSize" />
                                </Expander.Resources>
                                <TextBlock Text="{Binding Details}" IsTextSelectionEnabled="True" VerticalAlignment="Top"
                                           FontFamily="Consolas" FontSize="11" LineHeight="16" TextWrapping="Wrap" />
                            </Expander>
                            <TextBlock Text="{Binding Details}" Visibility="{Binding SelectionHintVisibility}" FontSize="11"
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
