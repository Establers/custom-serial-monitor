<UserControl
    x:Class="SerialMonitor.WinUI.Views.ProtocolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Loaded="View_Loaded"
    Unloaded="View_Unloaded"
    SizeChanged="View_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource InspectorBodyBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppSurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppSurfaceBorderBrush}" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="6,4,6,6" RowSpacing="5" RowDefinitions="Auto,*,Auto" MinHeight="0" MinWidth="0">
        <Border Background="{ThemeResource InspectorHeaderBrush}" CornerRadius="4" Padding="6,4">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
                <Grid ColumnDefinitions="142,*,Auto" ColumnSpacing="10">
                    <ComboBox ItemsSource="{Binding ProtocolOptions}" SelectedIndex="{Binding SelectedProtocolIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" MinWidth="0" MinHeight="26" Height="26"
                              Padding="8,0,28,0" FontSize="12" AutomationProperties.Name="Protocol" />
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10"
                          VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Status}">
                        <TextBlock Text="{Binding Activity}" Style="{StaticResource CellText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding RetainedSummary}" Style="{StaticResource ColumnHeader}" />
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                        <Button Content="{Binding ClearLabel}" Click="Clear_Click" Style="{StaticResource ToolbarButton}" />
                        <Button Content="{Binding ResetStatisticsLabel}" Click="ResetStatistics_Click" Style="{StaticResource ToolbarButton}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="10"
                      ToolTipService.ToolTip="{Binding Statistics}">
                    <TextBlock Text="{Binding TrafficSummary}" Style="{StaticResource CellText}" />
                    <Border Grid.Column="1" Width="1" Margin="0,1" Background="{ThemeResource AppSurfaceBorderBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding CrcSummary}" Style="{StaticResource CellText}" />
                    <TextBlock Grid.Column="3" Text="{Binding ErrorSummary}" Style="{StaticResource CellText}" />
                    <TextBlock Grid.Column="4" Text="{Binding OtherSummary}" Style="{StaticResource ColumnHeader}" />
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="PacketWorkspace" Grid.Row="1" ColumnSpacing="6" MinHeight="0" MinWidth="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Border x:Name="PacketsPanel" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*" MinHeight="0">
                    <Border Background="{ThemeResource InspectorHeaderBrush}" BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource AppSurfaceBorderBrush}" Padding="8,4,22,4">
                        <Grid ColumnDefinitions="82,32,30,30,48,*" ColumnSpacing="8">
                            <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="1" Text="RX/TX" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="2" Text="ID" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="3" Text="FC" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="4" Text="CRC" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="5" Text="{Binding FunctionLabel}" Style="{StaticResource ColumnHeader}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" MinHeight="0">
                        <ListView x:Name="PacketList" ItemsSource="{Binding Frames}"
                                  SelectedItem="{Binding SelectedFrame, Mode=TwoWay}" SelectionMode="Single"
                                  MinHeight="0" MinWidth="0" Padding="0" HorizontalContentAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding PacketsLabel}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="27" />
                                    <Setter Property="Padding" Value="8,2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="ContentTransitions"><Setter.Value><TransitionCollection /></Setter.Value></Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="82,32,30,30,48,*" ColumnSpacing="8"
                                          ToolTipService.ToolTip="{Binding Summary}" AutomationProperties.Name="{Binding Heading}">
                                        <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" Style="{StaticResource CellText}" />
                                        <Border Grid.Column="1" Background="{ThemeResource AppAccentTintBrush}" CornerRadius="3" Padding="2,0">
                                            <TextBlock Text="{Binding DirectionText}" FontFamily="Consolas" Style="{StaticResource CellText}" HorizontalAlignment="Center" FontSize="11" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding UnitText}" FontFamily="Consolas" Style="{StaticResource CellText}" />
                                        <TextBlock Grid.Column="3" Text="{Binding FunctionCodeText}" FontFamily="Consolas" Style="{StaticResource CellText}" />
                                        <Grid Grid.Column="4">
                                            <TextBlock Text="{Binding CrcText}" Visibility="{Binding CrcOtherVisibility}" Style="{StaticResource CellText}" FontFamily="Consolas" />
                                            <TextBlock Text="{Binding CrcText}" Visibility="{Binding CrcErrorVisibility}" Style="{StaticResource CellText}" FontFamily="Consolas"
                                                       Foreground="{ThemeResource ErrorTextBrush}" FontWeight="SemiBold" />
                                        </Grid>
                                        <TextBlock Grid.Column="5" Text="{Binding FunctionText}" Style="{StaticResource CellText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ScrollViewer Visibility="{Binding EmptyStateVisibility}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch">
                            <StackPanel Padding="12,8" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                                <TextBlock Text="{Binding EmptyTitle}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding EmptyLabel}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="DetailsPanel" Grid.Column="1" Style="{StaticResource PanelBorder}">
                <Grid RowDefinitions="Auto,*" MinHeight="0">
                    <Border Background="{ThemeResource InspectorHeaderBrush}" BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource AppSurfaceBorderBrush}" Padding="8,4">
                        <TextBlock Text="{Binding DetailsLabel}" Style="{StaticResource CellText}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top">
                        <Grid Padding="9,7">
                            <TextBlock Text="{Binding Details}" Visibility="{Binding DetailsVisibility}" IsTextSelectionEnabled="True" VerticalAlignment="Top"
                                       FontFamily="Consolas" FontSize="12" LineHeight="17" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Details}" Visibility="{Binding SelectionHintVisibility}" FontSize="11"
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="2,0">
            <TextBlock Text="{Binding RetentionLabel}" Style="{StaticResource ColumnHeader}" ToolTipService.ToolTip="{Binding Status}" />
            <TextBlock Grid.Column="1" Text="{Binding StatisticsPeriod}" Style="{StaticResource ColumnHeader}"
                       TextAlignment="Right" ToolTipService.ToolTip="{Binding StatisticsPeriod}" />
        </Grid>
    </Grid>
</UserControl>
