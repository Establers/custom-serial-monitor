<ContentDialog x:Class="SerialMonitor.WinUI.Views.ModbusDeviceAiGuideDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource CompactContentDialogStyle}" Title="AI로 제품 정의 만들기" TitleTemplate="{StaticResource ModbusDialogTitleTemplate}"
 PrimaryButtonText="AI 지침 + JSON 예제 복사" CloseButtonText="닫기" DefaultButton="Close" PrimaryButtonClick="Copy_Click">
 <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Spacing="12" MaxWidth="420" Margin="0,0,16,0">
   <TextBlock FontSize="12" TextWrapping="Wrap" Text="제품의 통신 프로토콜 자료를 바탕으로 다른 AI에게 시뮬레이터용 JSON을 만들게 할 수 있어요." />
   <TextBlock FontSize="12" TextWrapping="Wrap" Text="1. 아래 버튼으로 지침과 JSON 예제를 복사하세요.&#x0a;2. AI 채팅에 붙여 넣고 제품의 통신 설명서·레지스터 맵·요청/응답 예제를 함께 주세요.&#x0a;3. 받은 JSON을 제품 관리 → JSON 불러오기에서 추가하세요." />
   <TextBlock FontSize="12" TextWrapping="Wrap" Text="추가한 뒤 장치 ID·주소·자료형·배율을 원본 자료와 확인하세요. 응답 시작을 누르면 선택한 제품으로 요청에 응답해요." />
   <TextBlock x:Name="CopyStatus" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
 </ScrollViewer>
</ContentDialog>
