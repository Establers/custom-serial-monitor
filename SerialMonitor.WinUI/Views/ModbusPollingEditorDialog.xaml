<ContentDialog
    x:Class="SerialMonitor.WinUI.Views.ModbusPollingEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:SerialMonitor.WinUI.Infrastructure"
    Style="{StaticResource CompactContentDialogStyle}" FontSize="12"
    Title="{Binding Title}" PrimaryButtonText="{Binding ApplyLabel}" CloseButtonText="{Binding CancelLabel}"
    DefaultButton="Primary" PrimaryButtonClick="Apply_Click" Unloaded="Dialog_Unloaded"
    TitleTemplate="{StaticResource ModbusDialogTitleTemplate}">
    <ContentDialog.Resources>
        <x:Double x:Key="ComboBoxMinHeight">24</x:Double>
        <Thickness x:Key="ComboBoxTopHeaderMargin">0,0,0,4</Thickness>
        <Thickness x:Key="TextBoxTopHeaderMargin">0,0,0,4</Thickness>
        <x:Double x:Key="ContentDialogMaxWidth">460</x:Double>
        <DataTemplate x:Key="FieldHeader">
            <TextBlock Text="{Binding}" Style="{StaticResource ModbusFieldLabelStyle}" FontFamily="{ThemeResource ContentControlThemeFontFamily}" />
        </DataTemplate>
        <Style x:Key="GroupInput" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="infra:TextBoxContentAlignment.IsEnabled" Value="True" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource GroupInput}" />
        <Style x:Key="GroupNumberInput" TargetType="TextBox" BasedOn="{StaticResource GroupInput}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModbusComboBoxStyle}" />
        <Style x:Key="GroupAction" TargetType="Button" BasedOn="{StaticResource ModbusActionButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource CompactCheckBoxStyle}" />
    </ContentDialog.Resources>
    <Grid RowDefinitions="*,Auto" RowSpacing="0" MinWidth="300" MaxHeight="540">
        <ScrollViewer x:Name="EditorScroll" MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch" MinHeight="0">
            <StackPanel x:Name="EditorPanel" Spacing="4" Margin="0,0,20,0">
                <TextBlock Text="{Binding Help}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding ListLabel}" FontWeight="SemiBold" />
                <ListView x:Name="GroupList" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                          SelectionChanged="GroupSelection_Changed"
                          SelectionMode="Single" MinHeight="24" MaxHeight="96" Padding="0"
                          AutomationProperties.Name="{Binding ListLabel}" HorizontalContentAlignment="Stretch">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="24" />
                            <Setter Property="Padding" Value="5,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FontSize" Value="12" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" ToolTipService.ToolTip="{Binding DisplayName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="12" VerticalAlignment="Center" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="6">
                    <Button Content="{Binding NewLabel}" Click="New_Click" Style="{StaticResource GroupAction}" />
                    <Button Grid.Column="1" Content="{Binding DuplicateLabel}" Click="Duplicate_Click" Style="{StaticResource GroupAction}" />
                    <Button Grid.Column="2" Content="{Binding RemoveLabel}" Click="Remove_Click" Style="{StaticResource GroupAction}" />
                    <Button Grid.Column="4" Content="{Binding ClearLabel}" Click="Clear_Click" Style="{StaticResource GroupAction}" />
                </Grid>
                <TextBox HeaderTemplate="{StaticResource FieldHeader}" Header="{Binding NameLabel}" Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="{Binding EnabledLabel}" IsChecked="{Binding Enabled, Mode=TwoWay}" Style="{StaticResource CompactCheckBoxStyle}" />
                <Grid ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding UnitLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBlock Text="{Binding FunctionLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBox Text="{Binding UnitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GroupNumberInput}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding UnitLabel}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Functions}" SelectedIndex="{Binding FunctionIndex, Mode=TwoWay}" Style="{StaticResource ModbusFunctionComboBoxStyle}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding FunctionLabel}" ToolTipService.ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" />
                </Grid>
                <Grid ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding AddressLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBlock Text="{Binding QuantityLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBox Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GroupNumberInput}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding AddressLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GroupNumberInput}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding QuantityLabel}" />
                </Grid>
                <Grid ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding IntervalLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBlock Text="{Binding TimeoutLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBox Text="{Binding IntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GroupNumberInput}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding IntervalLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding TimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GroupNumberInput}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding TimeoutLabel}" />
                </Grid>
                <Grid ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding FormatLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBlock Text="{Binding ScaleLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding Formats}" SelectedIndex="{Binding FormatIndex, Mode=TwoWay}" IsEnabled="{Binding IsRegister}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding FormatLabel}" ToolTipService.ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" />
                    <TextBox Grid.Column="1" Text="{Binding ScaleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRegister}" Style="{StaticResource GroupNumberInput}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding ScaleLabel}" />
                </Grid>
                <Grid ColumnDefinitions="128,*" ColumnSpacing="8">
                    <CheckBox Content="{Binding SwapBytesLabel}" IsChecked="{Binding SwapBytes, Mode=TwoWay}" IsEnabled="{Binding IsRegister}" Style="{StaticResource CompactCheckBoxStyle}" />
                    <CheckBox Grid.Column="1" Content="{Binding SwapWordsLabel}" IsChecked="{Binding SwapWords, Mode=TwoWay}" IsEnabled="{Binding CanSwapWords}" Style="{StaticResource CompactCheckBoxStyle}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding ItemsSummary}" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{Binding ItemsLabel}" Click="Items_Click" Style="{StaticResource GroupAction}" />
                </Grid>
                <Button Content="{Binding SaveGroupLabel}" Click="SaveGroup_Click" Style="{StaticResource GroupAction}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding DraftHelp}" Visibility="{Binding DraftHelp, Converter={StaticResource NonEmptyTextVisibility}}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="1" Margin="0,6,20,0" MaxHeight="64" VerticalScrollBarVisibility="Auto" Visibility="{Binding ErrorVisibility}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Foreground="{ThemeResource ErrorTextBrush}" />
        </ScrollViewer>
    </Grid>
</ContentDialog>
