<UserControl
    x:Class="SerialMonitor.WinUI.Views.ModbusValueInterpreterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:SerialMonitor.WinUI.Infrastructure"
    SizeChanged="View_SizeChanged"
    HorizontalContentAlignment="Stretch">
    <UserControl.Resources>
        <StaticResource x:Key="ExpanderChevronMargin" ResourceKey="PacketDetailsChevronMargin" />
        <StaticResource x:Key="ExpanderChevronButtonSize" ResourceKey="PacketDetailsChevronButtonSize" />
        <Style TargetType="TextBox" BasedOn="{StaticResource CompactTextBoxStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="infra:TextBoxContentAlignment.IsEnabled" Value="True" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource CompactComboBoxStyle}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource CompactCheckBoxStyle}" />
    </UserControl.Resources>
    <Expander Header="{Binding Title}" Visibility="{Binding Visibility}" IsExpanded="True"
              Style="{StaticResource PacketDetailsExpanderStyle}">
        <StackPanel Spacing="3">
            <StackPanel Visibility="{Binding EditorVisibility}" Spacing="3">
                <Grid x:Name="FieldsGrid" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                    <Grid ColumnDefinitions="Auto,Auto,64" ColumnSpacing="4">
                        <ComboBox ItemsSource="{Binding Formats}" SelectedIndex="{Binding FormatIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding FormatLabel}" ToolTipService.ToolTip="{Binding FormatLabel}"
                                  HorizontalAlignment="Left" MinWidth="88" Padding="5,0,24,0" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="+" VerticalAlignment="Center" FontSize="11" ToolTipService.ToolTip="{Binding OffsetLabel}" />
                        <TextBox Grid.Column="2" Text="{Binding OffsetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding OffsetLabel}" ToolTipService.ToolTip="{Binding OffsetLabel}" />
                    </Grid>
                    <Grid x:Name="ScaleFields" Grid.Column="1" ColumnDefinitions="Auto,76" ColumnSpacing="4" HorizontalAlignment="Left">
                        <TextBlock Text="×" VerticalAlignment="Center" FontSize="12" ToolTipService.ToolTip="{Binding ScaleLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding ScaleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding ScaleLabel}" ToolTipService.ToolTip="{Binding ScaleLabel}" />
                    </Grid>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox Content="{Binding SwapBytesLabel}" IsChecked="{Binding SwapBytes, Mode=TwoWay}"
                              ToolTipService.ToolTip="{Binding SwapBytesHelp}" FontSize="11" MinWidth="0" MinHeight="24" Height="24" Padding="4,0,0,0" Style="{StaticResource CompactCheckBoxStyle}" />
                    <CheckBox Content="{Binding SwapWordsLabel}" IsChecked="{Binding SwapWords, Mode=TwoWay}"
                              IsEnabled="{Binding IsWordSwapEnabled}" ToolTipService.ToolTip="{Binding SwapWordsHelp}" FontSize="11" MinWidth="0" MinHeight="24" Height="24" Padding="4,0,0,0" Style="{StaticResource CompactCheckBoxStyle}" />
                </StackPanel>
                <TextBlock Text="{Binding ValidationError}" Visibility="{Binding ErrorVisibility}" TextWrapping="Wrap" FontSize="11"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <ScrollViewer Visibility="{Binding ValuesVisibility}" MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding ValuesText}" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="11" LineHeight="14" TextWrapping="Wrap" Margin="0,0,16,0" />
                </ScrollViewer>
                <TextBlock Text="{Binding RemainderText}" Visibility="{Binding RemainderVisibility}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding Help}" Visibility="{Binding Help, Converter={StaticResource NonEmptyTextVisibility}}" ToolTipService.ToolTip="{Binding Help}" FontSize="10" MaxLines="1" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Expander>
</UserControl>
