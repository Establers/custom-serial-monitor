<UserControl
    x:Class="SerialMonitor.WinUI.Views.VirtualModbusDeviceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid Padding="6" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="5" MinHeight="0">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <Button Content="{Binding ImportLabel}" IsEnabled="{Binding CanOperate}" Click="Import_Click" FontSize="11" Padding="8,3" />
                <Button Content="{Binding PasteLabel}" IsEnabled="{Binding CanOperate}" Click="Paste_Click" FontSize="11" Padding="8,3" />
                <Button Content="{Binding SaveLabel}" IsEnabled="{Binding HasDevice}" Click="Save_Click" FontSize="11" Padding="8,3" ToolTipService.ToolTip="{Binding PersistenceHint}" />
                <Button Content="{Binding StartLabel}" IsEnabled="{Binding CanToggle}" Click="Start_Click" FontSize="11" Padding="12,3" />
                <Button Content="{Binding GuideLabel}" Click="Guide_Click" FontSize="11" Padding="8,3" />
                <Button Content="{Binding SampleLabel}" IsEnabled="{Binding CanOperate}" Click="Sample_Click" FontSize="11" Padding="8,3" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Spacing="2">
            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Status}" />
            <TextBlock Text="{Binding Message}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Message}" />
        </StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="160,*" ColumnSpacing="6" MinHeight="0">
            <Grid RowDefinitions="*,Auto" MinHeight="0">
                <ListView ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" MinHeight="0" SelectionMode="Single" IsEnabled="{Binding CanOperate}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="1" ToolTipService.ToolTip="{Binding Name}">
                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="ID" FontSize="11" /><TextBlock Text="{Binding UnitId}" FontSize="11" /></StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Grid.Row="1" Content="{Binding RemoveLabel}" IsEnabled="{Binding HasDevice}" Click="Remove_Click" FontSize="11" Padding="8,3" />
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" MinHeight="0">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="5">
                    <TextBlock Text="{Binding Hint}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Hint}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="‹" IsEnabled="{Binding CanPrevious}" Click="Previous_Click" Padding="7,1" />
                    <TextBlock Grid.Column="2" Text="{Binding PageText}" FontSize="11" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="›" IsEnabled="{Binding CanNext}" Click="Next_Click" Padding="7,1" />
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{Binding Registers}" SelectedItem="{Binding SelectedRegister, Mode=TwoWay}" SelectionMode="Single" HorizontalContentAlignment="Stretch" MinHeight="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,110" ColumnSpacing="6" ToolTipService.ToolTip="{Binding Description}">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Address}" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{Binding CurrentValue}" FontSize="12" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding CurrentValue}" />
                                    <TextBlock Text="{Binding Format}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                    <TextBox Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding ValueLabel}" IsEnabled="{Binding CanEdit}" FontSize="12" MinWidth="0" />
                    <Button Grid.Column="1" Content="{Binding ApplyLabel}" IsEnabled="{Binding CanEdit}" Click="Apply_Click" FontSize="11" Padding="8,3" />
                </Grid>
            </Grid>
        </Grid>
        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="Sensor ID" FontSize="11" VerticalAlignment="Center" />
            <TextBox Text="{Binding EditUnitId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasDevice}" Width="65" MaxLength="3" FontSize="12" />
            <Button Content="{Binding ChangeIdLabel}" IsEnabled="{Binding HasDevice}" Click="ChangeId_Click" FontSize="11" Padding="8,3" />
            <CheckBox Content="{Binding EchoLabel}" IsChecked="{Binding SuppressLocalEcho, Mode=TwoWay}" IsEnabled="{Binding CanConfigure}" FontSize="11" MinHeight="24" />
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
