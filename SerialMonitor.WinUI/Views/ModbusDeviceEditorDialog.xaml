<ContentDialog x:Class="SerialMonitor.WinUI.Views.ModbusDeviceEditorDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource CompactContentDialogStyle}" Title="제품 JSON 편집" TitleTemplate="{StaticResource ModbusDialogTitleTemplate}" FontSize="12"
 PrimaryButtonText="목록에 저장" CloseButtonText="취소" PrimaryButtonClick="Save_Click" Closing="Dialog_Closing">
 <ContentDialog.Resources><x:Double x:Key="ContentDialogMaxWidth">720</x:Double></ContentDialog.Resources>
 <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6" MinWidth="360" MaxWidth="660" MaxHeight="400">
  <TextBlock Text="JSON을 붙여 넣고 저장하세요. 저장할 때 형식·주소·초기값을 검사해요." TextWrapping="Wrap" FontSize="12" />
  <TextBox x:Name="JsonEditor" Grid.Row="1" Style="{StaticResource ModbusJsonEditorStyle}" MaxLength="262144" AutomationProperties.Name="제품 정의 JSON" />
  <ScrollViewer Grid.Row="2" MaxHeight="96" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ErrorText" Margin="0,0,16,0" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" /></ScrollViewer>
 </Grid>
</ContentDialog>
