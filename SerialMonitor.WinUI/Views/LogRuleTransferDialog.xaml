<ContentDialog
    x:Class="SerialMonitor.WinUI.Views.LogRuleTransferDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource CompactContentDialogStyle}"
    DefaultButton="Primary" PrimaryButtonClick="Primary_Click" Closed="Dialog_Closed">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    </ContentDialog.Resources>
    <StackPanel MinWidth="420" MaxWidth="510" Spacing="8">
        <TextBlock x:Name="HelpText" FontSize="12" TextWrapping="Wrap" />
        <CheckBox x:Name="SelectedOnlyBox" Style="{StaticResource CompactCheckBoxStyle}"
                  Click="SelectedOnly_Click" Visibility="Collapsed" />
        <TextBox x:Name="TransferText" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="200" MinWidth="0" FontFamily="Consolas" FontSize="12"
                 MaxLength="1000000" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 TextChanged="TransferText_Changed" />
        <TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</ContentDialog>
