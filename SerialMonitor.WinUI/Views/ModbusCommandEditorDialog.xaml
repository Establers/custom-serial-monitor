<ContentDialog
    x:Class="SerialMonitor.WinUI.Views.ModbusCommandEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:SerialMonitor.WinUI.Infrastructure"
    Style="{StaticResource DefaultContentDialogStyle}" FontSize="13"
    Title="{Binding Title}" PrimaryButtonText="{Binding ApplyLabel}" CloseButtonText="{Binding CancelLabel}"
    DefaultButton="Primary" PrimaryButtonClick="Apply_Click"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}" CloseButtonStyle="{StaticResource DefaultButtonStyle}">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
        <DataTemplate x:Key="FieldHeader">
            <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" FontFamily="{ThemeResource ContentControlThemeFontFamily}" />
        </DataTemplate>
        <Style x:Key="CommandInput" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="infra:TextBoxContentAlignment.IsEnabled" Value="True" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HeaderTemplate" Value="{StaticResource FieldHeader}" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource CommandInput}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HeaderTemplate" Value="{StaticResource FieldHeader}" />
        </Style>
        <Style x:Key="CommandAction" TargetType="Button" BasedOn="{StaticResource CompactActionButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource CompactCheckBoxStyle}" />
    </ContentDialog.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="7" MinWidth="340" MaxHeight="620">
        <TextBlock Text="{Binding Help}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="5">
            <ComboBox x:Name="CommandList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                      Header="{Binding CommandsLabel}" DisplayMemberPath="DisplayName" AutomationProperties.Name="{Binding CommandsLabel}" MaxDropDownHeight="260" />
            <Button Grid.Column="1" Content="{Binding NewCommandLabel}" Click="NewCommand_Click" Style="{StaticResource CommandAction}" />
            <Button Grid.Column="2" Content="{Binding DuplicateCommandLabel}" Click="DuplicateCommand_Click" Style="{StaticResource CommandAction}" />
            <Button Grid.Column="3" Content="{Binding RemoveCommandLabel}" Click="RemoveCommand_Click" Style="{StaticResource CommandAction}" />
            <Button Grid.Column="4" Content="{Binding ClearCommandsLabel}" Click="ClearCommands_Click" Style="{StaticResource CommandAction}" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Header="{Binding CommandNameLabel}" Text="{Binding CommandNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="{Binding SaveCommandLabel}" Click="SaveCommand_Click" Style="{StaticResource CommandAction}" VerticalAlignment="Bottom" />
        </Grid>
        <ListView x:Name="StepList" Grid.Row="3" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                  DisplayMemberPath="DisplayName" SelectionMode="Single" MinHeight="44" MaxHeight="88"
                  AutomationProperties.Name="{Binding StepsLabel}" HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="26" />
                    <Setter Property="Padding" Value="6,2" />
                    <Setter Property="FontSize" Value="12" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="5">
            <Button Content="{Binding NewStepLabel}" Click="NewStep_Click" Style="{StaticResource CommandAction}" />
            <Button Grid.Column="1" Content="{Binding DuplicateCommandLabel}" Click="DuplicateStep_Click" Style="{StaticResource CommandAction}"
                    ToolTipService.ToolTip="{Binding DuplicateStepLabel}" AutomationProperties.Name="{Binding DuplicateStepLabel}" />
            <Button Grid.Column="2" Content="{Binding RemoveCommandLabel}" Click="RemoveStep_Click" Style="{StaticResource CommandAction}"
                    ToolTipService.ToolTip="{Binding RemoveStepLabel}" AutomationProperties.Name="{Binding RemoveStepLabel}" />
            <Button Grid.Column="3" Content="↑" Click="MoveUp_Click" Style="{StaticResource CommandAction}"
                    ToolTipService.ToolTip="{Binding MoveUpLabel}" AutomationProperties.Name="{Binding MoveUpLabel}" />
            <Button Grid.Column="4" Content="↓" Click="MoveDown_Click" Style="{StaticResource CommandAction}"
                    ToolTipService.ToolTip="{Binding MoveDownLabel}" AutomationProperties.Name="{Binding MoveDownLabel}" />
            <Button Grid.Column="6" Content="{Binding SaveStepLabel}" Click="SaveStep_Click" Style="{StaticResource CommandAction}" />
        </Grid>
        <ScrollViewer x:Name="StepEditorScroll" Grid.Row="5" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch" MinHeight="0">
            <StackPanel x:Name="StepEditorPanel" Spacing="8" Margin="0,0,20,0">
                <TextBox Header="{Binding StepNameLabel}" Text="{Binding StepNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Grid ColumnDefinitions="125,*" ColumnSpacing="12">
                    <TextBox Header="{Binding UnitLabel}" Text="{Binding UnitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                    <ComboBox Grid.Column="1" Header="{Binding AreaLabel}" ItemsSource="{Binding Areas}" SelectedIndex="{Binding AreaIndex, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <TextBox Header="{Binding AddressLabel}" Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                    <TextBox Grid.Column="1" Header="{Binding ValueLabel}" Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                </Grid>
                <TextBlock Text="{Binding InterpretationSummary}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Expander Header="{Binding AdvancedLabel}" HeaderTemplate="{StaticResource FieldHeader}" IsExpanded="{Binding IsAdvancedExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <ComboBox Header="{Binding FormatLabel}" ItemsSource="{Binding Formats}" SelectedIndex="{Binding FormatIndex, Mode=TwoWay}" IsEnabled="{Binding CanEditFormat}" />
                            <TextBox Grid.Column="1" Header="{Binding ScaleLabel}" Text="{Binding ScaleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditScale}" FontFamily="Consolas" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <TextBox Header="{Binding EngineeringUnitLabel}" Text="{Binding EngineeringUnitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1" Header="{Binding TimeoutLabel}" Text="{Binding TimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <CheckBox Content="{Binding SwapBytesLabel}" IsChecked="{Binding SwapBytes, Mode=TwoWay}" IsEnabled="{Binding CanSwapBytes}" />
                            <CheckBox Grid.Column="1" Content="{Binding SwapWordsLabel}" IsChecked="{Binding SwapWords, Mode=TwoWay}" IsEnabled="{Binding CanSwapWords}" />
                        </Grid>
                        <Expander Header="{Binding ValueNamesLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding ValueNamesHelp}" TextWrapping="Wrap" FontSize="11" />
                                <TextBox Text="{Binding ValueNamesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="72" MaxHeight="104" VerticalContentAlignment="Top" Padding="8,4,24,4" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>
                <ComboBox Header="{Binding VerificationLabel}" ItemsSource="{Binding VerificationModes}" SelectedIndex="{Binding VerificationIndex, Mode=TwoWay}" />
                <TextBlock Text="{Binding VerificationHelp}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="StatusFields" Spacing="8" Visibility="{Binding StatusVisibility}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <ComboBox Header="{Binding StatusFunctionLabel}" ItemsSource="{Binding StatusFunctions}" SelectedIndex="{Binding StatusFunctionIndex, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Header="{Binding StatusAddressLabel}" Text="{Binding StatusAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <TextBox Header="{Binding MaskLabel}" Text="{Binding MaskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        <TextBox Grid.Column="1" Header="{Binding ExpectedLabel}" Text="{Binding ExpectedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <TextBox Header="{Binding VerificationTimeoutLabel}" Text="{Binding VerificationTimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        <TextBox Grid.Column="1" Header="{Binding VerificationIntervalLabel}" Text="{Binding VerificationIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                    </Grid>
                </StackPanel>
                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True" />
                <TextBlock Text="{Binding DraftHelp}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="6" MaxHeight="56" VerticalScrollBarVisibility="Auto" Visibility="{Binding ErrorVisibility}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Foreground="{ThemeResource ErrorTextBrush}" />
        </ScrollViewer>
    </Grid>
</ContentDialog>
