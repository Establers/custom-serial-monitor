<ContentDialog
    x:Class="SerialMonitor.WinUI.Views.ModbusCommandEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:SerialMonitor.WinUI.Infrastructure"
    Style="{StaticResource DefaultContentDialogStyle}" FontSize="12"
    Title="{Binding Title}" PrimaryButtonText="{Binding ApplyLabel}" CloseButtonText="{Binding CancelLabel}"
    DefaultButton="Primary" PrimaryButtonClick="Apply_Click" Unloaded="Dialog_Unloaded"
    TitleTemplate="{StaticResource ModbusDialogTitleTemplate}"
    PrimaryButtonStyle="{StaticResource ModbusAccentButtonStyle}" CloseButtonStyle="{StaticResource ModbusActionButtonStyle}">
    <ContentDialog.Resources>
        <Thickness x:Key="ContentDialogPadding">12</Thickness>
        <Thickness x:Key="ContentDialogTitleMargin">0,0,0,6</Thickness>
        <x:Double x:Key="ContentDialogButtonSpacing">8</x:Double>
        <x:Double x:Key="ContentDialogButtonHeight">24</x:Double>
        <x:Double x:Key="ContentDialogButtonMinHeight">24</x:Double>
        <x:Double x:Key="ComboBoxMinHeight">24</x:Double>
        <Thickness x:Key="ComboBoxTopHeaderMargin">0,0,0,4</Thickness>
        <Thickness x:Key="TextBoxTopHeaderMargin">0,0,0,4</Thickness>
        <x:Double x:Key="ContentDialogMaxWidth">480</x:Double>
        <DataTemplate x:Key="FieldHeader">
            <TextBlock Text="{Binding}" Style="{StaticResource ModbusFieldLabelStyle}" FontFamily="{ThemeResource ContentControlThemeFontFamily}" />
        </DataTemplate>
        <Style x:Key="CommandInput" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="infra:TextBoxContentAlignment.IsEnabled" Value="True" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource CommandInput}" />
        <Style x:Key="CommandNumberInput" TargetType="TextBox" BasedOn="{StaticResource CommandInput}">
            <Setter Property="Width" Value="128" />
            <Setter Property="MaxWidth" Value="128" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModbusComboBoxStyle}" />
        <Style x:Key="CommandAction" TargetType="Button" BasedOn="{StaticResource ModbusActionButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource CompactCheckBoxStyle}" />
    </ContentDialog.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="0" MinWidth="340" MaxHeight="620">
        <Expander Header="{Binding HelpLabel}" Margin="0,0,20,0" HeaderTemplate="{StaticResource FieldHeader}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource CompactExpanderStyle}">
            <Expander.Resources>
                <Thickness x:Key="ExpanderChevronMargin">4,0,4,0</Thickness>
                <x:Double x:Key="ExpanderChevronButtonSize">16</x:Double>
            </Expander.Resources>
            <TextBlock Text="{Binding Help}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Expander>
        <Grid Grid.Row="1" Margin="0,4,20,0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="4">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding CommandsLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                <ComboBox x:Name="CommandList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                          SelectionChanged="EditorSelection_Changed"
                          DisplayMemberPath="DisplayName" ToolTipService.ToolTip="{Binding SelectedCommand.DisplayName}" AutomationProperties.Name="{Binding CommandsLabel}" MaxDropDownHeight="260" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding NewCommandLabel}" Click="NewCommand_Click" Style="{StaticResource CommandAction}" VerticalAlignment="Bottom" />
            <Button Grid.Column="2" Content="{Binding DuplicateCommandLabel}" Click="DuplicateCommand_Click" Style="{StaticResource CommandAction}" VerticalAlignment="Bottom" />
            <Button Grid.Column="3" Content="{Binding RemoveCommandLabel}" Click="RemoveCommand_Click" Style="{StaticResource CommandAction}" VerticalAlignment="Bottom" />
            <Button Grid.Column="4" Content="{Binding ClearCommandsLabel}" Click="ClearCommands_Click" Style="{StaticResource CommandAction}" VerticalAlignment="Bottom" />
        </Grid>
        <TextBox Grid.Row="2" Margin="0,4,20,0" HeaderTemplate="{StaticResource FieldHeader}" Header="{Binding CommandNameLabel}" Text="{Binding CommandNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <ListView x:Name="StepList" Grid.Row="3" Margin="0,4,20,0" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                  SelectionChanged="EditorSelection_Changed"
                  SelectionMode="Single" MinHeight="24" MaxHeight="78"
                  AutomationProperties.Name="{Binding StepsLabel}" HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="24" />
                    <Setter Property="Padding" Value="5,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="FontSize" Value="12" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" ToolTipService.ToolTip="{Binding DisplayName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="12" VerticalAlignment="Center" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="4" Margin="0,4,20,0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="4">
            <Button Content="{Binding NewStepLabel}" Click="NewStep_Click" Style="{StaticResource CommandAction}" />
            <Button Grid.Column="1" Content="{Binding DuplicateCommandLabel}" Click="DuplicateStep_Click" Style="{StaticResource CommandAction}"
                    ToolTipService.ToolTip="{Binding DuplicateStepLabel}" AutomationProperties.Name="{Binding DuplicateStepLabel}" />
            <Button Grid.Column="2" Content="{Binding RemoveCommandLabel}" Click="RemoveStep_Click" Style="{StaticResource CommandAction}"
                    ToolTipService.ToolTip="{Binding RemoveStepLabel}" AutomationProperties.Name="{Binding RemoveStepLabel}" />
            <Button Grid.Column="3" Content="↑" Click="MoveUp_Click" Style="{StaticResource CommandAction}"
                    ToolTipService.ToolTip="{Binding MoveUpLabel}" AutomationProperties.Name="{Binding MoveUpLabel}" />
            <Button Grid.Column="4" Content="↓" Click="MoveDown_Click" Style="{StaticResource CommandAction}"
                    ToolTipService.ToolTip="{Binding MoveDownLabel}" AutomationProperties.Name="{Binding MoveDownLabel}" />
        </Grid>
        <ScrollViewer x:Name="StepEditorScroll" Grid.Row="5" Margin="0,4,0,0" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch" MinHeight="0">
            <StackPanel x:Name="StepEditorPanel" Spacing="4" Margin="0,0,20,0">
                <TextBox HeaderTemplate="{StaticResource FieldHeader}" Header="{Binding StepNameLabel}" Text="{Binding StepNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Grid ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding UnitLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBlock Text="{Binding AreaLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBox Text="{Binding UnitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CommandNumberInput}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding UnitLabel}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Areas}" SelectedIndex="{Binding AreaIndex, Mode=TwoWay}" Style="{StaticResource ModbusFunctionComboBoxStyle}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding AreaLabel}" ToolTipService.ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" />
                </Grid>
                <Grid ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding AddressLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBlock Text="{Binding ValueLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <TextBox Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CommandNumberInput}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding AddressLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CommandNumberInput}" Width="176" MaxWidth="176" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding ValueLabel}" />
                </Grid>
                <TextBlock Text="{Binding InterpretationSummary}" Visibility="{Binding InterpretationSummary, Converter={StaticResource NonEmptyTextVisibility}}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Expander Header="{Binding AdvancedLabel}" HeaderTemplate="{StaticResource FieldHeader}" IsExpanded="{Binding IsAdvancedExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource CompactExpanderStyle}">
                    <Expander.Resources>
                        <Thickness x:Key="ExpanderChevronMargin">4,0,4,0</Thickness>
                        <x:Double x:Key="ExpanderChevronButtonSize">16</x:Double>
                    </Expander.Resources>
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                            <TextBlock Text="{Binding FormatLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                            <TextBlock Text="{Binding ScaleLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding Formats}" SelectedIndex="{Binding FormatIndex, Mode=TwoWay}" IsEnabled="{Binding CanEditFormat}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding FormatLabel}" ToolTipService.ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" />
                            <TextBox Grid.Column="1" Text="{Binding ScaleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditScale}" Style="{StaticResource CommandNumberInput}" MaxWidth="128" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding ScaleLabel}" />
                        </Grid>
                        <Grid ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                            <TextBlock Text="{Binding EngineeringUnitLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                            <TextBlock Text="{Binding TimeoutLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                            <TextBox Text="{Binding EngineeringUnitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding EngineeringUnitLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding TimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CommandNumberInput}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding TimeoutLabel}" />
                        </Grid>
                        <Grid ColumnDefinitions="128,*" ColumnSpacing="8">
                            <CheckBox Content="{Binding SwapBytesLabel}" IsChecked="{Binding SwapBytes, Mode=TwoWay}" IsEnabled="{Binding CanSwapBytes}" Style="{StaticResource CompactCheckBoxStyle}" />
                            <CheckBox Grid.Column="1" Content="{Binding SwapWordsLabel}" IsChecked="{Binding SwapWords, Mode=TwoWay}" IsEnabled="{Binding CanSwapWords}" Style="{StaticResource CompactCheckBoxStyle}" />
                        </Grid>
                        <Expander Header="{Binding ValueNamesLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource CompactExpanderStyle}">
                            <Expander.Resources>
                                <Thickness x:Key="ExpanderChevronMargin">4,0,4,0</Thickness>
                                <x:Double x:Key="ExpanderChevronButtonSize">16</x:Double>
                            </Expander.Resources>
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding ValueNamesHelp}" TextWrapping="Wrap" FontSize="11" />
                                <TextBox Text="{Binding ValueNamesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="56" MaxHeight="104" VerticalContentAlignment="Top" Padding="8,4,24,4" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding VerificationLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding VerificationModes}" SelectedIndex="{Binding VerificationIndex, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding VerificationLabel}" ToolTipService.ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <TextBlock Text="{Binding VerificationHelp}" Visibility="{Binding VerificationHelp, Converter={StaticResource NonEmptyTextVisibility}}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="StatusFields" Spacing="6" Visibility="{Binding StatusVisibility}">
                    <Grid ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                        <TextBlock Text="{Binding StatusAddressLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusFunctionLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                        <TextBox Text="{Binding StatusAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CommandNumberInput}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding StatusAddressLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFunctions}" SelectedIndex="{Binding StatusFunctionIndex, Mode=TwoWay}" Style="{StaticResource ModbusFunctionComboBoxStyle}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding StatusFunctionLabel}" ToolTipService.ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}" />
                    </Grid>
                    <Grid ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                        <TextBlock Text="{Binding MaskLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                        <TextBlock Text="{Binding ExpectedLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                        <TextBox Text="{Binding MaskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CommandNumberInput}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding MaskLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding ExpectedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CommandNumberInput}" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding ExpectedLabel}" />
                    </Grid>
                    <Grid ColumnDefinitions="128,*" Style="{StaticResource ModbusFormGridStyle}" RowDefinitions="Auto,Auto">
                        <TextBlock Text="{Binding VerificationTimeoutLabel}" Style="{StaticResource ModbusFieldLabelStyle}" />
                        <TextBlock Text="{Binding VerificationIntervalLabel}" Grid.Column="1" Style="{StaticResource ModbusFieldLabelStyle}" />
                        <TextBox Text="{Binding VerificationTimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CommandNumberInput}" MaxWidth="128" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding VerificationTimeoutLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding VerificationIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CommandNumberInput}" MaxWidth="128" Grid.Row="1" VerticalAlignment="Top" AutomationProperties.Name="{Binding VerificationIntervalLabel}" />
                    </Grid>
                </StackPanel>
                <Expander Header="{Binding WirePreviewLabel}" HeaderTemplate="{StaticResource FieldHeader}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource CompactExpanderStyle}">
                    <Expander.Resources>
                        <Thickness x:Key="ExpanderChevronMargin">4,0,4,0</Thickness>
                        <x:Double x:Key="ExpanderChevronButtonSize">16</x:Double>
                    </Expander.Resources>
                    <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True" />
                </Expander>
                <TextBlock Text="{Binding DraftHelp}" Visibility="{Binding DraftHelp, Converter={StaticResource NonEmptyTextVisibility}}" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="6" Margin="0,4,20,0" MaxHeight="56" VerticalScrollBarVisibility="Auto" Visibility="{Binding ErrorVisibility}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Foreground="{ThemeResource ErrorTextBrush}" />
        </ScrollViewer>
    </Grid>
</ContentDialog>
