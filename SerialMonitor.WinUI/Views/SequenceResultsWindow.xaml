<Window
    x:Class="SerialMonitor.WinUI.Views.SequenceResultsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="using:SerialMonitor.WinUI.Infrastructure"
    Title="시퀀스 실행 결과">
    <Grid x:Name="Root" Padding="8" RowSpacing="5" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          RowDefinitions="Auto,Auto,Auto,3*,Auto,2*">
        <Grid.Resources>
            <infra:SequenceResultStatusConverter x:Key="ResultStatusText" />
            <infra:SequenceResultAccentConverter x:Key="ResultAccent" />
            <!-- Keep metadata compact; emphasize result/payload text inside the same 24px rows. -->
            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="LineHeight" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="5,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="6,2" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="5,3,5,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="ResultRowStyle" TargetType="ListViewItem">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="ContentTransitions"><Setter.Value><TransitionCollection /></Setter.Value></Setter>
            </Style>
            <!-- Explicit cell styles also apply inside the DataTemplate. Tight
                 line bounds center the visible glyphs instead of font leading. -->
            <Style x:Key="ResultCellStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextLineBounds" Value="Tight" />
                <Setter Property="Padding" Value="0,3" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
            <Style x:Key="ResultHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource ResultCellStyle}">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Opacity" Value="0.82" />
            </Style>
            <Style x:Key="ResultValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ResultCellStyle}">
                <Setter Property="FontSize" Value="12" />
            </Style>
        </Grid.Resources>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
            <ComboBox x:Name="RunBox" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun, Mode=TwoWay}"
                      DisplayMemberPath="DisplayText" PlaceholderText="실행 결과 선택" HorizontalAlignment="Stretch" SelectionChanged="Run_Changed"
                      AutomationProperties.Name="저장된 시퀀스 실행 선택" />
            <Button Grid.Column="1" Content="새로고침" Click="Refresh_Click" />
            <Button Grid.Column="2" Content="결과 폴더" Click="Folder_Click" />
        </Grid>
        <Border Grid.Row="1" Padding="8,3" CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="98,96,48,*,48,48" ColumnSpacing="5">
            <ComboBox x:Name="FilterBox" Width="98" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="응답 결과 필터">
                <ComboBoxItem Content="전체" Tag="" />
                <ComboBoxItem Content="미확인" Tag="not_matched" />
                <ComboBoxItem Content="일치" Tag="matched" />
                <ComboBoxItem Content="판정 불가" Tag="inconclusive" />
                <ComboBoxItem Content="검사 안 함" Tag="not_requested" />
                <ComboBoxItem Content="중단" Tag="canceled" />
            </ComboBox>
            <TextBox x:Name="RepeatBox" Grid.Column="1" Width="96" TextAlignment="Center" PlaceholderText="회차 (전체)" AutomationProperties.Name="회차 필터" />
            <Button Grid.Column="2" Content="적용" HorizontalAlignment="Stretch" Click="Apply_Click" />
            <Button Grid.Column="4" Content="이전" HorizontalAlignment="Stretch" IsEnabled="{Binding CanPrevious}" Click="Previous_Click" />
            <Button Grid.Column="5" Content="다음" HorizontalAlignment="Stretch" IsEnabled="{Binding CanNext}" Click="Next_Click" />
        </Grid>
        <Border Grid.Row="3" Padding="3" CornerRadius="6" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorAltBrush}">
            <Grid RowDefinitions="Auto,*">
                <Border Padding="4,3" MinHeight="24" CornerRadius="3,3,0,0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="32,32,64,154,88,*">
                        <TextBlock Text="회차" Style="{StaticResource ResultHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="단계" Style="{StaticResource ResultHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="유형" Style="{StaticResource ResultHeaderStyle}" />
                        <TextBlock Grid.Column="3" Text="시작 시각" Style="{StaticResource ResultHeaderStyle}" />
                        <TextBlock Grid.Column="4" Text="결과" FontSize="11" Style="{StaticResource ResultHeaderStyle}" />
                        <TextBlock Grid.Column="5" Text="전송 / 기대 패턴" FontSize="11" Style="{StaticResource ResultHeaderStyle}" />
                    </Grid>
                </Border>
                <ListView Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                          SelectionChanged="Step_Changed" ItemContainerStyle="{StaticResource ResultRowStyle}"
                          AutomationProperties.Name="회차별 단계 실행 결과">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="32,32,64,154,88,*" MinHeight="22" VerticalAlignment="Stretch">
                                <Border Grid.ColumnSpan="6" VerticalAlignment="Bottom" BorderThickness="0,0,0,1" Opacity="0.5"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" IsHitTestVisible="False" />
                                <TextBlock Text="{Binding Repeat}" Style="{StaticResource ResultCellStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Step}" Style="{StaticResource ResultCellStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border Grid.Column="2" Padding="4,0" MinHeight="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        CornerRadius="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <TextBlock Text="{Binding KindText}" Style="{StaticResource ResultCellStyle}" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding TimeText}" Style="{StaticResource ResultCellStyle}" FontFamily="Consolas"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border Grid.Column="4" Padding="4,1" MinHeight="20" MaxWidth="84" CornerRadius="4"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                                                 Fill="{Binding ResultStatus, Converter={StaticResource ResultAccent}}" />
                                        <TextBlock Text="{Binding ResultStatus, Converter={StaticResource ResultStatusText}}"
                                                   Style="{StaticResource ResultValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="5" Text="{Binding Command}" FontFamily="Consolas"
                                           Style="{StaticResource ResultValueStyle}" ToolTipService.ToolTip="{Binding Command}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        <TextBlock Grid.Row="4" Text="{Binding Error}" TextWrapping="Wrap" Foreground="OrangeRed" />
        <Grid Grid.Row="5" RowDefinitions="Auto,Auto,*" RowSpacing="4">
            <Border Padding="8,5" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Border>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="5">
                <TextBlock Text="로그 기록" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="이전 RX 구간" IsEnabled="{Binding CanPreviousRx}" Click="PreviousRx_Click" />
                <Button Grid.Column="3" Content="다음 RX 구간" IsEnabled="{Binding CanNextRx}" Click="NextRx_Click" />
            </Grid>
            <Border Grid.Row="2" Padding="8,5" CornerRadius="4" Background="{ThemeResource XtermSurfaceBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <RichTextBlock x:Name="RxText" FontFamily="Consolas" FontSize="11" FontWeight="Normal" LineHeight="14" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
