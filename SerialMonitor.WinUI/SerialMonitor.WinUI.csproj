<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SerialMonitor.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon\SerialMonitor.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win10-x64</RuntimeIdentifier>
    <UseRidGraph>true</UseRidGraph>
    <Version>1.6.5</Version>
    <AssemblyVersion>1.6.5.0</AssemblyVersion>
    <FileVersion>1.6.5.0</FileVersion>
    <!-- Optional separate app identity for UI preview builds. -->
    <AssemblyName Condition="'$(Configuration)' == 'Debug' and '$(UpdatePreviewBuild)' == 'true'">SerialMonitor.UpdatePreview</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260508005" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" PrivateAssets="all" />
    <PackageReference Include="RJCP.SerialPortStream" Version="3.0.5" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SerialMonitor.Core\SerialMonitor.Core.csproj" />
    <ProjectReference Include="..\SerialMonitor.PortDiagnosticWorker\SerialMonitor.PortDiagnosticWorker.csproj"
                      ReferenceOutputAssembly="false" SetPlatform="Platform=AnyCPU" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <Target Name="CollectPortDiagnosticWorker" BeforeTargets="GetCopyToOutputDirectoryItems;ComputeFilesToPublish" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="..\SerialMonitor.PortDiagnosticWorker\SerialMonitor.PortDiagnosticWorker.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=AnyCPU" RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="PortDiagnosticAssembly" />
    </MSBuild>
    <ItemGroup>
      <PortDiagnosticFiles Include="@(PortDiagnosticAssembly);@(PortDiagnosticAssembly->'%(RootDir)%(Directory)%(Filename).exe');@(PortDiagnosticAssembly->'%(RootDir)%(Directory)%(Filename).deps.json');@(PortDiagnosticAssembly->'%(RootDir)%(Directory)%(Filename).runtimeconfig.json');@(PortDiagnosticAssembly->'%(RootDir)%(Directory)SerialMonitor.Core.dll')" />
      <ContentWithTargetPath Include="@(PortDiagnosticFiles)" TargetPath="PortDiagnostics\%(Filename)%(Extension)"
                             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- A portable app must not require an installed .NET runtime just for diagnostics. -->
  <Target Name="PublishPortDiagnosticWorker" AfterTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <PortDiagnosticSelfContained Condition="'$(SelfContained)' == 'true'">true</PortDiagnosticSelfContained>
      <PortDiagnosticSelfContained Condition="'$(SelfContained)' != 'true'">false</PortDiagnosticSelfContained>
      <PortDiagnosticPublishDirectory>$(MSBuildProjectDirectory)\obj\PortDiagnosticPublish\$(Configuration)\self-contained-$(PortDiagnosticSelfContained)\</PortDiagnosticPublishDirectory>
    </PropertyGroup>
    <MSBuild Projects="..\SerialMonitor.PortDiagnosticWorker\SerialMonitor.PortDiagnosticWorker.csproj"
             Targets="Restore;Publish" BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=AnyCPU;RuntimeIdentifier=win-x64;SelfContained=$(PortDiagnosticSelfContained);PublishSingleFile=false;PublishTrimmed=false;PublishDir=$(PortDiagnosticPublishDirectory);NoBuild=false"
             RemoveProperties="RuntimeIdentifierOverride" />
    <Error Condition="!Exists('$(PortDiagnosticPublishDirectory)SerialMonitor.PortDiagnosticWorker.exe') or !Exists('$(PortDiagnosticPublishDirectory)SerialMonitor.PortDiagnosticWorker.dll') or !Exists('$(PortDiagnosticPublishDirectory)SerialMonitor.PortDiagnosticWorker.runtimeconfig.json') or !Exists('$(PortDiagnosticPublishDirectory)SerialMonitor.PortDiagnosticWorker.deps.json') or !Exists('$(PortDiagnosticPublishDirectory)SerialMonitor.Core.dll')"
           Text="Port diagnostic worker publish payload is incomplete." />
    <Error Condition="'$(PortDiagnosticSelfContained)' == 'true' and (!Exists('$(PortDiagnosticPublishDirectory)hostfxr.dll') or !Exists('$(PortDiagnosticPublishDirectory)coreclr.dll'))"
           Text="The portable port diagnostic worker is missing its .NET runtime." />
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('PortDiagnostics\')) or $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('SerialMonitor.PortDiagnosticWorker'))" />
      <PortDiagnosticPublishedFiles Include="$(PortDiagnosticPublishDirectory)**\*" Exclude="$(PortDiagnosticPublishDirectory)**\*.pdb" />
      <ResolvedFileToPublish Include="@(PortDiagnosticPublishedFiles)" RelativePath="PortDiagnostics\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="SerialMonitor.WinUI.Tests" />
    <EmbeddedResource Include="Assets\xterm\app-shortcuts.json.js" LogicalName="SerialMonitor.AppShortcuts" />
    <EmbeddedResource Include="..\skills\serial-monitor-control\assets\memory\INDEX.md" LogicalName="SerialMonitor.AgentMemory.Index" />
    <EmbeddedResource Include="..\skills\serial-monitor-control\assets\memory\PRODUCT_TEMPLATE.md" LogicalName="SerialMonitor.AgentMemory.ProductTemplate" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\docs\sequence_authoring.md;..\docs\sequence_examples.json;..\docs\sequence_rx_example.json;..\docs\ai_control.md;..\docs\agent_skills.md;..\docs\agent_plugins.md">
      <Link>docs\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\xterm\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\context\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\FunBackgrounds\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Loading\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\AppIcon\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Import Project="..\build\ShortcutArchitecture.targets" />
</Project>
