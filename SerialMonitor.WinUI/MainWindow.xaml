                                            Command="{Binding CheckCommand}" Height="28" MinHeight="28" Padding="10,0"
                                            FontSize="12" CornerRadius="4" BorderThickness="1"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                </Grid>
                                <Border Grid.Row="1" Background="{ThemeResource InspectorSectionBrush}"
                                        BorderBrush="{ThemeResource AppSurfaceBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,7">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding StatusGlyph}" FontSize="14" Visibility="{Binding StatusGlyphVisibility}" />
                                            <ProgressRing IsActive="{Binding IsChecking}" Visibility="{Binding ProgressVisibility}"
                                                          Width="16" Height="16" MinWidth="16" MinHeight="16"
                                                          Background="{ThemeResource InspectorSectionBrush}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <TextBlock x:Uid="UpdateDownloadHint" Text="Release notes and downloads open in your browser."
                                                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding ReleaseVisibility}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PreferenceError}" Visibility="{Binding PreferenceErrorVisibility}"
                                                       Foreground="{ThemeResource WarningTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                    Visibility="{Binding ReleaseVisibility}">
                                            <Button x:Uid="UpdateViewRelease" Content="View release" Command="{Binding OpenCommand}"
                                                    Height="26" MinHeight="26" Padding="10,0" FontSize="12" CornerRadius="4"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            <Button x:Uid="UpdateMore" Width="26" Height="26" MinHeight="26" Padding="0"
                                                    AutomationProperties.Name="Update options" infra:AppToolTipService.ToolTip="Update options">
                                                <FontIcon Glyph="&#xE712;" FontSize="12" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem x:Uid="UpdateSkip" Text="Skip this version" Command="{Binding SkipCommand}" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="2" Text="{Binding LastCheckedText}" FontSize="11" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" infra:AppToolTipService.ToolTip="{Binding LastCheckedText}" />
                                <Border Grid.Row="3" Background="{ThemeResource InspectorSectionBrush}"
                                        BorderBrush="{ThemeResource AppSurfaceBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,7">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="AgentPluginTitle" Text="AI 플러그인으로 연결하세요" FontSize="12"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Uid="AgentPluginAboutBody" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="Codex·Claude Code·GitHub Copilot용 AI 플러그인으로 장치 제어를 시작해 보세요. Plugin 탭에서 설치와 업데이트 방법을 확인할 수 있습니다." />
                                        <HyperlinkButton x:Uid="AgentPluginGuideLink" Content="플러그인 설치 · 업데이트 안내 ↗"
                                                         NavigateUri="https://github.com/Establers/custom-serial-monitor/blob/main/docs/agent_plugins.md"
                                                         FontSize="11" Padding="0,2" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="박재환" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="·" FontSize="11" VerticalAlignment="Center" />
                                    <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/Establers/custom-serial-monitor"
                                                     FontSize="11" Padding="0" MinHeight="18" Height="18" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabViewItem>
                </TabView>
            </Grid>

            <Grid Grid.Row="1"
                  Grid.Column="0"
                  Background="{ThemeResource CompactSurfaceBrush}"
                  IsHitTestVisible="False">
                <Border BorderBrush="{ThemeResource AppSurfaceBorderBrush}"
                        BorderThickness="0,1,0,1" />
                <Border Width="36"
                        Height="2"
                        Background="{ThemeResource NavigationButtonForegroundBrush}"
                        CornerRadius="1"
                        Opacity="0.28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </Grid>

            <infra:ResizeHandleControl x:Uid="StaticUi241" x:Name="InspectorResizeHandle"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Height="20"
                                       VerticalAlignment="Bottom"
                                       Canvas.ZIndex="30"
                                       IsTabStop="False"
                                       PointerPressed="InspectorResizeHandle_PointerPressed"
                                       PointerMoved="InspectorResizeHandle_PointerMoved"
                                       PointerReleased="InspectorResizeHandle_PointerReleased"
                                       PointerCaptureLost="InspectorResizeHandle_PointerCaptureLost"
                                       AutomationProperties.Name="Resize inspector panel"
                                       AutomationProperties.HelpText="Drag to resize. Double-click to collapse or restore."
                                       infra:AppToolTipService.ToolTip="Drag to resize. Double-click to collapse or restore.">
                <infra:ResizeHandleControl.Template>
                    <ControlTemplate TargetType="infra:ResizeHandleControl">
                        <Grid Background="Transparent">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </infra:ResizeHandleControl.Template>
            </infra:ResizeHandleControl>
        </Grid>

        <Border Grid.Row="2"
                MinHeight="22"
                Style="{StaticResource CompactSurfaceBorderStyle}"
                Padding="2">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <TextBlock x:Uid="StaticUi260" Text="{Binding FooterStatusText}"
                               FontSize="11"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               infra:AppToolTipService.ToolTip="{Binding FooterStatusToolTipText}"
                               MaxLines="1">
                        <TextBlock.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="FooterCopyStatusMenuItem"
                                                Text="Copy status"
                                                Click="FooterCopyStatusMenuItem_Click" />
                            </MenuFlyout>
                        </TextBlock.ContextFlyout>
                    </TextBlock>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Uid="AutomationStatus" Text="{Binding AutomationStatusText}" FontSize="11" VerticalAlignment="Center"
                               MaxWidth="250" TextTrimming="CharacterEllipsis" infra:AppToolTipService.ToolTip="Local AI/CLI control uses this app's serial connection. RX captures are independent of the log view." />
                    <Button x:Uid="StopAutomation" Content="Stop AI" Command="{Binding CancelAutomationCommand}" Height="18" MinHeight="18"
                            Padding="6,0" FontSize="11" infra:AppToolTipService.ToolTip="Stop RX capture. Already sent commands cannot be undone." />
                </StackPanel>
                <Button x:Name="UpdateStatusButton" Grid.Column="2" Visibility="{Binding NotificationVisibility}"
                        Click="UpdateStatusButton_Click" Height="18" MinHeight="18" Padding="6,0" FontSize="11"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        infra:AppToolTipService.ToolTip="{Binding Status}" AutomationProperties.Name="{Binding NotificationText}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE898;" FontSize="10" />
                        <TextBlock Text="{Binding NotificationText}" FontSize="11" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>


        <InfoBar x:Name="EventNotificationInfoBar"
                 Grid.RowSpan="3"
                 Canvas.ZIndex="100"
                 Width="460"
                 Margin="0,36,12,0"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Warning" />
    </Grid>
</Window>
