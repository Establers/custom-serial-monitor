                <Button.Flyout>
                    <Flyout x:Name="PortAliasFlyout"
                            Placement="BottomEdgeAlignedRight"
                            Opening="PortAliasFlyout_Opening"
                            Closed="PortAliasFlyout_Closed"
                            Opened="PortAliasFlyout_Opened">
                        <StackPanel x:Name="PortAliasEditor" Width="260" Spacing="8" KeyDown="PortAliasEditor_KeyDown">
                            <TextBlock Text="{Binding EditingPortText}" FontWeight="SemiBold" />
                            <TextBox x:Uid="PortAliasInput" x:Name="PortAliasTextBox"
                                     Text="{Binding DraftAlias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="64" IsEnabled="{Binding CanApply}"
                                     PlaceholderText="e.g. Main board" />
