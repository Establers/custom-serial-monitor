                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Visibility="{Binding ErrorVisibility}" />
                            <Button x:Uid="PortAliasApply" Content="Apply"
                                    HorizontalAlignment="Right" IsEnabled="{Binding CanApply}"
                                    Click="PortAliasApplyButton_Click" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid"
              Grid.Row="1"
              RowSpacing="0"
              ColumnSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ContentLogRow"
                               Height="2*" />
                <RowDefinition x:Name="ContentResizeHandleRow"
                               Height="6" />
                <RowDefinition x:Name="ContentCommandsRow"
                               Height="Auto" />
                <RowDefinition x:Name="ContentInspectorRow"
                               Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LogColumn"
                                  Width="*" />
                <ColumnDefinition x:Name="InspectorColumn"
                                  Width="0" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="LogPanel"
                  Grid.Row="0"
                  Grid.Column="0"
                  RowSpacing="4"
                  RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        Style="{StaticResource CompactSurfaceBorderStyle}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                          ColumnSpacing="4">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <ToggleButton x:Uid="FollowLatestLogButton" x:Name="FollowLatestLogButton"
                                      Width="24" Height="24" MinWidth="24" MinHeight="24"
                                      Padding="0" CornerRadius="4"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsAutoScrollEnabled, Mode=TwoWay}"
                                      AutomationProperties.Name="Follow latest logs"
                                      infra:AppToolTipService.ToolTip="{Binding AutoScrollToolTip}">
                            <PathIcon Width="16" Height="16"
                                      Data="M 0,0 L 8,0 8,1.5 0,1.5 Z M 0,4 L 8,4 8,5.5 0,5.5 Z M 0,8 L 5,8 5,9.5 0,9.5 Z M 11,2 L 12.5,2 12.5,12 15,9.5 16,10.5 11.75,14.75 7.5,10.5 8.5,9.5 11,12 Z" />
                        </ToggleButton>
                        <Button Style="{StaticResource NavigationIconButtonStyle}"
                                Command="{Binding ToggleLogRenderingPauseCommand}"
                                infra:AppToolTipService.ToolTip="{Binding PauseRenderingToolTip}">
                            <Grid>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="12"
                                          UseLayoutRounding="False"
                                          Glyph="&#xE769;"
                                          Visibility="{Binding PauseRenderingIconVisibility}" />
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="12"
                                          UseLayoutRounding="False"
                                          Glyph="&#xE768;"
                                          Foreground="{ThemeResource ErrorTextBrush}"
                                          Visibility="{Binding ResumeRenderingIconVisibility}" />
                            </Grid>
                        </Button>
                        <Button x:Uid="StaticUi016"
                                Style="{StaticResource NavigationIconButtonStyle}"
                                Command="{Binding ClearScreenCommand}"
                                AutomationProperties.Name="Clear screen"
                                infra:AppToolTipService.ToolTip="Clear screen: clear visible logs. In HEX mode, this also restarts the RX BUSY/IDLE measurement window.">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="14"
                                      UseLayoutRounding="False"
                                      Glyph="&#xE74D;" />
                        </Button>
                        <Button x:Uid="LogNavigateButton" x:Name="LogNavigateButton"
                                Style="{StaticResource NavigationIconButtonStyle}"
                                AutomationProperties.Name="Go to time"
                                infra:AppToolTipService.ToolTip="Go to time (Ctrl+G)"
                                Click="LogNavigateButton_Click">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="14"
                                      UseLayoutRounding="False"
                                      Glyph="&#xE917;" />
                        </Button>
                    </StackPanel>
                    <Button x:Uid="StaticUi006" x:Name="LogToolbarScrollBackButton"
                            Grid.Column="1"
                            Style="{StaticResource NavigationIconButtonStyle}"
                            Visibility="Collapsed"
                            Click="ToolbarScrollBackButton_Click"
                            infra:AppToolTipService.ToolTip="Scroll log controls left">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="12"
                                  UseLayoutRounding="False"
                                  Glyph="&#xE76B;" />
                    </Button>
                    <ScrollViewer x:Name="LogToolbarScrollViewer"
                                  Grid.Column="2"
                                  HorizontalScrollMode="Enabled"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  ViewChanged="HorizontalToolbarScrollViewer_ViewChanged"
                                  SizeChanged="HorizontalToolbarScrollViewer_SizeChanged">
                    <Grid Width="{Binding ViewportWidth, ElementName=LogToolbarScrollViewer}"
                          MinWidth="800"
                          ColumnSpacing="4"
                          ColumnDefinitions="350,Auto,Auto,Auto,Auto,Auto,Auto,Auto,96,*">
                        <Grid Grid.Column="0" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <TextBox x:Uid="StaticUi007" x:Name="SearchTextBox"
                                     Grid.Column="0"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Search visible log"
                                     Style="{StaticResource CompactTextBoxStyle}"
                                     MinWidth="310"
                                     MaxWidth="495"
                                     VerticalAlignment="Center"
                                     KeyDown="SearchTextBox_KeyDown"
                                     infra:AppToolTipService.ToolTip="Search visible log (click Search or press Enter to refresh and move next; Up/Down history)" />
                            <Button x:Uid="SearchVisibleLogButton"
                                    Grid.Column="1"
                                    Style="{StaticResource NavigationIconButtonStyle}"
                                    Command="{Binding SearchVisibleLogCommand}"
                                    AutomationProperties.Name="Search"
                                    infra:AppToolTipService.ToolTip="Search with current options and move to the next match (Enter)">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="12"
                                          UseLayoutRounding="False"
                                          Glyph="&#xE721;" />
                            </Button>
                        </Grid>
                        <Button x:Uid="StaticUi008" Grid.Column="1"
                                Style="{StaticResource NavigationIconButtonStyle}"
                                Command="{Binding FindPreviousCommand}"
                                infra:AppToolTipService.ToolTip="Previous result from the last search (Shift+F3 or F4)">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="12"
                                      UseLayoutRounding="False"
                                      Glyph="&#xE76B;" />
                        </Button>
                        <Button x:Uid="StaticUi009" Grid.Column="2"
                                Style="{StaticResource NavigationIconButtonStyle}"
                                Command="{Binding FindNextCommand}"
                                infra:AppToolTipService.ToolTip="Next result from the last search (F3)">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="12"
                                      UseLayoutRounding="False"
                                      Glyph="&#xE76C;" />
                        </Button>
                        <ToggleButton Grid.Column="3"
                                  Content="Aa"
                                  AutomationProperties.Name="대소문자 구분"
                                  IsChecked="{Binding IsSearchCaseSensitive, Mode=TwoWay}"
                                  Style="{StaticResource SearchOptionToggleStyle}"
                                  infra:AppToolTipService.ToolTip="대소문자 구분 · 다른 옵션과 함께 사용 가능 (검색창에서 Alt+C)" />
                        <ToggleButton Grid.Column="4"
                                  Content="|ab|"
                                  AutomationProperties.Name="단어 전체 일치"
                                  IsChecked="{Binding IsSearchWholeWord, Mode=TwoWay}"
                                  Style="{StaticResource SearchOptionToggleStyle}"
                                  infra:AppToolTipService.ToolTip="단어 전체 일치 · 다른 옵션과 함께 사용 가능 (검색창에서 Alt+W)" />
                        <ToggleButton Grid.Column="5"
                                  Content=".*"
                                  AutomationProperties.Name="정규식"
                                  IsChecked="{Binding IsSearchRegularExpression, Mode=TwoWay}"
                                  Style="{StaticResource SearchOptionToggleStyle}"
                                  infra:AppToolTipService.ToolTip="정규식 사용 · 다른 옵션과 함께 사용 가능 (검색창에서 Alt+R)" />
                        <TextBlock Grid.Column="6"
                                   Text="{Binding SearchSummaryText}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Uid="VisibleFilterLabel"
                                   Grid.Column="7"
                                   Text="Filter"
                                   Style="{StaticResource CompactLabelTextStyle}" />
                        <Button x:Uid="VisibleFilterButton"
                                x:Name="VisibleLogFilterButton"
                                Grid.Column="8"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                Width="96"
                                HorizontalContentAlignment="Stretch"
                                infra:AppToolTipService.ToolTip="{Binding CurrentVisibleFilterToolTip}"
                                AutomationProperties.Name="Select visible log filters">
                            <Button.Content>
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="4">
                                    <TextBlock Text="{Binding CurrentVisibleFilterText}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="1"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="9"
                                              Glyph="&#xE70D;" />
                                </Grid>
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout x:Name="VisibleLogFilterFlyout"
                                        Placement="BottomEdgeAlignedLeft"
                                        Opening="VisibleLogFilterFlyout_Opening"
                                        Closed="VisibleLogFilterFlyout_Closed">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                            <Setter Property="Padding" Value="12" />
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <Border Width="248" MaxWidth="280">
                                        <Border.Resources>
                                            <!-- Keep the rest of the app's compact checkboxes at 14. -->
                                            <x:Double x:Key="CompactCheckBoxSize">16</x:Double>
                                            <x:Double x:Key="CompactCheckBoxSpacing">6</x:Double>
                                        </Border.Resources>
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4,0,4,0">
                                                <TextBlock x:Uid="VisibleFilterFlyoutTitle"
                                                           Text="Log filters" FontSize="14" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="1" Padding="8,3" CornerRadius="10"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                    <TextBlock Text="{Binding PendingVisibleFilterSummaryText}" FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               AutomationProperties.LiveSetting="Polite" />
                                                </Border>
                                            </Grid>
                                            <CheckBox x:Uid="VisibleFilterAllCheckBox"
                                                      Content="All logs"
                                                      FontWeight="SemiBold"
                                                      Style="{StaticResource FilterFlyoutCheckBoxStyle}"
                                                      IsChecked="{Binding AllVisibleLogFilterOption.IsChecked, Mode=TwoWay}"
                                                      infra:AppToolTipService.ToolTip="Show all retained and incoming logs" />
                                            <Border Height="1"
                                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4,0,4,0">
                                                <TextBlock x:Uid="VisibleFilterRulesLabel" Text="Rules" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Uid="VisibleFilterMatchHint" Grid.Column="1" Text="Match any rule" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Grid>
                                            <ScrollViewer MaxHeight="224"
                                                          IsTabStop="False"
                                                          HorizontalScrollMode="Disabled"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollMode="Auto"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding VisibleLogFilterOptions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox AutomationProperties.Name="{Binding DisplayName}"
                                                                      Content="{Binding DisplayName}"
                                                                      ContentTemplate="{StaticResource FilterFlyoutRuleContentTemplate}"
                                                                      Style="{StaticResource FilterFlyoutCheckBoxStyle}"
                                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                      infra:AppToolTipService.ToolTip="{Binding DisplayName}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <TextBlock x:Uid="VisibleFilterHelpText"
                                                       Text="Applies to retained and incoming logs."
                                                       Margin="4,0"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                            <Grid ColumnDefinitions="*,Auto,Auto"
                                                  ColumnSpacing="8">
                                                <Button x:Uid="VisibleFilterCancelButton"
                                                        Grid.Column="1"
                                                        Content="Cancel"
                                                        Style="{StaticResource FilterFlyoutCancelButtonStyle}"
                                                        Click="CancelVisibleLogFilterButton_Click" />
                                                <Button x:Uid="VisibleFilterApplyButton"
                                                        Grid.Column="2"
                                                        Content="Apply"
                                                        Style="{StaticResource FilterFlyoutApplyButtonStyle}"
                                                        IsEnabled="{Binding HasPendingVisibleLogFilterChanges}"
                                                        Click="ApplyVisibleLogFilterButton_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    </ScrollViewer>
                    <Button x:Uid="StaticUi018" x:Name="LogToolbarScrollForwardButton"
                            Grid.Column="3"
                            Style="{StaticResource NavigationIconButtonStyle}"
                            Visibility="Collapsed"
                            Click="ToolbarScrollForwardButton_Click"
                            infra:AppToolTipService.ToolTip="Scroll log controls right">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="12"
                                  UseLayoutRounding="False"
                                  Glyph="&#xE76C;" />
                    </Button>
                        <Button x:Uid="TerminalDirectInputMenuButton"
                                x:Name="TerminalDirectInputMenuButton"
                                Grid.Column="4"
                                Style="{StaticResource NavigationIconButtonStyle}"
                                Visibility="{Binding TerminalDirectInputVisibility}"
                                AutomationProperties.Name="Direct terminal input menu"
                                infra:AppToolTipService.ToolTip="{Binding TerminalDirectInputMenuToolTip}">
                            <FontIcon x:Name="TerminalDirectInputMenuIcon" FontSize="14" Glyph="&#xE756;" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="TerminalDirectInputMenu_Opening" Closed="TerminalDirectInputMenu_Closed">
                                    <RadioMenuFlyoutItem x:Uid="TerminalDirectInputOnMenuItem"
                                                        x:Name="TerminalDirectInputOnMenuItem"
                                                        Text="Direct input ON" GroupName="TerminalDirectInput"
                                                        IsEnabled="{Binding CanEnableTerminalDirectInput}"
                                                        Click="TerminalDirectInputOn_Click" />
                                    <RadioMenuFlyoutItem x:Uid="TerminalDirectInputOffMenuItem"
                                                        x:Name="TerminalDirectInputOffMenuItem"
                                                        Text="Direct input OFF" GroupName="TerminalDirectInput"
                                                        Click="TerminalDirectInputOff_Click" />
                                    <MenuFlyoutSeparator />
                                    <ToggleMenuFlyoutItem x:Uid="TerminalDirectInputLocalEchoMenuItem"
                                                         Text="Local echo"
                                                         IsChecked="{Binding TerminalDirectInputLocalEcho, Mode=TwoWay}"
                                                         infra:AppToolTipService.ToolTip="Show typed text immediately. Editing keys still go to the device and require shell support. Turn this off when the device echoes input." />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Border>

                <Border x:Name="XtermLogSurface"
                        Grid.Row="1"
                        Background="{ThemeResource XtermSurfaceBrush}"
                        CornerRadius="4,4,0,0">
                    <WebView2 x:Name="XtermLogWebView"
                              MinHeight="150"
                              SizeChanged="XtermLogWebView_SizeChanged" />
                </Border>

                <Border x:Name="XtermResizeShield"
                        Grid.Row="1"
                        Height="0"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource XtermSurfaceBrush}"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Canvas.ZIndex="5" />

                <Border x:Name="LogRestoreOverlay"
                        Grid.Row="1"
                        Background="{ThemeResource LogRestoreBackdropBrush}"
                        CornerRadius="3"
                        Visibility="Collapsed"
                        IsHitTestVisible="True">
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{ThemeResource LogRestoreCardBrush}"
                            BorderBrush="{ThemeResource LogRestoreCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,12"
                            MaxWidth="280">
                        <StackPanel Spacing="4"
                                    HorizontalAlignment="Center">
                            <Image Source="ms-appx:///Assets/Loading/log_restore.png"
                                   Width="150"
                                   Height="140"
                                   Stretch="Uniform"
                                   Opacity="0.96" />
                            <TextBlock x:Uid="StaticUi001" x:Name="LogRestoreOverlayTitle"
                                       Text="Restoring log view..."
                                       Foreground="{ThemeResource LogRestorePrimaryTextBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Uid="StaticUi019" x:Name="LogRestoreOverlayDetail"
                                       Text="Preparing log view"
                                       Foreground="{ThemeResource LogRestoreSecondaryTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       MaxWidth="240"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center" />
                            <ProgressBar x:Name="LogRestoreProgressBar"
                                         Width="220"
                                         Minimum="0" Maximum="100"
                                         IsIndeterminate="True" />
                        </StackPanel>
                    </Border>
                </Border>
                <Border x:Name="LogHistoryExportProgressPanel" Grid.Row="1"
                        Canvas.ZIndex="90"
                        Visibility="{Binding LogHistoryExport.Visibility}"
                        Width="380"
                        Margin="12"
                        Padding="16"
                        CornerRadius="8"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock x:Uid="LogHistoryProgressTitle" Text="Exporting logs"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button x:Uid="LogHistoryCancelButton" Grid.Column="1" Content="Cancel"
                                    Command="{Binding LogHistoryExport.CancelCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding LogHistoryExport.DetailText}" TextWrapping="Wrap" />
                        <ProgressBar Minimum="0" Maximum="100"
                                     IsIndeterminate="{Binding LogHistoryExport.IsIndeterminate}"
                                     Value="{Binding LogHistoryExport.Percent}"
                                     AutomationProperties.Name="{Binding LogHistoryExport.DetailText}" />
                        <TextBlock x:Uid="LogHistoryProgressHint"
                                   Text="Reception and the log view continue while saving."
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2"
                  Grid.Column="0"
                  Margin="0,4"
                  RowSpacing="4"
                  RowDefinitions="Auto,Auto">
                <Border Grid.Row="0"
                        Style="{StaticResource CompactSurfaceBorderStyle}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button x:Uid="StaticUi242" x:Name="TxToolbarScrollBackButton"
                            Grid.Column="0"
                            Style="{StaticResource NavigationIconButtonStyle}"
                            Visibility="Collapsed"
                            Click="ToolbarScrollBackButton_Click"
                            infra:AppToolTipService.ToolTip="Scroll TX controls left">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="12"
                                  UseLayoutRounding="False"
                                  Glyph="&#xE76B;" />
                    </Button>
                    <ScrollViewer x:Name="TxToolbarScrollViewer"
                                  Grid.Column="1"
                                  HorizontalScrollMode="Enabled"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  ViewChanged="HorizontalToolbarScrollViewer_ViewChanged"
                                  SizeChanged="HorizontalToolbarScrollViewer_SizeChanged">
                    <Grid Width="{Binding ViewportWidth, ElementName=TxToolbarScrollViewer}"
                          MinWidth="500"
                          ColumnSpacing="4"
                          ColumnDefinitions="Auto,*,Auto,82,Auto,Auto">
                        <TextBlock Text="TX"
                                   Style="{StaticResource CompactSectionTitleTextStyle}" />
                        <TextBox x:Name="CommandTextBox"
                                 Grid.Column="1"
                                 Text="{Binding Commands.CurrentCommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Command"
                                 Style="{StaticResource CompactTextBoxStyle}"
                                 AcceptsReturn="False"
                                 MinWidth="100"
                                 VerticalAlignment="Center"
                                 KeyDown="CommandTextBox_KeyDown" />
                        <TextBlock Grid.Column="2"
                                   Text="Ending"
                                   Style="{StaticResource CompactLabelTextStyle}" />
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding TxLineEndingModes}"
                                  SelectedItem="{Binding SelectedTxLineEnding, Mode=TwoWay}"
                                  IsEnabled="{Binding IsTxLineEndingEffective}"
                                  infra:AppToolTipService.ToolTip="{Binding TxLineEndingToolTip}"
                                  MinWidth="78" />
                        <Button x:Uid="CommandSendButton" Grid.Column="4"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                AutomationProperties.Name="Send command"
                                infra:AppToolTipService.ToolTip="Send command"
                                Command="{Binding SendCommand}">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="14"
                                      Glyph="&#xE724;" />
                        </Button>
                        <Button x:Uid="StaticUi247" Grid.Column="5"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                AutomationProperties.Name="Command history"
                                infra:AppToolTipService.ToolTip="Command history">
                            <Button.Content>
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="14"
                                          Glyph="&#xE81C;" />
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout x:Name="CommandHistoryFlyout"
                                        Opening="CommandHistoryFlyout_Opening"
                                        AreOpenCloseAnimationsEnabled="False"
                                        Placement="TopEdgeAlignedRight">
                                    <StackPanel Spacing="4" Width="340">
                                        <TextBox x:Uid="CommandHistorySearch"
                                                 Style="{StaticResource CompactTextBoxStyle}"
                                                 Text="{Binding Commands.HistorySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Search command history..."
                                                 AutomationProperties.Name="Search command history" />
                                        <Grid Height="120">
                                            <ListView x:Name="CommandHistoryListView"
                                                      ItemsSource="{Binding Commands.FilteredCommandHistory}"
                                                      SelectionMode="Single"
                                                      IsItemClickEnabled="True"
                                                      ItemClick="CommandHistoryListView_ItemClick"
                                                      DoubleTapped="CommandHistoryListView_DoubleTapped"
                                                      KeyDown="CommandHistoryListView_KeyDown"
                                                      Padding="0"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                      Height="120">
                                                <ListView.ItemContainerTransitions>
                                                    <TransitionCollection />
                                                </ListView.ItemContainerTransitions>
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem"
                                                           BasedOn="{StaticResource CompactListViewItemStyle}">
                                                        <Setter Property="Height" Value="24" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="UseSystemFocusVisuals" Value="True" />
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*,58"
                                                              ColumnSpacing="4"
                                                              Margin="0,0,20,0"
                                                              MinHeight="24">
                                                            <TextBlock Text="{Binding CommandText}"
                                                                       FontFamily="Consolas"
                                                                       Style="{StaticResource CompactCellTextStyle}">
                                                                <infra:AppToolTipService.ToolTip>
                                                                    <ToolTip MaxWidth="600">
                                                                        <TextBlock Text="{Binding CommandText}"
                                                                                   TextWrapping="Wrap"
                                                                                   FontFamily="Consolas" />
                                                                    </ToolTip>
                                                                </infra:AppToolTipService.ToolTip>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding LastSentTimeText}"
                                                                       Style="{StaticResource CompactCellTextStyle}"
                                                                       HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <TextBlock x:Uid="CommandHistoryNoResults"
                                                       Visibility="{Binding Commands.HistoryEmptyVisibility}"
                                                       Text="No matching command history."
                                                       Style="{StaticResource CompactCellTextStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    </ScrollViewer>
                    <Button x:Uid="StaticUi252" x:Name="TxToolbarScrollForwardButton"
                            Grid.Column="2"
                            Style="{StaticResource NavigationIconButtonStyle}"
                            Visibility="Collapsed"
                            Click="ToolbarScrollForwardButton_Click"
                            infra:AppToolTipService.ToolTip="Scroll TX controls right">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="12"
                                  UseLayoutRounding="False"
                                  Glyph="&#xE76C;" />
                    </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Padding="3,2"
                        Style="{StaticResource CompactSurfaceBorderStyle}">
                    <Grid ColumnSpacing="4"
                          ColumnDefinitions="Auto,Auto,Auto,*">
                        <TextBlock Text="Quick CMD"
                                   FontWeight="Normal"
                                   Style="{StaticResource CompactSectionTitleTextStyle}" />

                        <Button x:Uid="StaticUi254" Grid.Column="1"
                                Content="+"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                Click="AddSavedCommand_Click"
                                AutomationProperties.Name="Add quick command"
                                infra:AppToolTipService.ToolTip="Add quick command" />

                        <Border Grid.Column="2"
                                Width="1"
                                Margin="2,1"
                                Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                        <Grid Grid.Column="3"
                              ColumnDefinitions="Auto,*,Auto">
                            <Button x:Uid="StaticUi257" x:Name="QuickToolbarScrollBackButton"
                                    Grid.Column="0"
                                    Style="{StaticResource NavigationIconButtonStyle}"
                                    Visibility="Collapsed"
                                    Click="ToolbarScrollBackButton_Click"
                                    infra:AppToolTipService.ToolTip="Scroll quick commands left">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="12"
                                          UseLayoutRounding="False"
                                          Glyph="&#xE76B;" />
                            </Button>
                            <ScrollViewer x:Name="QuickToolbarScrollViewer"
                                          Grid.Column="1"
                                          HorizontalScrollMode="Enabled"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollMode="Disabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          ViewChanged="HorizontalToolbarScrollViewer_ViewChanged"
                                          SizeChanged="HorizontalToolbarScrollViewer_SizeChanged">
                                <StackPanel x:Name="QuickCommandPanel"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            SizeChanged="QuickCommandPanel_SizeChanged">
                                    <ItemsControl ItemsSource="{Binding Commands.SavedCommands}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent"
                                                        ContextRequested="SavedCommand_ContextRequested">
                                                    <Button Content="{Binding Name}"
                                                            Style="{StaticResource SavedCommandChipButtonStyle}"
                                                            Command="{Binding DataContext.SendSavedCommandCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"
                                                            infra:AppToolTipService.ToolTip="{Binding SendToolTip}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <Button x:Uid="StaticUi259" x:Name="QuickToolbarScrollForwardButton"
                                    Grid.Column="2"
                                    Style="{StaticResource NavigationIconButtonStyle}"
                                    Visibility="Collapsed"
                                    Click="ToolbarScrollForwardButton_Click"
                                    infra:AppToolTipService.ToolTip="Scroll quick commands right">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="12"
                                          UseLayoutRounding="False"
                                          Glyph="&#xE76C;" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="InspectorPanel"
                  Grid.Row="3"
                  Grid.Column="0"
                  Background="Transparent"
                  RowSpacing="0"
                  RowDefinitions="*"
                  MinHeight="160">
                <Border Grid.Row="0"
                        Background="{ThemeResource InspectorBackdropBrush}"
                        IsHitTestVisible="False" />
                <TabView x:Name="InspectorTabView"
                         Grid.Row="0"
                         Margin="0"
                         IsAddTabButtonVisible="False"
                         CanDragTabs="False"
                         CanReorderTabs="False"
                         AllowDropTabs="False"
                         TabWidthMode="SizeToContent"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         Loaded="InspectorTabView_Loaded"
                         SelectionChanged="InspectorTabView_SelectionChanged">
                    <TabView.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <StaticResource x:Key="TabViewBackground"
                                                    ResourceKey="SubtleFillColorTransparentBrush" />
                                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected"
                                                    ResourceKey="LayerOnMicaBaseAltFillColorDefaultBrush" />
                                    <StaticResource x:Key="TabViewItemHeaderBackgroundPointerOver"
                                                    ResourceKey="LayerOnMicaBaseAltFillColorSecondaryBrush" />
                                    <StaticResource x:Key="TabViewItemHeaderBackgroundPressed"
                                                    ResourceKey="LayerOnMicaBaseAltFillColorDefaultBrush" />
                                    <SolidColorBrush x:Key="TabViewItemSeparator"
                                                     Color="Transparent" />
                                    <StaticResource x:Key="TabViewSelectedItemBorderBrush"
                                                    ResourceKey="CardStrokeColorDefaultBrush" />
                                    <Thickness x:Key="TabViewSelectedItemBorderThickness">1</Thickness>
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="TabViewBackground"
                                                    ResourceKey="SubtleFillColorTransparentBrush" />
                                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected"
                                                    ResourceKey="LayerOnMicaBaseAltFillColorDefaultBrush" />
                                    <StaticResource x:Key="TabViewItemHeaderBackgroundPointerOver"
                                                    ResourceKey="LayerOnMicaBaseAltFillColorSecondaryBrush" />
                                    <StaticResource x:Key="TabViewItemHeaderBackgroundPressed"
                                                    ResourceKey="LayerOnMicaBaseAltFillColorDefaultBrush" />
                                    <SolidColorBrush x:Key="TabViewItemSeparator"
                                                     Color="Transparent" />
                                    <StaticResource x:Key="TabViewSelectedItemBorderBrush"
                                                    ResourceKey="CardStrokeColorDefaultBrush" />
                                    <Thickness x:Key="TabViewSelectedItemBorderThickness">1</Thickness>
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
                                    <StaticResource x:Key="TabViewBackground"
                                                    ResourceKey="SystemColorButtonFaceColorBrush" />
                                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected"
                                                    ResourceKey="SystemColorWindowColorBrush" />
                                    <StaticResource x:Key="TabViewItemHeaderBackgroundPointerOver"
                                                    ResourceKey="SystemColorHighlightColorBrush" />
                                    <StaticResource x:Key="TabViewItemHeaderBackgroundPressed"
                                                    ResourceKey="SystemColorHighlightColorBrush" />
                                    <StaticResource x:Key="TabViewItemSeparator"
                                                    ResourceKey="SystemColorWindowTextColorBrush" />
                                    <StaticResource x:Key="TabViewSelectedItemBorderBrush"
                                                    ResourceKey="SystemColorHighlightColorBrush" />
                                    <Thickness x:Key="TabViewSelectedItemBorderThickness">1,1,1,0</Thickness>
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                            <Thickness x:Key="TabViewHeaderPadding">0,2,0,2</Thickness>
                        </ResourceDictionary>
                    </TabView.Resources>
                    <TabViewItem x:Uid="StaticUi020" Header="Events"
                                 IsClosable="False"
                                 infra:AppToolTipService.ToolTip="Review log events detected by enabled rules. Double-click an event to jump to its original log.">
                        <Grid Style="{StaticResource InspectorTabGridStyle}"
                              RowDefinitions="Auto,*">
                            <Border Style="{StaticResource InspectorTabHeaderBorderStyle}">
                                <Grid ColumnSpacing="4"
                                      ColumnDefinitions="*,Auto,Auto,Auto">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Events"
                                                   Style="{StaticResource InspectorSectionHeaderTextStyle}" />
                                        <TextBlock Text="{Binding DetectedEventUiCountText}"
                                                   Style="{StaticResource CompactCellTextStyle}" />
                                    </StackPanel>
                                    <CheckBox x:Uid="StaticUi022" Grid.Column="1"
                                              Content="Auto"
                                              IsChecked="{Binding IsEventAutoScrollEnabled, Mode=TwoWay}"
                                              infra:AppToolTipService.ToolTip="Auto-scroll events"
                                              VerticalAlignment="Center" />
                                    <Button x:Uid="StaticUi023" Grid.Column="2"
                                            Content="Latest"
                                            Style="{StaticResource RuleActionButtonStyle}"
                                            infra:AppToolTipService.ToolTip="Select latest event"
                                            Click="SelectLatestEvent_Click" />
                                    <Button x:Uid="EventContextButton" Grid.Column="3" Content="Context"
                                            IsEnabled="{Binding SelectedEventContextAvailable}"
                                            Style="{StaticResource RuleActionButtonStyle}"
                                            Click="ShowEventContext_Click" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Style="{StaticResource InspectorTabBodyBorderStyle}">
                                <ListView x:Name="EventListView"
                                      ItemsSource="{Binding Events.Events}"
                                      SelectedItem="{Binding SelectedEvent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionMode="Single"
                                      IsItemClickEnabled="True"
                                      PointerEntered="EventListView_PointerEntered"
                                      PointerExited="EventListView_PointerExited"
                                      ItemClick="EventListView_ItemClick"
                                      SelectionChanged="EventListView_SelectionChanged"
                                      DoubleTapped="EventListView_DoubleTapped">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem"
                                           BasedOn="{StaticResource CompactListViewItemStyle}" />
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="4"
                                              MinHeight="24"
                                              ColumnDefinitions="76,58,28,*">
                                            <TextBlock Text="{Binding TimeText}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource CompactCellTextStyle}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding RuleName}"
                                                       Style="{StaticResource CompactCellTextStyle}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding CompactDirectionText}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource CompactCellTextStyle}" />
                                            <ItemsControl Grid.Column="3"
                                                          ItemsSource="{Binding MessageSegments}"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False"
                                                          infra:AppToolTipService.ToolTip="{Binding MessagePreview}"
                                                          AutomationProperties.Name="{Binding MessagePreview}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding Converter={StaticResource EventTextSegmentBrushConverter}, ConverterParameter=Background}"
                                                                CornerRadius="1">
                                                            <TextBlock Text="{Binding Text}"
                                                                       Foreground="{Binding Converter={StaticResource EventTextSegmentBrushConverter}, ConverterParameter=Foreground}"
                                                                       FontFamily="Consolas"
                                                                       Style="{StaticResource CompactCellTextStyle}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </TabViewItem>

                    <TabViewItem Header="{Binding Protocol.TabTitle}" IsClosable="False">
                        <views:ProtocolView DataContext="{Binding Protocol}" />
                    </TabViewItem>
                    <TabViewItem x:Uid="StaticUi027" Header="Search"
                                 IsClosable="False"
                                 infra:AppToolTipService.ToolTip="Review matches from the retained in-memory log. Double-click a result or press Enter to jump to it.">
                        <Grid Style="{StaticResource InspectorTabGridStyle}"
                              MinWidth="0"
                              RowDefinitions="Auto,*">
                            <Border Style="{StaticResource InspectorTabHeaderBorderStyle}">
                                <Grid ColumnSpacing="4"
                                      MinWidth="0"
                                      ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
                                      RowDefinitions="Auto">
                                    <TextBlock Text="Search"
                                               Style="{StaticResource InspectorSectionHeaderTextStyle}"
                                               Margin="0,0,4,0" />
                                    <Button x:Uid="StaticUi029" Grid.Column="1"
                                            Content="Refresh"
                                            Style="{StaticResource RuleActionButtonStyle}"
                                            Command="{Binding RefreshSearchResultsCommand}"
                                            infra:AppToolTipService.ToolTip="Refresh search results" />
                                    <Button x:Uid="StaticUi030" Grid.Column="2"
                                            Content="Prev"
                                            Style="{StaticResource RuleActionButtonStyle}"
                                            Command="{Binding PreviousSearchResultsPageCommand}"
                                            infra:AppToolTipService.ToolTip="Show the previous 1,000 matching lines (older)" />
                                    <Button x:Uid="StaticUi031" Grid.Column="3"
                                            Content="Next"
                                            Style="{StaticResource RuleActionButtonStyle}"
                                            Command="{Binding NextSearchResultsPageCommand}"
                                            infra:AppToolTipService.ToolTip="Show the next 1,000 matching lines (newer). On the newest page, refresh and stay at the latest results." />
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding SearchSummaryText}"
                                               Style="{StaticResource CompactCellTextStyle}" />
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding SearchResultStatusText}"
                                               Style="{StaticResource CompactCellTextStyle}"
                                               MinWidth="0"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Style="{StaticResource InspectorTabBodyBorderStyle}">
                                <ListView x:Name="SearchResultsListView"
                                      MinWidth="0"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      ItemsSource="{Binding SearchResults}"
                                      SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionMode="Single"
                                      DoubleTapped="SearchResultsListView_DoubleTapped"
                                      KeyDown="SearchResultsListView_KeyDown"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.IsHorizontalRailEnabled="False"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem"
                                           BasedOn="{StaticResource CompactListViewItemStyle}" />
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="4"
                                              MinHeight="24"
                                              HorizontalAlignment="Stretch"
                                              ColumnDefinitions="76,42,*">
                                            <TextBlock Text="{Binding TimeText}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource CompactCellTextStyle}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DirectionText}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource CompactCellTextStyle}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding MessagePreview}"
                                                       infra:SearchTextHighlightBehavior.Segments="{Binding MessageSegments}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource CompactCellTextStyle}"
                                                       infra:AppToolTipService.ToolTip="{Binding MessagePreview}"
                                                       AutomationProperties.Name="{Binding MessagePreview}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </TabViewItem>

                    <TabViewItem x:Uid="StaticUi032" Header="Sequences"
                                 IsClosable="False"
                                 infra:AppToolTipService.ToolTip="Create and run ordered command sequences with per-step delays.">
                        <Grid Style="{StaticResource InspectorTabGridStyle}"
                              MinHeight="0"
                              VerticalAlignment="Stretch"
                              RowDefinitions="Auto,Auto,*">
                            <Border Grid.Row="0"
                                    Style="{StaticResource InspectorTabHeaderBorderStyle}">
                                <Grid ColumnSpacing="4"
                                      ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">
                                    <TextBlock Text="Sequence"
                                               Style="{StaticResource InspectorSectionHeaderTextStyle}" />
                                    <ComboBox Grid.Column="1"
                                              MinWidth="118"
                                              MaxWidth="170"
                                              ItemsSource="{Binding CommandSequences}"
                                              SelectedItem="{Binding SelectedCommandSequence, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource CompactComboBoxStyle}"
                                              infra:AppToolTipService.ToolTip="{Binding SequenceStatusText}" />
                                    <TextBox x:Uid="StaticUi034" x:Name="SequenceRepeatCountTextBox"
                                             Grid.Column="4"
                                             Width="48"
                                             MaxLength="4"
                                             InputScope="Number"
                                             Text="{Binding SelectedCommandSequence.RepeatCount, Mode=OneWay}"
                                             Style="{StaticResource CompactTextBoxStyle}"
                                             IsEnabled="{Binding CanEditSelectedCommandSequence}"
                                             BeforeTextChanging="SequenceRepeatCountTextBox_BeforeTextChanging"
                                             TextChanged="SequenceRepeatCountTextBox_TextChanged"
                                             LostFocus="SequenceRepeatCountTextBox_LostFocus"
                                             infra:AppToolTipService.ToolTip="Repeat the selected sequence 1 to 9,999 times" />
                                    <TextBlock Grid.Column="5"
                                               Text="times"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CompactCellTextStyle}" />
                                    <Button x:Uid="SequenceManage" Grid.Column="2" Content="Sequence options"
                                            Style="{StaticResource RuleActionButtonStyle}">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem x:Uid="SequenceAddMenu" Text="Add sequence…"
                                                                Click="AddCommandSequence_Click"
                                                                IsEnabled="{Binding CanEditCommandSequences}">
                                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Add" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="SequenceLoad" Text="Load JSON files…"
                                                                Click="LoadCommandSequences_Click"
                                                                IsEnabled="{Binding CanEditCommandSequences}"
                                                                infra:AppToolTipService.ToolTip="Load one or more sequence JSON files (all must be valid)">
                                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="OpenFile" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Uid="SequenceExport" Text="Export selected sequence…"
                                                                Click="ExportCommandSequence_Click"
                                                                IsEnabled="{Binding CanEditSelectedCommandSequence}"
                                                                infra:AppToolTipService.ToolTip="Export selected sequence with an embedded authoring manual">
                                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Save" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="SequenceEditMenu" Text="Edit selected sequence…"
                                                                IsEnabled="{Binding CanEditSelectedCommandSequence}"
                                                                Click="EditCommandSequence_Click">
                                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Edit" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="SequenceDuplicateMenu" Text="Duplicate selected sequence"
                                                                IsEnabled="{Binding CanEditSelectedCommandSequence}"
                                                                Click="DuplicateCommandSequence_Click">
                                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Copy" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Uid="SequenceDeleteMenu" Text="Delete selected sequence…"
                                                                IsEnabled="{Binding CanEditSelectedCommandSequence}"
                                                                Click="DeleteCommandSequence_Click">
                                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Uid="SequenceAiGuideMenu" Text="Create sequences with AI…"
                                                                Click="ShowSequenceAiGuide_Click">
                                                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Help" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Grid.Column="6"
                                            Command="{Binding ToggleCommandSequenceCommand}"
                                            Style="{StaticResource ToolbarIconButtonStyle}"
                                            AutomationProperties.Name="{Binding SequenceRunButtonToolTip}"
                                            infra:AppToolTipService.ToolTip="{Binding SequenceRunButtonToolTip}">
                                        <FontIcon Glyph="{Binding SequenceRunButtonGlyph}" FontSize="14" />
                                    </Button>
                                    <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4">
                                    <Button x:Uid="SequenceStop"
                                            Command="{Binding StopCommandSequenceCommand}"
                                            Style="{StaticResource ToolbarIconButtonStyle}"
                                            AutomationProperties.Name="Stop running sequence"
                                            infra:AppToolTipService.ToolTip="Stop the running sequence, regardless of dropdown selection">
                                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                    </Button>
                                    <Button Content="실행 결과" Style="{StaticResource RuleActionButtonStyle}"
                                            AutomationProperties.Name="시퀀스 실행 결과 열기" Click="OpenSequenceResults_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Style="{StaticResource InspectorTabHeaderBorderStyle}">
                                <Grid ColumnSpacing="4"
                                      ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock MinWidth="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource CompactCellTextStyle}">
                                        <Run x:Name="SequenceStateText" Text="{Binding SequenceRuntimeStateText}"
                                             FontWeight="SemiBold" Foreground="{ThemeResource FileLoggingDisabledTextBrush}" />
                                        <Run Text=" | " />
                                        <Run Text="{Binding SequenceTxActivityText}" />
                                        <infra:AppToolTipService.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{Binding SequenceTxActivityToolTip}"
                                                           MaxWidth="520" TextWrapping="Wrap" />
                                            </ToolTip>
                                        </infra:AppToolTipService.ToolTip>
                                    </TextBlock>
                                    <TextBlock x:Uid="StaticUi041" Grid.Column="2"
                                               Text="{Binding SelectedCommandSequenceStepCountText}"
                                               FontFamily="Consolas"
                                               Style="{StaticResource CompactCellTextStyle}"
                                               infra:AppToolTipService.ToolTip="Selected sequence step count" />
                                    <Button x:Uid="SequenceAddStep" Grid.Column="3"
                                            Content="+ Step"
                                            IsEnabled="{Binding CanEditSelectedCommandSequence}"
                                            Style="{StaticResource RuleActionButtonStyle}"
                                            infra:AppToolTipService.ToolTip="Add TX or RX Check step">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="TX" Click="AddCommandSequenceStep_Click" />
                                                <MenuFlyoutItem Text="RX Check" Click="AddCommandSequenceRxStep_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button x:Uid="SequenceDuplicateStep" Grid.Column="4"
                                            Content="Copy step"
                                            IsEnabled="{Binding CanEditSelectedCommandSequenceStep}"
                                            Style="{StaticResource RuleActionButtonStyle}"
                                            Click="DuplicateCommandSequenceStep_Click"
                                            AutomationProperties.Name="Duplicate selected sequence step"
                                            infra:AppToolTipService.ToolTip="Duplicate the selected step directly below it" />
                                    <Button x:Uid="StaticUi045" Grid.Column="6"
                                            IsEnabled="{Binding CanEditSelectedCommandSequenceStep}"
                                            Style="{StaticResource RuleActionButtonStyle}"
                                            Click="MoveCommandSequenceStepUp_Click"
                                            AutomationProperties.Name="Move step up"
                                            infra:AppToolTipService.ToolTip="Move step up">
                                        <FontIcon Glyph="&#xE74A;" FontSize="12" />
                                    </Button>
                                    <Button x:Uid="StaticUi046" Grid.Column="7"
                                            IsEnabled="{Binding CanEditSelectedCommandSequenceStep}"
                                            Style="{StaticResource RuleActionButtonStyle}"
                                            Click="MoveCommandSequenceStepDown_Click"
                                            AutomationProperties.Name="Move step down"
                                            infra:AppToolTipService.ToolTip="Move step down">
                                        <FontIcon Glyph="&#xE74B;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    MinHeight="0"
                                    Style="{StaticResource InspectorTabBodyBorderStyle}">
                                <Grid RowSpacing="2"
                                      MinHeight="0"
                                      RowDefinitions="Auto,*">
                                    <Grid ColumnSpacing="4"
                                          MinHeight="20"
                                          ColumnDefinitions="28,20,58,*,44,40,60,54">
                                        <TextBlock x:Uid="SequenceEnabledHeader" Text="On"
                                                   Style="{StaticResource InspectorTableHeaderTextStyle}"
                                                   infra:AppToolTipService.ToolTip="Unchecked steps are skipped during execution" />
                                        <TextBlock Grid.Column="1" Text="#"
                                                   Style="{StaticResource InspectorTableHeaderTextStyle}" />
                                        <TextBlock Grid.Column="2" Text="유형" Style="{StaticResource InspectorTableHeaderTextStyle}" />
                                        <TextBlock x:Uid="SequenceCommandHeader" Grid.Column="3"
                                                   Text="Command"
                                                   Style="{StaticResource InspectorTableHeaderTextStyle}" />
                                        <TextBlock x:Uid="SequenceModeHeader" Grid.Column="4"
                                                   Text="Mode"
                                                   Style="{StaticResource InspectorTableHeaderTextStyle}" />
                                        <TextBlock x:Uid="StaticUi048" Grid.Column="5"
                                                   Text="Ending"
                                                   Style="{StaticResource InspectorTableHeaderTextStyle}"
                                                   infra:AppToolTipService.ToolTip="Global = use main TX ending; None = no ending; CR = \r; LF = \n; CRLF = \r\n" />
                                        <TextBlock Grid.Column="6"
                                                   Text="ms"
                                                   HorizontalAlignment="Right"
                                                   Style="{StaticResource InspectorTableHeaderTextStyle}" />
                                        <TextBlock Grid.Column="7"
                                                   Text="Actions"
                                                   Style="{StaticResource InspectorTableHeaderTextStyle}" />
                                    </Grid>

                                    <ListView x:Name="CommandSequenceStepListView"
                                              Grid.Row="1"
                                              MinHeight="0"
                                              ItemsSource="{Binding SelectedCommandSequence.Steps}"
                                              SelectedItem="{Binding SelectedCommandSequenceStep, Mode=TwoWay}"
                                              IsEnabled="{Binding CanEditCommandSequences}"
                                              SelectionMode="Single"
                                              AllowDrop="{Binding CanEditSelectedCommandSequence}"
                                              CanDragItems="{Binding CanEditSelectedCommandSequence}"
                                              CanReorderItems="{Binding CanEditSelectedCommandSequence}"
                                              DragItemsStarting="CommandSequenceStepListView_DragItemsStarting"
                                              DragItemsCompleted="CommandSequenceStepListView_DragItemsCompleted"
                                              DoubleTapped="CommandSequenceStepListView_DoubleTapped"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollMode="Enabled"
                                              ScrollViewer.IsVerticalRailEnabled="True">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem"
                                                   BasedOn="{StaticResource CompactListViewItemStyle}" />
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="4"
                                                      MinHeight="24"
                                                      ColumnDefinitions="28,20,58,*,44,40,60,54">
                                                    <infra:AppToolTipService.ToolTip>
                                                        <ToolTip>
                                                            <TextBlock Text="{Binding RowToolTip}"
                                                                       MaxWidth="520" TextWrapping="Wrap" />
                                                        </ToolTip>
                                                    </infra:AppToolTipService.ToolTip>
                                                    <CheckBox x:Uid="SequenceStepEnabled"
                                                              MinWidth="0" MinHeight="24" Padding="0"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              Click="CommandSequenceStepEnabled_Click"
                                                              AutomationProperties.Name="Enable this sequence step"
                                                              infra:AppToolTipService.ToolTip="Unchecked steps are kept here but skipped during execution" />
                                                    <TextBlock Grid.Column="1" Text="{Binding StepNumberText}"
                                                               FontFamily="Consolas"
                                                               Style="{StaticResource CompactCellTextStyle}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding KindText}" FontSize="11" FontWeight="SemiBold"
                                                               Style="{StaticResource CompactCellTextStyle}" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding CommandText}"
                                                               FontFamily="Consolas"
                                                               TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis"
                                                               Style="{StaticResource CompactCellTextStyle}" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding ModeText}"
                                                               Style="{StaticResource CompactCellTextStyle}" />
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding LineEndingText}"
                                                               Style="{StaticResource CompactCellTextStyle}"
                                                               infra:AppToolTipService.ToolTip="{Binding LineEndingHelpText}" />
                                                    <TextBlock Grid.Column="6"
                                                               Text="{Binding DelayText}"
                                                               HorizontalAlignment="Right"
                                                               Style="{StaticResource CompactCellTextStyle}" />
                                                    <StackPanel Grid.Column="7"
                                                                Orientation="Horizontal"
                                                                Spacing="2"
                                                                VerticalAlignment="Center">
                                                        <Button x:Uid="StaticUi051"
                                                                AutomationProperties.Name="Edit this command"
                                                                Style="{StaticResource RuleActionButtonStyle}"
                                                                Click="EditCommandSequenceStepRow_Click"
                                                                infra:AppToolTipService.ToolTip="Edit step">
                                                            <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                                        </Button>
                                                        <Button x:Uid="StaticUi052"
                                                                AutomationProperties.Name="Delete this command"
                                                                Style="{StaticResource RuleActionButtonStyle}"
                                                                Click="DeleteCommandSequenceStepRow_Click"
                                                                infra:AppToolTipService.ToolTip="Delete step">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabViewItem>

                    <TabViewItem x:Uid="StaticUi053" x:Name="RulesTabViewItem"
                                 Header="Rules"
                                 IsClosable="False"
                                 infra:AppToolTipService.ToolTip="Create matching rules for events, highlights, filters, and optional notifications.">
