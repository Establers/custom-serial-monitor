                                                                                    </VisualState.Setters>
                                                                                </VisualState>
                                                                                <VisualState x:Name="Disabled">
                                                                                    <VisualState.Setters>
                                                                                        <Setter Target="PresetContent.Opacity" Value="0.4" />
