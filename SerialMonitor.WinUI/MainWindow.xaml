                                              VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollMode="Enabled"
                                              VerticalScrollMode="Disabled"
                                              IsHorizontalRailEnabled="True"
                                              MinHeight="0"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch"
                                              VerticalAlignment="Stretch">
                                    <Grid MinWidth="806"
                                          RowDefinitions="Auto,*"
                                          MinHeight="0">
                                        <Border Grid.Row="0"
                                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="2,0,0,1"
                                                MinHeight="22">
                                            <Grid ColumnSpacing="2"
                                                  MinWidth="786"
                                                  MinHeight="22"
                                                  ColumnDefinitions="28,44,58,42,90,130,48,64,42,78,78,76">
                                                <TextBlock Text="En"
                                                           Style="{StaticResource RuleHeaderTextStyle}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="Event"
                                                           Style="{StaticResource RuleHeaderTextStyle}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="Highlight"
                                                           Style="{StaticResource RuleHeaderTextStyle}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="3"
                                                           Text="Filter"
                                                           Style="{StaticResource RuleHeaderTextStyle}" />
                                                <TextBlock Grid.Column="4"
                                                           Text="Name"
                                                           Style="{StaticResource RuleHeaderTextStyle}" />
                                                <TextBlock Grid.Column="5"
                                                           Text="Keyword"
                                                           Style="{StaticResource RuleHeaderTextStyle}" />
                                                <TextBlock Grid.Column="6"
                                                           Text="Mode"
                                                           Style="{StaticResource RuleHeaderTextStyle}" />
                                                <TextBlock Grid.Column="7"
                                                           Text="Direction"
                                                           Style="{StaticResource RuleHeaderTextStyle}" />
                                                <TextBlock Grid.Column="8"
                                                           Text="Case"
                                                           Style="{StaticResource RuleHeaderTextStyle}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="9"
                                                           Text="Color"
                                                           Style="{StaticResource RuleHeaderTextStyle}" />
                                                <TextBlock Grid.Column="10"
                                                           Text="Background"
                                                           Style="{StaticResource RuleHeaderTextStyle}" />
                                                <TextBlock Grid.Column="11"
                                                           Text="Actions"
                                                           Style="{StaticResource RuleHeaderTextStyle}" />
                                            </Grid>
                                        </Border>

                                        <ListView x:Name="LogRuleListView"
                                                  Grid.Row="1"
                                                  ItemsSource="{Binding LogRules}"
                                                  SelectedItem="{Binding SelectedLogRule, Mode=TwoWay}"
                                                  SelectionMode="Single"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollMode="Enabled"
                                                  IsDoubleTapEnabled="True"
                                                  DoubleTapped="LogRuleListView_DoubleTapped"
                                                  MinHeight="0">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem"
                                                       BasedOn="{StaticResource CompactListViewItemStyle}">
                                                    <Setter Property="Padding"
                                                            Value="2,0" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnSpacing="2"
                                                          HorizontalAlignment="Stretch"
                                                          MinWidth="786"
                                                          MinHeight="22"
                                                          ColumnDefinitions="28,44,58,42,90,130,48,64,42,78,78,76">
                                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                  Style="{StaticResource RuleCheckBoxStyle}"
                                                                  Tag="Enabled"
                                                                  Click="LogRuleInlineClicked" />
                                                        <CheckBox x:Uid="StaticUi068" Grid.Column="1"
                                                                  IsChecked="{Binding UseForEvent, Mode=TwoWay}"
                                                                  Style="{StaticResource RuleCheckBoxStyle}"
                                                                  Tag="Event"
                                                                  Click="LogRuleInlineClicked"
                                                                  infra:AppToolTipService.ToolTip="Event: add matching lines to Events" />
                                                        <CheckBox x:Uid="StaticUi069" Grid.Column="2"
                                                                  IsChecked="{Binding UseForHighlight, Mode=TwoWay}"
                                                                  Style="{StaticResource RuleCheckBoxStyle}"
                                                                  Tag="Highlight"
                                                                  Click="LogRuleInlineClicked"
                                                                  infra:AppToolTipService.ToolTip="Highlight: color matching lines in the log view" />
                                                        <CheckBox x:Uid="StaticUi070" Grid.Column="3"
                                                                  IsChecked="{Binding UseAsViewFilter, Mode=TwoWay}"
                                                                  Style="{StaticResource RuleCheckBoxStyle}"
                                                                  Tag="Filter"
                                                                  Click="LogRuleInlineClicked"
                                                                  infra:AppToolTipService.ToolTip="Filter: make this rule available in the Filter dropdown" />
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding Name}"
                                                                   Style="{StaticResource RuleCellTextStyle}" />
                                                        <TextBlock Grid.Column="5"
                                                                   Text="{Binding Keyword}"
                                                                   FontFamily="Consolas"
                                                                   Style="{StaticResource RuleCellTextStyle}" />
                                                        <TextBlock x:Uid="StaticUi071" Grid.Column="6"
                                                                   Text="{Binding Mode, Converter={StaticResource DisplayModeNameConverter}}"
                                                                   Style="{StaticResource RuleCellTextStyle}"
                                                                   infra:AppToolTipService.ToolTip="The rule is active only while the app is in the same Terminal/HEX mode. Terminal rules match decoded text; HEX rules match raw bytes." />
                                                        <TextBlock Grid.Column="7"
                                                                   Text="{Binding MatchDirection}"
                                                                   Style="{StaticResource RuleCellTextStyle}" />
                                                        <CheckBox x:Uid="StaticUi072" Grid.Column="8"
                                                                  IsChecked="{Binding CaseSensitive, Mode=TwoWay}"
                                                                  Style="{StaticResource RuleCheckBoxStyle}"
                                                                  Tag="Case"
                                                                  Click="LogRuleInlineClicked"
                                                                  infra:AppToolTipService.ToolTip="Case-sensitive Terminal matching. Ignored for HEX rules." />
                                                        <Button x:Uid="StaticUi073" Grid.Column="9"
                                                                Width="56"
                                                                Height="22"
                                                                MinHeight="22"
                                                                Padding="3,0"
                                                                HorizontalAlignment="Left"
                                                                Click="LogRuleColorButton_Click"
                                                                infra:AppToolTipService.ToolTip="Color used when Highlight is enabled.">
                                                            <Grid ColumnSpacing="3"
                                                                  VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="10" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="10"
                                                                        Height="10"
                                                                        CornerRadius="2"
                                                                        BorderThickness="1"
                                                                        BorderBrush="{ThemeResource ColorPreviewBorderBrush}"
                                                                        Background="{Binding ForegroundColor, Converter={StaticResource HighlightColorBrushConverter}}"
                                                                        VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding ForegroundColor}"
                                                                           FontSize="10"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Button>
                                                        <Button Grid.Column="10"
                                                                Width="72" Height="22" MinHeight="22" Padding="3,0"
                                                                HorizontalAlignment="Left"
                                                                Tag="Background"
                                                                Click="LogRuleColorButton_Click"
                                                                infra:AppToolTipService.ToolTip="Change the highlight background color. Choose (none) to remove it.">
                                                            <Grid ColumnSpacing="3" VerticalAlignment="Center" ColumnDefinitions="10,*">
                                                                <Border Width="10" Height="10" CornerRadius="2"
                                                                        BorderThickness="1"
                                                                        BorderBrush="{ThemeResource ColorPreviewBorderBrush}"
                                                                        Background="{Binding BackgroundColor, Converter={StaticResource HighlightColorBrushConverter}}"
                                                                        VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding BackgroundColor, TargetNullValue='(none)'}"
                                                                           FontSize="10" TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Button>
                                                        <StackPanel Grid.Column="11"
                                                                    Orientation="Horizontal"
                                                                    Spacing="2"
                                                                    VerticalAlignment="Center">
                                                            <Button x:Uid="StaticUi074" Content="Edit"
                                                                    Style="{StaticResource RuleActionButtonStyle}"
                                                                    Click="EditLogRuleRow_Click"
                                                                    infra:AppToolTipService.ToolTip="Edit log rule" />
                                                            <Button x:Uid="StaticUi075" Content="Del"
                                                                    Style="{StaticResource RuleActionButtonStyle}"
                                                                    Click="DeleteLogRuleRow_Click"
                                                                    infra:AppToolTipService.ToolTip="Delete log rule" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabViewItem>

                    <TabViewItem x:Uid="StaticUi076"
                                 Header="Bridge"
                                 IsClosable="False"
                                 infra:AppToolTipService.ToolTip="Forward raw bytes bidirectionally between the connected device and a virtual COM port.">
                        <ScrollViewer x:Name="BridgeFormScrollViewer"
                                      Padding="0"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="4"
                                        MinWidth="440"
                                        Width="{Binding ViewportWidth, ElementName=BridgeFormScrollViewer}"
                                        Padding="6">
                                <Border Background="{ThemeResource InspectorHeaderBrush}" CornerRadius="4" Padding="8,4">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="Serial bridge"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="NoWrap"
                                                   x:Uid="FormBridgeTitle" />
                                        <TextBlock Text="Raw bytes · Device ↔ paired virtual COM port"
                                                   Style="{StaticResource FormHintTextStyle}"
                                                   x:Uid="FormBridgeDescription"
                                                   Grid.Column="1"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"
                                                   infra:AppToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding BridgeStateText}"
                                                   Foreground="{ThemeResource WarningTextBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource FormApplyBadgeTextStyle}"
                                                   FontSize="11" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource FormCardBorderStyle}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Connection" Style="{StaticResource FormCardTitleTextStyle}" />
                                        <TextBlock Text="{Binding BridgeStatusText}"
                                                   TextWrapping="Wrap"
                                                   infra:AppToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                   Style="{StaticResource FormValueTextStyle}" />
                                        <Grid ColumnDefinitions="96,220,Auto"
                                              RowDefinitions="Auto,Auto"
                                              ColumnSpacing="6"
                                              RowSpacing="4"
                                              HorizontalAlignment="Left">
                                            <TextBlock x:Uid="StaticUi079"
                                                       Text="Port"
                                                       Grid.Column="0"
                                                       Style="{StaticResource FormLabelTextStyle}"
                                                       infra:AppToolTipService.ToolTip="Virtual app-side COM port opened by Serial Monitor" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding BridgePortNames}"
                                                      SelectedItem="{Binding SelectedBridgePort, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanEditBridgePort}"
                                                      Style="{StaticResource FormComboBoxStyle}" />
                                            <Button x:Uid="StaticUi080"
                                                    Grid.Column="2"
                                                    Content="Refresh"
                                                    Command="{Binding RefreshBridgePortsCommand}"
                                                    Style="{StaticResource FormActionButtonStyle}"
                                                    HorizontalAlignment="Left"
                                                    infra:AppToolTipService.ToolTip="Refresh available virtual COM port candidates." />
                                            <StackPanel Grid.Row="1"
                                                        Grid.Column="1"
                                                        Grid.ColumnSpan="2"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                                <Button Content="Start bridge"
                                                        Command="{Binding StartBridgeCommand}"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        MinHeight="24"
                                                        FontSize="12"
                                                        Height="24"
                                                        Padding="8,0" />
                                                <Button Content="Stop bridge"
                                                        Command="{Binding StopBridgeCommand}"
                                                        Style="{StaticResource FormActionButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Uid="StaticUi083"
                                                   Text="Select the port opened by Serial Monitor. The external controller/analyzer must open the opposite port in the com0com pair."
                                                   TextWrapping="Wrap"
                                                   infra:AppToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                   Opacity="0.82"
                                                   Style="{StaticResource FormValueTextStyle}" />
                                        <TextBlock Text="{Binding ManualTxStateText}"
                                                   Foreground="{ThemeResource WarningTextBrush}"
                                                   TextWrapping="Wrap"
                                                   infra:AppToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                   Style="{StaticResource FormValueTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource FormCardBorderStyle}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Transfer" Style="{StaticResource FormCardTitleTextStyle}" />
                                        <Grid ColumnDefinitions="140,*,*"
                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                              ColumnSpacing="6"
                                              RowSpacing="4">
                                            <TextBlock Text="Direction" Style="{StaticResource InspectorTableHeaderTextStyle}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="Bytes"
                                                       Style="{StaticResource InspectorTableHeaderTextStyle}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2"
                                                       Text="Chunks"
                                                       Style="{StaticResource InspectorTableHeaderTextStyle}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="1"
                                                       Text="Device → Virtual"
                                                       Style="{StaticResource CompactCellTextStyle}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Text="{Binding BridgeDeviceToVirtualByteCount}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource CompactCellTextStyle}"
                                                       HorizontalAlignment="Right"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="2"
                                                       Text="{Binding BridgeDeviceToVirtualChunkCount}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource CompactCellTextStyle}"
                                                       HorizontalAlignment="Right"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="2"
                                                       Text="Virtual → Device"
                                                       Style="{StaticResource CompactCellTextStyle}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="1"
                                                       Text="{Binding BridgeVirtualToDeviceByteCount}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource CompactCellTextStyle}"
                                                       HorizontalAlignment="Right"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="2"
                                                       Text="{Binding BridgeVirtualToDeviceChunkCount}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource CompactCellTextStyle}"
                                                       HorizontalAlignment="Right"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="3"
                                                       Text="Pending / Drops"
                                                       Style="{StaticResource CompactCellTextStyle}" />
                                            <TextBlock Grid.Row="3"
                                                       Grid.Column="1"
                                                       Text="{Binding BridgePendingText}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource CompactCellTextStyle}"
                                                       HorizontalAlignment="Right"
                                                       FontSize="12" />
                                            <TextBlock Grid.Row="3"
                                                       Grid.Column="2"
                                                       Text="{Binding BridgeDroppedChunksText}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource CompactCellTextStyle}"
                                                       HorizontalAlignment="Right"
                                                       FontSize="12" />
                                            <TextBlock Grid.Row="4"
                                                       Text="Dropped bytes / Errors"
                                                       Style="{StaticResource CompactCellTextStyle}" />
                                            <TextBlock Grid.Row="4"
                                                       Grid.Column="1"
                                                       Text="{Binding BridgeDroppedBytesText}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource CompactCellTextStyle}"
                                                       HorizontalAlignment="Right"
                                                       FontSize="12" />
                                            <TextBlock Grid.Row="4"
                                                       Grid.Column="2"
                                                       Text="{Binding BridgeErrorsText}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource CompactCellTextStyle}"
                                                       HorizontalAlignment="Right"
                                                       FontSize="12" />
                                        </Grid>
                                        <TextBlock Text="{Binding BridgeLastError}"
                                                   Foreground="{ThemeResource ErrorTextBrush}"
                                                   TextWrapping="Wrap"
                                                   infra:AppToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                   Style="{StaticResource CompactCellTextStyle}" />
                                        <TextBlock x:Uid="StaticUi092"
                                                   Text="{Binding BridgeVisualLogStatusText}"
                                                   infra:AppToolTipService.ToolTip="UI-only drops do not affect device ↔ virtual COM transport."
                                                   Style="{StaticResource CompactCellTextStyle}" />
                                        <TextBlock x:Uid="StaticUi093"
                                                   Text="{Binding BridgePriorityPipelineStatusText}"
                                                   TextWrapping="Wrap"
                                                   infra:AppToolTipService.ToolTip="Enabled only while the bridge is active. Parser/log overload cannot stall raw bridge forwarding."
                                                   Style="{StaticResource CompactCellTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Expander Header="How the bridge works"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          FontSize="12"
                                          x:Uid="FormBridgeDetails">
                                    <TextBlock x:Uid="StaticUi094"
                                               Text="Raw bytes are forwarded unchanged in both directions. Virtual-to-device logs are received from the virtual port and shown as RX in the current app mode: Terminal uses the selected encoding and Terminal RX rules; HEX shows bytes and uses HEX RX rules. Logging, filters, highlighting, and line-ending settings never modify bridge packets."
                                               TextWrapping="Wrap"
                                               infra:AppToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               Style="{StaticResource FormHintTextStyle}" />
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <TabViewItem x:Uid="StaticUi095"
                                 x:Name="LogTabViewItem"
                                 Header="Log"
                                 IsClosable="False"
                                 infra:AppToolTipService.ToolTip="Configure file logging, log paths, file names, and rotation.">
                        <ScrollViewer x:Name="LogFormScrollViewer"
                                      Padding="0"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="4"
                                        MinWidth="440"
                                        Width="{Binding ViewportWidth, ElementName=LogFormScrollViewer}"
                                        Padding="6">
                                <Border Style="{StaticResource FormCardBorderStyle}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Capture"
                                                   Style="{StaticResource FormCardTitleTextStyle}"
                                                   x:Uid="FormLogCapture" />
                                        <Grid ColumnDefinitions="96,*,58" ColumnSpacing="6">
                                            <TextBlock Text="Log save" Style="{StaticResource FormLabelTextStyle}" />
                                            <Button Grid.Column="1"
                                                    Command="{Binding ToggleFileLoggingCommand}"
                                                    AutomationProperties.Name="{Binding FileLoggingToggleText}"
                                                    Style="{StaticResource FormActionButtonStyle}"
                                                    HorizontalAlignment="Left"
                                                    infra:AppToolTipService.ToolTip="{Binding FileLoggingToolTip}">
                                                <TextBlock x:Name="FileLoggingSettingsToggleTextBlock"
                                                           Text="{Binding FileLoggingToggleText}" />
                                            </Button>
                                            <TextBlock x:Uid="StaticUi104"
                                                       Grid.Column="2"
                                                       Text="Now"
                                                       Style="{StaticResource FormApplyBadgeTextStyle}"
                                                       infra:AppToolTipService.ToolTip="Applies immediately. OFF keeps the terminal and event detection live without saving serial logs." />
                                        </Grid>
                                        <Grid ColumnDefinitions="96,*,58" ColumnSpacing="6">
                                            <TextBlock Text="View pause" Style="{StaticResource FormLabelTextStyle}" />
                                            <CheckBox x:Uid="StaticUi106"
                                                      Grid.Column="1"
                                                      Content="Keep saving file log"
                                                      IsChecked="{Binding FileLoggingWhileViewPaused, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      infra:AppToolTipService.ToolTip="When checked, Pause View freezes only the screen. When cleared, records received during the pause are also omitted from the serial log file."
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch"
                                                      ContentTemplate="{StaticResource FormCheckBoxContentTemplate}"
                                                      Style="{StaticResource FormCheckBoxStyle}" />
                                            <TextBlock x:Uid="StaticUi107"
                                                       Grid.Column="2"
                                                       Text="Now"
                                                       Style="{StaticResource FormApplyBadgeTextStyle}"
                                                       infra:AppToolTipService.ToolTip="Applies immediately, including during an active view pause." />
                                        </Grid>
                                        <Grid ColumnDefinitions="96,*,58" ColumnSpacing="6">
                                            <TextBlock Text="Actions" Style="{StaticResource FormLabelTextStyle}" />
                                            <ScrollViewer Grid.Column="1"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Disabled">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Button x:Uid="SaveLogHistoryButton"
                                                            Content="Export logs..."
                                                            Click="SaveLogHistory_Click"
                                                            IsEnabled="{Binding CanExportLogHistory}"
                                                            Style="{StaticResource FormActionButtonStyle}"
                                                            infra:AppToolTipService.ToolTip="Save all records still in memory, including filtered records. Logs removed by the retention limit, Clear, or view pause cannot be recovered." />
                                                    <Button x:Uid="StaticUi099"
                                                            Content="Open"
                                                            Command="{Binding OpenCurrentSerialLogCommand}"
                                                            Style="{StaticResource FormActionButtonStyle}"
                                                            infra:AppToolTipService.ToolTip="Open the active or most recently completed log file" />
                                                    <Button x:Uid="StaticUi100"
                                                            Content="Folder"
                                                            Command="{Binding OpenLogFolderCommand}"
                                                            Style="{StaticResource FormActionButtonStyle}"
                                                            infra:AppToolTipService.ToolTip="Open the configured Save dir folder (available while LOG is OFF or ON)" />
                                                    <Button x:Uid="StaticUi101"
                                                            Content="Copy path"
                                                            Command="{Binding CopySerialLogPathCommand}"
                                                            Style="{StaticResource FormActionButtonStyle}"
                                                            infra:AppToolTipService.ToolTip="Copy the active or most recently completed log file path" />
                                                </StackPanel>
                                            </ScrollViewer>
                                            <TextBlock x:Uid="StaticUi102"
                                                       Grid.Column="2"
                                                       Text="Now"
                                                       Style="{StaticResource FormApplyBadgeTextStyle}"
                                                       infra:AppToolTipService.ToolTip="Open/copy actions run immediately and do not stop logging." />
