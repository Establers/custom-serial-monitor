                          ViewChanged="HorizontalToolbarScrollViewer_ViewChanged"
                          SizeChanged="HorizontalToolbarScrollViewer_SizeChanged">
            <!-- Let the full status row contribute to the scroll extent. A fixed
                 viewport width clips the trailing RX BUSY metrics in small windows. -->
